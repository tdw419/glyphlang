import "./bootstrap/parser"

@ command run {
  # Workaround: use if/true to force return, or put return before other stmts
  # Try: assign the call result to a variable, then return that
  $ src = "! test_mut() -> int {\n  $ result = 0\n  ! modify() -> int {\n    $ result = result + 42\n  }\n  $ dummy = modify()\n  > result\n}\n$ result = test_mut()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  
  $ item = pr.mod.items[0]
  print("func body length=" + toString(length(item.func_body)))
  $ j = 0
  while j < length(item.func_body) {
    $ s = item.func_body[j]
    print("  " + toString(j) + ": kind=" + s.kind)
    $ j = j + 1
  }
  > { ok: true }
}
