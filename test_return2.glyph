import "./bootstrap/parser"

@ command run {
  # Try: assign before return (statement boundary)
  $ src = "! test() -> int {\n  $ x = 10\n  > x\n}\n$ result = test()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  $ item = pr.mod.items[0]
  print("body length=" + toString(length(item.func_body)))
  $ j = 0
  while j < length(item.func_body) {
    print("  " + toString(j) + ": kind=" + item.func_body[j].kind)
    $ j = j + 1
  }
  > { ok: true }
}
