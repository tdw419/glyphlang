import "./bootstrap/parser"

@ command run {
  $ src = "$ obj = { x: 1, y: 2 }\n$ obj.x = 99"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  $ i = 0
  while i < length(pr.mod.items) {
    $ item = pr.mod.items[i]
    print("item " + toString(i) + ": kind=" + item.kind)
    if item.kind == "assign" {
      print("  target=" + item.target)
    }
    if item.kind == "field_assign" {
      print("  field=" + item.field)
    }
    if item.kind == "var_decl" {
      print("  var_name=" + item.var_name)
    }
    $ i = i + 1
  }
  > { ok: true }
}
