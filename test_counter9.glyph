import "./bootstrap/parser"

@ command run {
  # Try with inner function on single line
  $ src = "! test_mut() -> int {\n  $ result = 0\n  ! modify() -> int { $ result = result + 42 }\n  modify()\n  > result\n}\n$ result = test_mut()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  
  $ item = pr.mod.items[0]
  print("func body length=" + toString(length(item.func_body)))
  $ j = 0
  while j < length(item.func_body) {
    $ s = item.func_body[j]
    print("  " + toString(j) + ": kind=" + s.kind)
    if s.kind == "function" {
      print("    inner func: " + s.func_name + " body=" + toString(length(s.func_body)))
      $ k = 0
      while k < length(s.func_body) {
        print("      " + toString(k) + ": kind=" + s.func_body[k].kind)
        $ k = k + 1
      }
    }
    $ j = j + 1
  }
  > { ok: true }
}
