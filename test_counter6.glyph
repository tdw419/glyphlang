import "./bootstrap/parser"

@ command run {
  $ src = "! test_mut() -> int {\n  $ result = 0\n  ! modify() -> int {\n    $ result = result + 42\n  }\n  modify()\n  > result\n}\n$ result = test_mut()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  
  $ item = pr.mod.items[0]
  $ s = item.func_body[2]
  print("stmt 2 kind=" + s.kind)
  $ ks = keys(s)
  $ i = 0
  while i < length(ks) {
    print("  " + ks[i] + " = " + toString(s[ks[i]]))
    $ i = i + 1
  }
  
  # Also check inner function
  $ inner = item.func_body[1]
  print("inner func body length=" + toString(length(inner.func_body)))
  if length(inner.func_body) > 0 {
    $ ss = inner.func_body[0]
    print("inner stmt 0 kind=" + ss.kind)
    $ ks2 = keys(ss)
    $ j = 0
    while j < length(ks2) {
      print("  " + ks2[j] + " = " + toString(ss[ks2[j]]))
      $ j = j + 1
    }
  }
  
  > { ok: true }
}
