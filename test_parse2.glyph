import "./bootstrap/parser"

@ command run {
  $ src = "$ obj.x = 99"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  $ i = 0
  while i < length(pr.mod.items) {
    $ item = pr.mod.items[i]
    print("item " + toString(i) + ": kind=" + item.kind)
    $ ks = keys(item)
    $ j = 0
    while j < length(ks) {
      print("  " + ks[j] + " = " + toString(item[ks[j]]))
      $ j = j + 1
    }
    $ i = i + 1
  }
  > { ok: true }
}
