import "./bootstrap/parser"

@ command run {
  # Try: put > on its own line with nothing after modify()
  # Or try: return without preceding expression
  $ src = "! test_mut() -> int {\n  $ result = 0\n  ! modify() -> int {\n    $ result = result + 42\n  }\n  modify()\n\n  > result\n}\n$ result = test_mut()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  
  $ item = pr.mod.items[0]
  print("func body length=" + toString(length(item.func_body)))
  $ j = 0
  while j < length(item.func_body) {
    $ s = item.func_body[j]
    print("  " + toString(j) + ": kind=" + s.kind)
    $ j = j + 1
  }
  > { ok: true }
}
