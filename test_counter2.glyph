import "./bootstrap/parser"

@ command run {
  # Simple mutable closure test
  $ src = "! make_counter() -> any {\n  $ count = 0\n  ! inc() -> int {\n    > count\n  }\n  > inc\n}\n$ c = make_counter()\n$ result = c()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  
  $ env = env_new()
  $ mr = exec_module(pr.mod, env)
  if mr.error != "" {
    print("EXEC ERROR: " + mr.error)
    > { error: mr.error }
  }
  
  $ rv = env_get(env, "result")
  print("result = " + toString(rv.value))
  > { ok: true }
}
