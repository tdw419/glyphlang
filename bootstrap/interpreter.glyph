# bootstrap/interpreter.glyph
# v0.24.0 Tree-walking interpreter for GlyphLang
# Evaluates AST nodes directly — no bytecode, no int-only limitation.
# This is the path to self-hosting: the Go `glyph exec` uses the same approach.

import "./parser"

# ─── Result Types ──────────────────────────────────────────────────

: EvalResult {
  value: any!
  error: str!
}

: ExecResult {
  value: any!
  error: str!
  signal: str!
}

: FuncDef {
  name: str!
  params: [any]!
  body: [any]!
  closure: any!
}

# ─── Environment ───────────────────────────────────────────────────

: Environment {
  bindings: any!
  parent: any!
}

! env_new() -> any {
  > { bindings: {}, parent: null }
}

! env_new_child(parent: any) -> any {
  > { bindings: {}, parent: parent }
}

! env_get(env: Environment, name: str) -> EvalResult {
  # Check if name exists in current bindings by iterating keys
  $ found = false
  $ val = null
  $ ks = keys(env.bindings)
  $ i = 0
  while i < length(ks) {
    if ks[i] == name {
      $ found = true
      $ val = env.bindings[ks[i]]
    }
    $ i = i + 1
  }
  if found {
    > { value: val, error: "" }
  }
  if env.parent != null {
    > env_get(env.parent, name)
  }
  > { value: null, error: "undefined variable: " + name }
}

! env_set(env: Environment, name: str, val: any) {
  $ keys = env.bindings
  $ keys[name] = val
  $ env.bindings = keys
}

# env_update walks up the scope chain to update an existing variable.
# Returns true if found and updated, false otherwise.
! env_update(env: Environment, name: str, val: any) -> bool {
  $ ks = keys(env.bindings)
  $ found = false
  $ i = 0
  while i < length(ks) {
    if ks[i] == name {
      $ found = true
    }
    $ i = i + 1
  }
  if found {
    $ b = env.bindings
    $ b[name] = val
    $ env.bindings = b
    > true
  }
  if env.parent != null {
    > env_update(env.parent, name, val)
  }
  > false
}

# ─── Truthiness ────────────────────────────────────────────────────

! is_truthy(val: any) -> bool {
  if val == null { > false }
  if val == 0 { > false }
  if val == "" { > false }
  if val == false { > false }
  if typeOf(val) == "object" {
    if val.kind == "bool" && val.value == false { > false }
  }
  > true
}

# ─── Type Coercion Helpers ─────────────────────────────────────────

! to_int(val: any) -> int {
  if typeOf(val) == "int" { > val }
  if val == true { > 1 }
  if val == false { > 0 }
  if typeOf(val) == "str" {
    $ result = 0
    $ neg = false
    $ i = 0
    if length(val) > 0 && charAt(val, 0) == "-" {
      $ neg = true
      $ i = 1
    }
    while i < length(val) {
      $ ch = charAt(val, i)
      $ d = -1
      if ch == "0" { $ d = 0 }
      if ch == "1" { $ d = 1 }
      if ch == "2" { $ d = 2 }
      if ch == "3" { $ d = 3 }
      if ch == "4" { $ d = 4 }
      if ch == "5" { $ d = 5 }
      if ch == "6" { $ d = 6 }
      if ch == "7" { $ d = 7 }
      if ch == "8" { $ d = 8 }
      if ch == "9" { $ d = 9 }
      if d < 0 { > 0 }
      $ result = result * 10 + d
      $ i = i + 1
    }
    if neg { > 0 - result }
    > result
  }
  > 0
}

! to_bool(val: any) -> bool {
  > is_truthy(val)
}

! to_string(val: any) -> str {
  if val == null { > "null" }
  if typeOf(val) == "int" { > toString(val) }
  if typeOf(val) == "str" { > val }
  if typeOf(val) == "bool" {
    if val { > "true" }
    > "false"
  }
  > toString(val)
}

# ─── Value Comparison ──────────────────────────────────────────────

! compare_values(a: any, b: any) -> int {
  if typeOf(a) == "int" && typeOf(b) == "int" {
    if a < b { > -1 }
    if a > b { > 1 }
    > 0
  }
  $ sa = to_string(a)
  $ sb = to_string(b)
  if sa < sb { > -1 }
  if sa > sb { > 1 }
  > 0
}

# ─── Builtins ──────────────────────────────────────────────────────

! call_builtin(name: str, args: [any]) -> EvalResult {
  if name == "print" {
    $ out = ""
    $ i = 0
    while i < length(args) {
      if i > 0 { out = out + " " }
      $ out = out + to_string(args[i])
      $ i = i + 1
    }
    print(out)
    > { value: null, error: "" }
  }

  if name == "toString" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: to_string(args[0]), error: "" }
  }

  if name == "length" {
    if length(args) == 0 { > { value: 0, error: "" } }
    > { value: length(args[0]), error: "" }
  }

  if name == "typeOf" {
    if length(args) == 0 { > { value: "null", error: "" } }
    $ v = args[0]
    if v == null { > { value: "null", error: "" } }
    > { value: typeOf(v), error: "" }
  }

  if name == "toInt" {
    if length(args) == 0 { > { value: 0, error: "" } }
    > { value: to_int(args[0]), error: "" }
  }

  if name == "readFile" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: readFile(args[0]), error: "" }
  }

  if name == "writeFile" {
    if length(args) >= 2 {
      writeFile(args[0], args[1])
    }
    > { value: null, error: "" }
  }

  if name == "args" {
    > { value: args(), error: "" }
  }

  if name == "exists" {
    if length(args) == 0 { > { value: false, error: "" } }
    > { value: exists(args[0]), error: "" }
  }

  if name == "keys" {
    if length(args) == 0 { > { value: [], error: "" } }
    > { value: keys(args[0]), error: "" }
  }

  if name == "push" {
    if length(args) < 2 { > { value: args[0], error: "" } }
    > { value: args[0] + [args[1]], error: "" }
  }

  if name == "pop" {
    if length(args) == 0 { > { value: null, error: "pop: empty array" } }
    $ arr = args[0]
    if length(arr) == 0 { > { value: null, error: "pop: empty array" } }
    $ last = arr[length(arr) - 1]
    $ out = []
    $ pi = 0
    while pi < length(arr) - 1 {
      out = out + [arr[pi]]
      pi = pi + 1
    }
    > { value: { elem: last, rest: out }, error: "" }
  }

  if name == "charAt" {
    if length(args) < 2 { > { value: "", error: "" } }
    $ s = toString(args[0])
    $ idx = toInt(args[1])
    if idx < 0 || idx >= length(s) { > { value: "", error: "charAt index out of range" } }
    > { value: substring(s, idx, idx + 1), error: "" }
  }

  if name == "substring" {
    if length(args) < 3 { > { value: "", error: "" } }
    > { value: substring(toString(args[0]), toInt(args[1]), toInt(args[2])), error: "" }
  }

  if name == "indexOf" {
    if length(args) < 2 { > { value: -1, error: "" } }
    > { value: indexOf(toString(args[0]), toString(args[1])), error: "" }
  }
  if name == "lastIndexOf" {
    if length(args) < 2 { > { value: -1, error: "" } }
    $ s = toString(args[0])
    $ sub = toString(args[1])
    $ i = length(s) - length(sub)
    while i >= 0 {
      if substring(s, i, i + length(sub)) == sub {
        > { value: i, error: "" }
      }
      $ i = i - 1
    }
    > { value: -1, error: "" }
  }


  if name == "split" {
    if length(args) < 2 { > { value: [], error: "" } }
    > { value: split(toString(args[0]), toString(args[1])), error: "" }
  }

  if name == "contains" {
    if length(args) < 2 { > { value: false, error: "" } }
    $ haystack = args[0]
    $ needle = args[1]
    if typeOf(haystack) == "str" {
      > { value: indexOf(toString(haystack), toString(needle)) >= 0, error: "" }
    }
    # array contains
    $ i = 0
    while i < length(haystack) {
      if haystack[i] == needle { > { value: true, error: "" } }
      $ i = i + 1
    }
    > { value: false, error: "" }
  }

  if name == "join" {
    if length(args) < 2 { > { value: "", error: "" } }
    $ arr = args[0]
    $ sep = toString(args[1])
    $ out = ""
    $ ji = 0
    while ji < length(arr) {
      if ji > 0 { out = out + sep }
      out = out + toString(arr[ji])
      ji = ji + 1
    }
    > { value: out, error: "" }
  }

  if name == "upper" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: upper(toString(args[0])), error: "" }
  }

  if name == "lower" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: lower(toString(args[0])), error: "" }
  }

  if name == "trim" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: trim(toString(args[0])), error: "" }
  }

  if name == "replace" {
    if length(args) < 3 { > { value: args[0], error: "" } }
    > { value: replace(toString(args[0]), toString(args[1]), toString(args[2])), error: "" }
  }

  if name == "startsWith" {
    if length(args) < 2 { > { value: false, error: "" } }
    $ s = toString(args[0])
    $ p = toString(args[1])
    if length(p) > length(s) { > { value: false, error: "" } }
    > { value: substring(s, 0, length(p)) == p, error: "" }
  }

  if name == "endsWith" {
    if length(args) < 2 { > { value: false, error: "" } }
    $ s = toString(args[0])
    $ p = toString(args[1])
    if length(p) > length(s) { > { value: false, error: "" } }
    > { value: substring(s, length(s) - length(p), length(s)) == p, error: "" }
  }

  if name == "abs" {
    if length(args) == 0 { > { value: 0, error: "" } }
    $ v = toInt(args[0])
    if v < 0 { > { value: 0 - v, error: "" } }
    > { value: v, error: "" }
  }

  if name == "min" {
    if length(args) < 2 { > { value: args[0], error: "" } }
    $ a = toInt(args[0])
    $ b = toInt(args[1])
    if a < b { > { value: a, error: "" } }
    > { value: b, error: "" }
  }

  if name == "max" {
    if length(args) < 2 { > { value: args[0], error: "" } }
    $ a = toInt(args[0])
    $ b = toInt(args[1])
    if a > b { > { value: a, error: "" } }
    > { value: b, error: "" }
  }


  if name == "repeat" {
    if length(args) < 2 { > { value: "", error: "" } }
    $ s = toString(args[0])
    $ n = toInt(args[1])
    $ out = ""
    $ ri = 0
    while ri < n {
      out = out + s
      ri = ri + 1
    }
    > { value: out, error: "" }
  }

  if name == "reverse" {
    if length(args) == 0 { > { value: "", error: "" } }
    $ val = args[0]
    if typeOf(val) == "str" {
      $ s = toString(val)
      $ out = ""
      $ ri = length(s) - 1
      while ri >= 0 {
        out = out + charAt(s, ri)
        ri = ri - 1
      }
      > { value: out, error: "" }
    }
    $ arr = val
    $ out = []
    $ ri = length(arr) - 1
    while ri >= 0 {
      out = out + [arr[ri]]
      ri = ri - 1
    }
    > { value: out, error: "" }
  }
  if name == "slice" {
    if length(args) < 3 { > { value: args[0], error: "" } }
    $ arr = args[0]
    $ start = toInt(args[1])
    $ end = toInt(args[2])
    if start < 0 { start = 0 }
    if end > length(arr) { end = length(arr) }
    $ out = []
    $ si = start
    while si < end {
      out = out + [arr[si]]
      si = si + 1
    }
    > { value: out, error: "" }
  }

  if name == "range" {
    $ rng_start = 0
    $ rng_end = 0
    if length(args) == 1 {
      rng_end = toInt(args[0])
    } else {
      if length(args) >= 2 {
        rng_start = toInt(args[0])
        rng_end = toInt(args[1])
      }
    }
    $ out = []
    $ ri = rng_start
    while ri < rng_end {
      out = out + [ri]
      ri = ri + 1
    }
    > { value: out, error: "" }
  }

  if name == "map" {
    if length(args) < 2 { > { value: [], error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "map: second arg must be a function" }
    }
    $ out = []
    $ mi = 0
    while mi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi == 0 { pval = arr[mi] }
        if pi == 1 { pval = mi }
        env_set(fn_env, pname, pval)
        pi = pi + 1
      }
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "map: " + sr.error } }
        if sr.signal == "return" {
          out = out + [sr.value]
          break
        }
        bi = bi + 1
      }
      mi = mi + 1
    }
    > { value: out, error: "" }
  }

  if name == "filter" {
    if length(args) < 2 { > { value: [], error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "filter: second arg must be a function" }
    }
    $ out = []
    $ fi = 0
    while fi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi == 0 { pval = arr[fi] }
        if pi == 1 { pval = fi }
        env_set(fn_env, pname, pval)
        pi = pi + 1
      }
      $ bi = 0
      $ included = false
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "filter: " + sr.error } }
        if sr.signal == "return" {
          if is_truthy(sr.value) {
            out = out + [arr[fi]]
          }
          break
        }
        bi = bi + 1
      }
      fi = fi + 1
    }
    > { value: out, error: "" }
  }

  if name == "reduce" {
    if length(args) < 3 { > { value: args[2], error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    $ acc = args[2]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "reduce: second arg must be a function" }
    }
    $ ri = 0
    while ri < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi == 0 { pval = acc }
        if pi == 1 { pval = arr[ri] }
        if pi == 2 { pval = ri }
        env_set(fn_env, pname, pval)
        pi = pi + 1
      }
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "reduce: " + sr.error } }
        if sr.signal == "return" {
          acc = sr.value
          break
        }
        bi = bi + 1
      }
      ri = ri + 1
    }
    > { value: acc, error: "" }
  }

  if name == "insert" {
    if length(args) < 3 { > { value: args[0], error: "" } }
    $ arr = args[0]
    $ idx = toInt(args[1])
    $ val = args[2]
    $ out = []
    $ ii = 0
    while ii < length(arr) {
      if ii == idx { $ out = out + [val] }
      $ out = out + [arr[ii]]
      $ ii = ii + 1
    }
    if idx >= length(arr) { $ out = out + [val] }
    > { value: out, error: "" }
  }

  if name == "remove_at" {
    if length(args) < 2 { > { value: args[0], error: "" } }
    $ arr = args[0]
    $ idx = toInt(args[1])
    $ out = []
    $ ii = 0
    while ii < length(arr) {
      if ii != idx { $ out = out + [arr[ii]] }
      $ ii = ii + 1
    }
    > { value: out, error: "" }
  }

  if name == "flatten" {
    if length(args) == 0 { > { value: [], error: "" } }
    $ arr = args[0]
    $ out = []
    $ fi = 0
    while fi < length(arr) {
      if typeOf(arr[fi]) == "array" {
        $ inner = arr[fi]
        $ ij = 0
        while ij < length(inner) {
          $ out = out + [inner[ij]]
          $ ij = ij + 1
        }
      } else {
        $ out = out + [arr[fi]]
      }
      $ fi = fi + 1
    }
    > { value: out, error: "" }
  }

  if name == "sort" {
    if length(args) == 0 { > { value: [], error: "" } }
    $ arr = args[0]
    # Simple bubble sort (bootstrap-friendly)
    $ n = length(arr)
    $ si = 0
    while si < n - 1 {
      $ sj = 0
      while sj < n - si - 1 {
        if compare_values(arr[sj], arr[sj + 1]) > 0 {
          $ tmp = arr[sj]
          $ arr[sj] = arr[sj + 1]
          $ arr[sj + 1] = tmp
        }
        $ sj = sj + 1
      }
      $ si = si + 1
    }
    > { value: arr, error: "" }
  }

  # format("Hello {0}, you are {1} years old", name, age)
  # Replaces {N} placeholders with toString(args[N+1])
  if name == "format" {
    if length(args) < 1 { > { value: "", error: "" } }
    $ tmpl = toString(args[0])
    $ result = ""
    $ i = 0
    $ len = length(tmpl)
    while i < len {
      $ ch = charAt(tmpl, i)
      if ch == "{" {
        # find closing }
        $ j = i + 1
        $ num_str = ""
        while j < len {
          $ c2 = charAt(tmpl, j)
          if c2 == "}" {
            # substitute
            $ idx = toInt(num_str)
            if idx + 1 < length(args) {
              result = result + toString(args[idx + 1])
            }
            $ i = j
            $ j = len
          } else {
            num_str = num_str + c2
          }
          $ j = j + 1
        }
      } else {
        result = result + ch
      }
      $ i = i + 1
    }
    > { value: result, error: "" }
  }

  # count(haystack, needle) — count occurrences of needle in string or array
  if name == "count" {
    if length(args) < 2 { > { value: 0, error: "" } }
    $ haystack = args[0]
    $ needle = args[1]
    if typeOf(haystack) == "str" {
      $ s = toString(haystack)
      $ sub = toString(needle)
      $ cnt = 0
      $ ci = 0
      while ci <= length(s) - length(sub) {
        if substring(s, ci, ci + length(sub)) == sub {
          $ cnt = cnt + 1
          $ ci = ci + length(sub)
        } else {
          $ ci = ci + 1
        }
      }
      > { value: cnt, error: "" }
    }
    if typeOf(haystack) == "array" {
      $ cnt = 0
      $ ci = 0
      while ci < length(haystack) {
        if haystack[ci] == needle {
          $ cnt = cnt + 1
        }
        $ ci = ci + 1
      }
      > { value: cnt, error: "" }
    }
    > { value: 0, error: "" }
  }

  # lastIndexOf(haystack, needle) — last occurrence position in string
  if name == "lastIndexOf" {
    if length(args) < 2 { > { value: -1, error: "" } }
    $ s = toString(args[0])
    $ sub = toString(args[1])
    $ last = -1
    $ li = 0
    while li <= length(s) - length(sub) {
      if substring(s, li, li + length(sub)) == sub {
        $ last = li
      }
      $ li = li + 1
    }
    > { value: last, error: "" }
  }

  # find(arr, predicate) — return first element where predicate(el) is truthy, or null
  if name == "find" {
    if length(args) < 2 { > { value: null, error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "find: second arg must be a function" }
    }
    $ fi = 0
    while fi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      env_set(fn_env, fn.params[0].name, arr[fi])
      $ bi = 0
      $ found = false
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "find predicate error: " + sr.error } }
        if sr.signal == "return" {
          if is_truthy(sr.value) {
            > { value: arr[fi], error: "" }
          }
          $ found = true
        }
        $ bi = bi + 1
      }
      $ fi = fi + 1
    }
    > { value: null, error: "" }
  }

  # findIndex(arr, predicate) — return index of first element where predicate(el) is truthy, or -1
  if name == "findIndex" {
    if length(args) < 2 { > { value: -1, error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: -1, error: "findIndex: second arg must be a function" }
    }
    $ fi = 0
    while fi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      env_set(fn_env, fn.params[0].name, arr[fi])
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: -1, error: "findIndex predicate error: " + sr.error } }
        if sr.signal == "return" {
          if is_truthy(sr.value) {
            > { value: fi, error: "" }
          }
        }
        $ bi = bi + 1
      }
      $ fi = fi + 1
    }
    > { value: -1, error: "" }
  }

  # every(arr, predicate) — return true if all elements pass predicate
  if name == "every" {
    if length(args) < 2 { > { value: true, error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "every: second arg must be a function" }
    }
    $ fi = 0
    while fi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      env_set(fn_env, fn.params[0].name, arr[fi])
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "every predicate error: " + sr.error } }
        if sr.signal == "return" {
          if !is_truthy(sr.value) {
            > { value: false, error: "" }
          }
        }
        $ bi = bi + 1
      }
      $ fi = fi + 1
    }
    > { value: true, error: "" }
  }

  # some(arr, predicate) — return true if any element passes predicate
  if name == "some" {
    if length(args) < 2 { > { value: false, error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "some: second arg must be a function" }
    }
    $ fi = 0
    while fi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      env_set(fn_env, fn.params[0].name, arr[fi])
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "some predicate error: " + sr.error } }
        if sr.signal == "return" {
          if is_truthy(sr.value) {
            > { value: true, error: "" }
          }
        }
        $ bi = bi + 1
      }
      $ fi = fi + 1
    }
    > { value: false, error: "" }
  }

  > { value: null, error: "not_builtin:" + name }
}

# ─── Expression Evaluation ────────────────────────────────────────

! eval_expr(expr: any, env: Environment) -> EvalResult {

  if expr.kind == "literal" {
    if expr.literal_type == "int" { > { value: toInt(expr.literal_value), error: "" } }
    if expr.literal_type == "str" { > { value: expr.literal_value, error: "" } }
    if expr.literal_type == "bool" {
      if expr.literal_value == "true" { > { value: true, error: "" } }
      > { value: false, error: "" }
    }
    if expr.literal_type == "null" { > { value: null, error: "" } }
    > { value: expr.literal_value, error: "" }
  }

  if expr.kind == "variable" {
    > env_get(env, expr.var_name)
  }

  if expr.kind == "binary" {
    $ lr = eval_expr(expr.left, env)
    if lr.error != "" { > lr }
    $ rr = eval_expr(expr.right, env)
    if rr.error != "" { > rr }
    $ l = lr.value
    $ r = rr.value
    $ op = expr.op

    if op == "+" {
      # Array + Array: concatenate
      if typeOf(l) == "array" && typeOf(r) == "array" {
        $ merged = l
        $ mi = 0
        while mi < length(r) {
          $ merged = merged + [r[mi]]
          $ mi = mi + 1
        }
        > { value: merged, error: "" }
      }
      if typeOf(l) == "str" || typeOf(r) == "str" {
        > { value: to_string(l) + to_string(r), error: "" }
      }
      > { value: to_int(l) + to_int(r), error: "" }
    }
    if op == "-" { > { value: to_int(l) - to_int(r), error: "" } }
    if op == "*" {
      # String * int: repeat string
      if typeOf(l) == "str" && typeOf(r) == "int" {
        $ out = ""
        $ ri = 0
        while ri < to_int(r) {
          $ out = out + toString(l)
          $ ri = ri + 1
        }
        > { value: out, error: "" }
      }
      # int * str: repeat string
      if typeOf(l) == "int" && typeOf(r) == "str" {
        $ out = ""
        $ ri = 0
        while ri < to_int(l) {
          $ out = out + toString(r)
          $ ri = ri + 1
        }
        > { value: out, error: "" }
      }
      > { value: to_int(l) * to_int(r), error: "" }
    }
    if op == "/" {
      if to_int(r) == 0 { > { value: null, error: "division by zero" } }
      > { value: to_int(l) / to_int(r), error: "" }
    }
    if op == "%" {
      if to_int(r) == 0 { > { value: null, error: "modulo by zero" } }
      > { value: to_int(l) % to_int(r), error: "" }
    }
    if op == "==" { > { value: l == r, error: "" } }
    if op == "!=" { > { value: l != r, error: "" } }
    if op == "<" { > { value: compare_values(l, r) < 0, error: "" } }
    if op == ">" { > { value: compare_values(l, r) > 0, error: "" } }
    if op == "<=" { > { value: compare_values(l, r) <= 0, error: "" } }
    if op == ">=" { > { value: compare_values(l, r) >= 0, error: "" } }
    if op == "&&" { > { value: is_truthy(l) && is_truthy(r), error: "" } }
    if op == "||" { > { value: is_truthy(l) || is_truthy(r), error: "" } }
    > { value: null, error: "unknown operator: " + op }
  }

  if expr.kind == "unary" {
    $ or = eval_expr(expr.operand, env)
    if or.error != "" { > or }
    if expr.op == "!" { > { value: !is_truthy(or.value), error: "" } }
    if expr.op == "-" { > { value: 0 - to_int(or.value), error: "" } }
    > { value: null, error: "unknown unary op: " + expr.op }
  }

  if expr.kind == "call" {
    $ arg_vals = []
    $ i = 0
    while i < length(expr.args) {
      $ ar = eval_expr(expr.args[i], env)
      if ar.error != "" { > ar }
      $ arg_vals = arg_vals + [ar.value]
      $ i = i + 1
    }

    $ br = call_builtin(expr.func_name, arg_vals)
    if br.error == "" { > br }
    if br.error != "not_builtin:" + expr.func_name { > br }

    $ fr = env_get(env, expr.func_name)
    if fr.error != "" {
      > { value: null, error: "undefined function: " + expr.func_name }
    }
    $ fn = fr.value
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: expr.func_name + " is not a function" }
    }

    $ fn_env = env_new_child(fn.closure)
    $ pi = 0
    while pi < length(fn.params) {
      $ pname = fn.params[pi].name
      $ pval = null
      if pi < length(arg_vals) { pval = arg_vals[pi] }
      env_set(fn_env, pname, pval)
      $ pi = pi + 1
    }

    $ bi = 0
    while bi < length(fn.body) {
      $ sr = exec_stmt(fn.body[bi], fn_env)
      if sr.error != "" { > { value: null, error: sr.error } }
      if sr.signal == "return" { > { value: sr.value, error: "" } }
      $ bi = bi + 1
    }
    > { value: null, error: "" }
  }

  # Method call: obj.method(args) — evaluates callee, then calls the result
  if expr.kind == "method_call" {
    $ callee_r = eval_expr(expr.object, env)
    if callee_r.error != "" { > callee_r }
    $ fn = callee_r.value

    $ arg_vals = []
    $ i = 0
    while i < length(expr.args) {
      $ ar = eval_expr(expr.args[i], env)
      if ar.error != "" { > ar }
      $ arg_vals = arg_vals + [ar.value]
      $ i = i + 1
    }

    # Check if callee result is a builtin name
    if typeOf(fn) == "str" {
      $ br = call_builtin(fn, arg_vals)
      if br.error == "" { > br }
    }

    # Check if callee is a func_def (from object field or index)
    if typeOf(fn) == "object" && fn.kind == "func_def" {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi < length(arg_vals) { pval = arg_vals[pi] }
        env_set(fn_env, pname, pval)
        $ pi = pi + 1
      }
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: sr.error } }
        if sr.signal == "return" { > { value: sr.value, error: "" } }
        $ bi = bi + 1
      }
      > { value: null, error: "" }
    }

    > { value: null, error: "method call on non-function: " + typeOf(fn) }
  }

  if expr.kind == "field" {
    $ or = eval_expr(expr.object, env)
    if or.error != "" { > or }
    $ obj = or.value
    if typeOf(obj) != "object" {
      > { value: null, error: "field access on non-object" }
    }
    > { value: obj[expr.field_name], error: "" }
  }

  if expr.kind == "object" {
    $ obj = {}
    $ i = 0
    while i < length(expr.fields) {
      $ f = expr.fields[i]
      $ vr = eval_expr(f.value, env)
      if vr.error != "" { > vr }
      $ obj[f.key] = vr.value
      $ i = i + 1
    }
    > { value: obj, error: "" }
  }

  if expr.kind == "array" {
    $ arr = []
    $ i = 0
    while i < length(expr.elements) {
      $ er = eval_expr(expr.elements[i], env)
      if er.error != "" { > er }
      $ arr = arr + [er.value]
      $ i = i + 1
    }
    > { value: arr, error: "" }
  }

  if expr.kind == "index" {
    $ cr = eval_expr(expr.array_expr, env)
    if cr.error != "" { > cr }
    $ ir = eval_expr(expr.index_expr, env)
    if ir.error != "" { > ir }
    # String key → object field access: obj["field"]
    if typeOf(ir.value) == "str" {
      > { value: cr.value[ir.value], error: "" }
    }
    # Integer key → string character access: "hello"[0] → "h"
    if typeOf(cr.value) == "str" {
      $ ci = to_int(ir.value)
      # Negative index: count from end
      if ci < 0 { $ ci = length(cr.value) + ci }
      if ci >= 0 && ci < length(cr.value) {
        > { value: charAt(cr.value, ci), error: "" }
      }
      > { value: null, error: "string index out of bounds: " + toString(ci) }
    }
    # Integer key → array index access: arr[i]
    $ ci = to_int(ir.value)
    # Negative index: count from end
    if ci < 0 { $ ci = length(cr.value) + ci }
    if ci >= 0 && ci < length(cr.value) {
      > { value: cr.value[ci], error: "" }
    }
    > { value: null, error: "index out of bounds: " + toString(ci) }
  }

  > { value: null, error: "unsupported expression: " + expr.kind }
}

# ─── Statement Execution ──────────────────────────────────────────

! exec_stmt(stmt: any, env: Environment) -> ExecResult {
  $ null_result = { value: null, error: "", signal: "" }

  if stmt.kind == "assign" || stmt.kind == "reassign" {
    $ vr = eval_expr(stmt.value, env)
    if vr.error != "" { > { value: null, error: vr.error, signal: "" } }
    # Try to update in enclosing scope first (mutable closures)
    $ updated = env_update(env, stmt.target, vr.value)
    if !updated {
      env_set(env, stmt.target, vr.value)
    }
    > null_result
  }

  if stmt.kind == "return" {
    $ vr = eval_expr(stmt.return_value, env)
    if vr.error != "" { > { value: null, error: vr.error, signal: "return" } }
    > { value: vr.value, error: "", signal: "return" }
  }

  if stmt.kind == "if" {
    $ cr = eval_expr(stmt.condition, env)
    if cr.error != "" { > { value: null, error: cr.error, signal: "" } }
    if is_truthy(cr.value) {
      $ i = 0
      while i < length(stmt.then_block) {
        $ sr = exec_stmt(stmt.then_block[i], env)
        if sr.error != "" || sr.signal != "" { > sr }
        $ i = i + 1
      }
    } else {
      $ i = 0
      while i < length(stmt.else_block) {
        $ sr = exec_stmt(stmt.else_block[i], env)
        if sr.error != "" || sr.signal != "" { > sr }
        $ i = i + 1
      }
    }
    > null_result
  }

  if stmt.kind == "while" {
    while true {
      $ cr = eval_expr(stmt.while_condition, env)
      if cr.error != "" { > { value: null, error: cr.error, signal: "" } }
      if !is_truthy(cr.value) { > null_result }
      $ i = 0
      while i < length(stmt.body) {
        $ sr = exec_stmt(stmt.body[i], env)
        if sr.error != "" { > sr }
        if sr.signal == "break" { > null_result }
        if sr.signal == "return" { > sr }
        $ i = i + 1
      }
    }
    > null_result
  }

  if stmt.kind == "for_in" {
    $ ir = eval_expr(stmt.while_condition, env)
    if ir.error != "" { > { value: null, error: ir.error, signal: "" } }
    $ iterable = ir.value
    $ idx = 0
    while idx < length(iterable) {
      if stmt.field != "" {
        env_set(env, stmt.field, idx)
      }
      env_set(env, stmt.target, iterable[idx])
      $ i = 0
      while i < length(stmt.body) {
        $ sr = exec_stmt(stmt.body[i], env)
        if sr.error != "" { > sr }
        if sr.signal == "break" { > null_result }
        if sr.signal == "return" { > sr }
        if sr.signal == "continue" { break }
        $ i = i + 1
      }
      $ idx = idx + 1
    }
    > null_result
  }

  if stmt.kind == "expression" {
    $ er = eval_expr(stmt.expr, env)
    if er.error != "" { > { value: null, error: er.error, signal: "" } }
    > null_result
  }

  if stmt.kind == "field_assign" {
    $ or = eval_expr(stmt.obj_expr, env)
    if or.error != "" {
      > { value: null, error: or.error, signal: "" }
    }
    $ vr = eval_expr(stmt.value, env)
    if vr.error != "" {
      > { value: null, error: vr.error, signal: "" }
    }
    $ or.value[stmt.field] = vr.value
    > null_result
  }

  if stmt.kind == "index_assign" {
    # obj_expr may be nil for top-level array index assign; fall back to target variable
    $ obj_val = null
    if stmt.obj_expr != null {
      $ cr = eval_expr(stmt.obj_expr, env)
      if cr.error != "" { > { value: null, error: cr.error, signal: "" } }
      $ obj_val = cr.value
    } else {
      $ tr = env_get(env, stmt.target)
      if tr.error != "" { > { value: null, error: tr.error, signal: "" } }
      $ obj_val = tr.value
    }
    $ ir = eval_expr(stmt.index_expr, env)
    if ir.error != "" { > { value: null, error: ir.error, signal: "" } }
    $ vr = eval_expr(stmt.value, env)
    if vr.error != "" { > { value: null, error: vr.error, signal: "" } }
    if typeOf(ir.value) == "str" {
      $ obj_val[ir.value] = vr.value
    } else {
      $ obj_val[to_int(ir.value)] = vr.value
    }
    > null_result
  }

  if stmt.kind == "function" {
    $ fn = {
      kind: "func_def",
      name: stmt.func_name,
      params: stmt.func_params,
      body: stmt.func_body,
      closure: env
    }
    env_set(env, stmt.func_name, fn)
    > null_result
  }

  if stmt.kind == "break" { > { value: null, error: "", signal: "break" } }
  if stmt.kind == "continue" { > { value: null, error: "", signal: "continue" } }

  > { value: null, error: "unsupported stmt: " + stmt.kind, signal: "" }
}

# ─── Path Helpers ──────────────────────────────────────────────────

# has_key checks if an object contains a given key string.
! has_key(obj: any, key: str) -> bool {
  $ ks = keys(obj)
  $ i = 0
  while i < length(ks) {
    if ks[i] == key { > true }
    $ i = i + 1
  }
  > false
}

# resolve_import_path computes the full file path and new base directory
# for an import relative to the current base_path.
! resolve_import_path(raw_path: str, base_path: str) -> any {
  # Strip leading "./" from raw_path
  $ clean = raw_path
  if startsWith(raw_path, "./") {
    $ clean = substring(raw_path, 2, length(raw_path))
  }
  $ resolved = base_path + clean + ".glyph"
  # new_base = directory portion of resolved file
  $ new_base = base_path
  $ last_slash = 0
  $ j = length(resolved) - 1
  while j >= 0 {
    if substring(resolved, j, j + 1) == "/" {
      $ last_slash = j + 1
      $ j = -1
    }
    $ j = j - 1
  }
  if last_slash > 0 {
    $ new_base = substring(resolved, 0, last_slash)
  }
  > { file_path: resolved, new_base: new_base }
}

# ─── Module Loading ────────────────────────────────────────────────

! exec_module(mod: any, env: Environment, base_path: str, visited: any) -> EvalResult {
  $ last_val = null
  if visited == null {
    $ visited = {}
  }
  $ items = mod.items
  $ i = 0
  while i < length(items) {
    $ item = items[i]

    if item.kind == "import" {
      $ rp = resolve_import_path(item.import_path, base_path)
      $ resolved_path = rp.file_path
      $ new_base = rp.new_base
      if has_key(visited, resolved_path) {
        > { value: null, error: "circular import detected: " + resolved_path }
      }
      $ visited[resolved_path] = true
      $ src = readFile(resolved_path)
      if length(src) == 0 {
        > { value: null, error: "import not found: " + resolved_path }
      }
      $ ip = parser.new_parser(src)
      $ ipr = parser.parse(ip)
      if ipr.error != "" {
        > { value: null, error: "import parse error (" + resolved_path + "): " + ipr.error }
      }
      $ imr = exec_module(ipr.mod, env, new_base, visited)
      if imr.error != "" { > imr }
    }

    if item.kind == "from_import" {
      $ rp = resolve_import_path(item.from_path, base_path)
      $ resolved_path = rp.file_path
      $ new_base = rp.new_base
      if has_key(visited, resolved_path) {
        > { value: null, error: "circular import detected: " + resolved_path }
      }
      $ visited[resolved_path] = true
      $ src = readFile(resolved_path)
      if length(src) == 0 {
        > { value: null, error: "import not found: " + resolved_path }
      }
      $ ip = parser.new_parser(src)
      $ ipr = parser.parse(ip)
      if ipr.error != "" {
        > { value: null, error: "import parse error (" + resolved_path + "): " + ipr.error }
      }
      $ imr = exec_module(ipr.mod, env, new_base, visited)
      if imr.error != "" { > imr }
    }

    if item.kind == "const" {
      $ vr = eval_expr(item.const_value, env)
      if vr.error != "" { > vr }
      env_set(env, item.const_name, vr.value)
      $ last_val = vr.value
    }

    if item.kind == "var_decl" {
      $ vr = eval_expr(item.var_value, env)
      if vr.error != "" { > vr }
      env_set(env, item.var_name, vr.value)
      $ last_val = vr.value
    }

    if item.kind == "type_def" {
    }

    if item.kind == "function" {
      env_set(env, item.func_name, null)
      $ fn = {
        kind: "func_def",
        name: item.func_name,
        params: item.func_params,
        body: item.func_body,
        closure: env
      }
      env_set(env, item.func_name, fn)
    }

    if item.kind == "command" {
      $ fn = {
        kind: "func_def",
        name: item.command_name,
        params: item.command_params,
        body: item.command_body,
        closure: env
      }
      env_set(env, "@cmd_" + item.command_name, fn)
    }

    if item.kind == "for_in" || item.kind == "if" || item.kind == "while" || item.kind == "assign" || item.kind == "expression" || item.kind == "return" || item.kind == "field_assign" || item.kind == "index_assign" {
      $ sr = exec_stmt(item, env)
      if sr.error != "" { > { value: null, error: sr.error } }
      if sr.value != null {
        $ last_val = sr.value
      }
    }

    $ i = i + 1
  }
  > { value: last_val, error: "" }
}

# ─── Dynamic Eval (Self-Hosting Seed) ────────────────────────────

! eval_source(src: str, env: any, base_path: any) -> EvalResult {
  if env == null {
    $ env = env_new()
    # Propagate eval_source into child env for meta-circular support.
    # This allows programs executed by eval_source to call eval_source
    # themselves, enabling the interpreter to interpret itself.
    $ self_ref = eval_source
    env_set(env, "eval_source", self_ref)
  }
  if base_path == null { $ base_path = "./" }
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    > { value: null, error: "parse error: " + pr.error }
  }
  $ mr = exec_module(pr.mod, env, base_path, null)
  if mr.error != "" {
    > { value: null, error: "exec error: " + mr.error }
  }
  $ fr = env_get(env, "result")
  if fr.error == "" { > { value: fr.value, error: "" } }
  > { value: null, error: "" }
}

# ─── Entry Point ───────────────────────────────────────────────────

! run_test(name: str, src: str, expected: any) -> bool {
  print("")
  print("TEST: " + name)
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("  PARSE ERROR: " + pr.error)
    > false
  }

  $ env = env_new()
  $ mr = exec_module(pr.mod, env, "bootstrap/", null)
  if mr.error != "" {
    print("  EXEC ERROR: " + mr.error)
    > false
  }

  # Check "result" binding if expected != null
  if expected != null {
    $ rr = env_get(env, "result")
    if rr.error != "" {
      print("  ERROR: no 'result' binding: " + rr.error)
      > false
    }
    if rr.value != expected {
      print("  FAIL: got " + toString(rr.value) + " expected " + toString(expected))
      > false
    }
    print("  PASS: result = " + toString(rr.value))
    > true
  }
  print("  PASS (no result check)")
  > true
}

@ command run {
  print("========================================")
  print("  GlyphLang Bootstrap Interpreter v0.24")
  print("========================================")

  $ passed = 0
  $ failed = 0

  # ── Test 1: const + arithmetic ──
  $ t1_src = "const X = 42\nconst Y = X + 3\n$ result = Y"
  if run_test("const + arithmetic", t1_src, 45) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 2: function definition and call ──
  $ t2_src = "! double(x: int) -> int { > x * 2 }\n$ result = double(21)"
  if run_test("function call", t2_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 3: while loop (sum 1..5) ──
