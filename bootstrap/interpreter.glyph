  if run_test("range(3) = [0, 1, 2]", t10_src, [0, 1, 2]) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  print("TEST: self-hosting expression evaluator with parens + subtract ((3+4)*2-1=13)")
  if sh169_r.error != "" {
    print("  FAIL: " + sh169_r.error)
    $ failed = failed + 1
  } else {
    $ rv169 = env_get(sh169_env, "result")
    if rv169.value != 13 {
      print("  FAIL: got " + toString(rv169.value) + " expected 13")
      $ failed = failed + 1
    } else {
      print("  PASS: result = " + toString(rv169.value))
      $ passed = passed + 1
    }
  }

  # ── Test 171: chained function call — call returned function directly ──
  $ t171_src = "! make_adder(n: int) -> any {\n  ! add(x: int) -> int { > x + n }\n  > add\n}\n$ result = make_adder(10)(32)"
  if run_test("chained function call — make_adder(10)(32) = 42", t171_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 172: triple chained call ──
  $ t172_src = "! wrap(x: int) -> any {\n  > { val: x }\n}\n! get_val(o: any) -> int {\n  > o.val\n}\n$ result = get_val(wrap(99))"
  if run_test("chained call through function returning object (99)", t172_src, 99) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 173: else if chain ──
  $ t173_src = "$ x = 2\n$ result = 0\nif x == 1 {\n  $ result = 10\n} else if x == 2 {\n  $ result = 20\n} else {\n  $ result = 30\n}"
  if run_test("else if chain — x==2 hits middle branch (20)", t173_src, 20) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 174: else if chain — first branch ──
  $ t174_src = "$ x = 1\n$ result = 0\nif x == 1 {\n  $ result = 10\n} else if x == 2 {\n  $ result = 20\n} else {\n  $ result = 30\n}"
  if run_test("else if chain — x==1 hits first branch (10)", t174_src, 10) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 175: else if chain — else fallback ──
  $ t175_src = "$ x = 99\n$ result = 0\nif x == 1 {\n  $ result = 10\n} else if x == 2 {\n  $ result = 20\n} else {\n  $ result = 30\n}"
  if run_test("else if chain — x==99 hits else branch (30)", t175_src, 30) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 176: null comparison with == ──
  $ t176_src = "$ x = null\n$ result = 0\nif x == null {\n  $ result = 1\n}"
  if run_test("null == null comparison (1)", t176_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 177: chained call returning closure that mutates state ──
  $ t177_src = "! counter(start: int) -> any {\n  $ count = start\n  ! inc(n: int) -> int {\n    $ count = count + n\n    > count\n  }\n  > inc\n}\n$ f = counter(100)\n$ a = f(5)\n$ b = f(10)\n$ result = f(0)"
  if run_test("chained call — closure state mutation (100+5+10+0=115)", t177_src, 115) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 178: fibonacci via closure — iterate with assignments ──
  $ t178_src = "! fib_pair() -> any {\n  $ a = 0\n  $ b = 1\n  ! next() -> int {\n    $ tmp = a + b\n    $ a = b\n    $ b = tmp\n    > a\n  }\n  > next\n}\n$ f = fib_pair()\n$ r1 = f()\n$ r2 = f()\n$ r3 = f()\n$ r4 = f()\n$ r5 = f()\n$ result = f()"
  if run_test("fibonacci closure — 6th call (8)", t178_src, 8) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 179: GCD via recursive function ──
  $ t179_src = "! gcd(a: int, b: int) -> int {\n  if b == 0 { > a }\n  > gcd(b, a % b)\n}\n$ result = gcd(48, 18)"
  if run_test("GCD recursive — gcd(48,18)=6", t179_src, 6) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 180: triple-nested closure ──
  $ t180_src = "! outer(x: int) -> any {\n  ! middle(y: int) -> any {\n    ! inner(z: int) -> int {\n      > x + y + z\n    }\n    > inner\n  }\n  > middle\n}\n$ result = outer(10)(20)(12)"
  if run_test("triple-nested closure — 10+20+12=42", t180_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 181: string comparison < ──
  $ t181_src = "$ result = 0\nif \"apple\" < \"banana\" {\n  $ result = 1\n}"
  if run_test("string comparison — apple < banana (1)", t181_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 182: string comparison > ──
  $ t182_src = "$ result = 0\nif \"zebra\" > \"apple\" {\n  $ result = 1\n}"
  if run_test("string comparison — zebra > apple (1)", t182_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 183: string equality ──
  $ t183_src = "$ result = 0\nif \"hello\" == \"hello\" {\n  $ result = 1\n}"
  if run_test("string equality — hello == hello (1)", t183_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 184: string inequality ──
  $ t184_src = "$ result = 0\nif \"hello\" != \"world\" {\n  $ result = 1\n}"
  if run_test("string inequality — hello != world (1)", t184_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 185: boolean AND with comparisons ──
  $ t185_src = "$ x = 5\n$ result = 0\nif x > 0 && x < 10 {\n  $ result = 1\n}"
  if run_test("boolean AND with chained comparison (1)", t185_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 186: boolean OR ──
  $ t186_src = "$ x = 15\n$ result = 0\nif x < 0 || x > 10 {\n  $ result = 1\n}"
  if run_test("boolean OR — 15>10 (1)", t186_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 187: GCD of large numbers ──
  $ t187_src = "! gcd(a: int, b: int) -> int {\n  if b == 0 { > a }\n  > gcd(b, a % b)\n}\n$ result = gcd(270, 192)"
  if run_test("GCD recursive — gcd(270,192)=6", t187_src, 6) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 188: typeOf builtin ──
  $ t188_src = "$ result = 0\nif typeOf(42) == \"int\" {\n  if typeOf(\"hello\") == \"str\" {\n    if typeOf(true) == \"bool\" {\n      $ result = 1\n    }\n  }\n}"
  if run_test("typeOf builtin — int/str/bool (1)", t188_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 189: negative array index arr[-1] = last element ──
  $ t189_src = "$ arr = [10, 20, 30, 40, 50]\n$ result = arr[-1]"
  if run_test("negative array index arr[-1] (50)", t189_src, 50) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 190: negative array index arr[-2] = second to last ──
  $ t190_src = "$ arr = [10, 20, 30, 40, 50]\n$ result = arr[-2]"
  if run_test("negative array index arr[-2] (40)", t190_src, 40) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 191: negative string index s[-1] = last char ──
  $ t191_src = "$ s = \"hello\"\n$ result = s[-1]"
  if run_test("negative string index s[-1] (o)", t191_src, "o") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 192: negative string index s[-2] ──
  $ t192_src = "$ s = \"glyph\"\n$ result = s[-2]"
  if run_test("negative string index s[-2] (p)", t192_src, "p") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 193: insert builtin — insert value at index ──
  $ t193_src = "$ arr = [10, 30, 40]\n$ arr = insert(arr, 1, 20)\n$ result = arr[0] + arr[1] + arr[2] + arr[3]"
  if run_test("insert builtin — insert 20 at index 1 (100)", t193_src, 100) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 194: remove_at builtin — remove element at index ──
  $ t194_src = "$ arr = [10, 20, 99, 30, 40]\n$ arr = remove_at(arr, 2)\n$ result = arr[0] + arr[1] + arr[2] + arr[3]"
  if run_test("remove_at builtin — remove index 2 (100)", t194_src, 100) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 195: flatten builtin — flatten nested arrays ──
  $ t195_src = "$ arr = [[1, 2], [3, 4], [5]]\n$ flat = flatten(arr)\n$ result = flat[0] + flat[1] + flat[2] + flat[3] + flat[4]"
  if run_test("flatten builtin — [[1,2],[3,4],[5]] (15)", t195_src, 15) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 196: sort builtin — sort array of ints ──
  $ t196_src = "$ arr = [5, 3, 8, 1, 9, 2]\n$ sorted = sort(arr)\n$ result = sorted[0] + sorted[1] + sorted[2]"
  if run_test("sort builtin — first 3 of sorted [5,3,8,1,9,2] (1+2+3=6)", t196_src, 6) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 197: sort builtin — verify full sorted order ──
  $ t197_src = "$ arr = [5, 3, 8, 1, 9, 2]\n$ sorted = sort(arr)\n$ result = sorted[0] * 100000 + sorted[1] * 10000 + sorted[2] * 1000 + sorted[3] * 100 + sorted[4] * 10 + sorted[5]"
  if run_test("sort builtin — full order 123589 (123589)", t197_src, 123589) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 198: insert at end of array ──
  $ t198_src = "$ arr = [1, 2, 3]\n$ arr = insert(arr, 3, 4)\n$ result = length(arr) + arr[3]"
  if run_test("insert at end — length=4, arr[3]=4 (8)", t198_src, 8) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 199: flatten with non-array elements ──
  $ t199_src = "$ arr = [[1, 2], 3, [4, 5]]\n$ flat = flatten(arr)\n$ result = flat[0] + flat[1] + flat[2] + flat[3] + flat[4]"
  if run_test("flatten mixed — [[1,2],3,[4,5]] (15)", t199_src, 15) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 200: negative index in loop — sum from end ──
  $ t200_src = "$ arr = [10, 20, 30]\n$ result = arr[-1] + arr[-2] + arr[-3]"
  if run_test("negative index sum all from end (60)", t200_src, 60) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Tests 201-205: format builtin ──

  $ t201_src = "$ s = format(\"Hello {0}!\", \"world\")\n$ result = s"
  if run_test("format builtin — basic substitution (Hello world!)", t201_src, "Hello world!") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t202_src = "$ s = format(\"{0} + {1} = {2}\", 10, 32, 42)\n$ result = s"
  if run_test("format builtin — multi-placeholder (10 + 32 = 42)", t202_src, "10 + 32 = 42") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t203_src = "$ name = \"Glyph\"\n$ s = format(\"Language: {0}, Version: {1}\", name, 22)\n$ result = s"
  if run_test("format builtin — mixed types (Language: Glyph, Version: 22)", t203_src, "Language: Glyph, Version: 22") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t204_src = "$ s = format(\"repeated {0} {1} {0}\", \"hello\", \"and\")\n$ result = s"
  if run_test("format builtin — repeated placeholders (repeated hello and hello)", t204_src, "repeated hello and hello") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t205_src = "$ s = format(\"no placeholders here\")\n$ result = s"
  if run_test("format builtin — no placeholders (no placeholders here)", t205_src, "no placeholders here") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Tests 206-210: count + lastIndexOf builtins ──

  $ t206_src = "$ c = count(\"hello hello hello\", \"hello\")\n$ result = c"
  if run_test("count builtin — string 3 occurrences (3)", t206_src, 3) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t207_src = "$ c = count([1, 2, 3, 2, 2, 4], 2)\n$ result = c"
  if run_test("count builtin — array count 2s (3)", t207_src, 3) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t208_src = "$ c = count(\"abcdef\", \"xyz\")\n$ result = c"
  if run_test("count builtin — string no match (0)", t208_src, 0) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t209_src = "$ p = lastIndexOf(\"hello world hello\", \"hello\")\n$ result = p"
  if run_test("lastIndexOf builtin — second occurrence at 12 (12)", t209_src, 12) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t210_src = "$ p = lastIndexOf(\"abcdef\", \"xyz\")\n$ result = p"
  if run_test("lastIndexOf builtin — not found (-1)", t210_src, -1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Tests 211-218: find, findIndex, every, some builtins ──

  $ t211_src = "! is_big(x: int) -> bool { > x > 10 }\n$ elem = find([3, 7, 15, 2, 20], is_big)\n$ result = elem"
  if run_test("find builtin — first element > 10 (15)", t211_src, 15) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t212_src = "! is_neg(x: int) -> bool { > x < 0 }\n$ elem = find([1, 2, 3], is_neg)\n$ r = 0\nif elem == null { $ r = 1 }\n$ result = r"
  if run_test("find builtin — no match returns null (1)", t212_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t213_src = "! is_even(x: int) -> bool { > x % 2 == 0 }\n$ idx = findIndex([1, 3, 5, 8, 9], is_even)\n$ result = idx"
  if run_test("findIndex builtin — first even at index 3 (3)", t213_src, 3) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t214_src = "! is_big(x: int) -> bool { > x > 100 }\n$ idx = findIndex([1, 2, 3], is_big)\n$ result = idx"
  if run_test("findIndex builtin — no match returns -1 (-1)", t214_src, -1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t215_src = "! is_pos(x: int) -> bool { > x > 0 }\n$ all_pos = every([1, 5, 10, 3], is_pos)\n$ r = 0\nif all_pos { $ r = 1 }\n$ result = r"
  if run_test("every builtin — all positive (1)", t215_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t216_src = "! is_pos(x: int) -> bool { > x > 0 }\n$ all_pos = every([1, -5, 10], is_pos)\n$ r = 1\nif !all_pos { $ r = 0 }\n$ result = r"
  if run_test("every builtin — has negative (0)", t216_src, 0) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t217_src = "! is_neg(x: int) -> bool { > x < 0 }\n$ has_neg = some([1, 5, -3, 10], is_neg)\n$ r = 0\nif has_neg { $ r = 1 }\n$ result = r"
  if run_test("some builtin — has negative (1)", t217_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t218_src = "! is_neg(x: int) -> bool { > x < 0 }\n$ has_neg = some([1, 5, 10], is_neg)\n$ r = 1\nif !has_neg { $ r = 0 }\n$ result = r"
  if run_test("some builtin — all positive (0)", t218_src, 0) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 219: toInt string conversion ──
  $ t219_src = "$ result = toInt(\"42\")"
  if run_test("toInt string conversion (\"42\" → 42)", t219_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 220: toInt negative string ──
  $ t220_src = "$ x = toInt(\"-7\")\n$ result = 0 - x"
  if run_test("toInt negative string (\"-7\" → 7, negated)", t220_src, 7) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 221: toInt multi-digit string ──
  $ t221_src = "$ result = toInt(\"123\") + toInt(\"456\")"
  if run_test("toInt multi-digit (123+456=579)", t221_src, 579) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 222: toInt in arithmetic ──
  $ t222_src = "$ result = toInt(\"10\") * toInt(\"4\") + toInt(\"2\")"
  if run_test("toInt in arithmetic (10*4+2=42)", t222_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 223: toInt edge cases ──
  $ t223_src = "$ result = toInt(\"0\") + toInt(99)"
  if run_test("toInt edge cases (\"0\"→0 + 99=99)", t223_src, 99) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Tests 224-226: Module import system ──

  # Test 224: import module and call exported function
  $ t224_src = "import \"./test_module\"\n$ result = add(10, 32)"
  if run_test("import module — call add(10,32)=42", t224_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # Test 225: import module and call multiple exported functions
  $ t225_src = "import \"./test_module\"\n$ r1 = multiply(6, 7)\n$ r2 = greet(\"world\")\n$ result = r1"
  if run_test("import module — call multiply(6,7)=42", t225_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # Test 226: circular import detection
  print("")
  print("TEST: circular import detection")
  $ circ_env = env_new()
  $ circ_src = "import \"./test_circular_a\"\n$ result = 0"
  $ circ_p = parser.new_parser(circ_src)
  $ circ_pr = parser.parse(circ_p)
  $ circ_ok = false
  if circ_pr.error != "" {
    print("  FAIL: parse error: " + circ_pr.error)
    $ failed = failed + 1
  } else {
    $ circ_mr = exec_module(circ_pr.mod, circ_env, "bootstrap/", null)
    if circ_mr.error != "" {
      if contains(circ_mr.error, "circular") {
        print("  PASS: circular import detected — " + circ_mr.error)
        $ passed = passed + 1
        $ circ_ok = true
      } else {
        print("  FAIL: unexpected error: " + circ_mr.error)
        $ failed = failed + 1
      }
    } else {
      print("  FAIL: expected circular import error but got none")
      $ failed = failed + 1
    }
  }

  # ── Summary ──
  print("")
  print("========================================")
  print("  PASSED: " + toString(passed) + "  FAILED: " + toString(failed))
  print("========================================")

  if failed == 0 {
    print("ALL TESTS PASSED")
    > { ok: true, passed: passed, failed: failed }
  }
  print("SOME TESTS FAILED")
  > { ok: false, passed: passed, failed: failed }
}

# ─── @ command test: Run a quick assertion subset ────────────────

@ command test {
  print("========================================")
  print("  GlyphLang Bootstrap — Quick Test")
  print("========================================")

  $ passed = 0
  $ failed = 0

  $ t1_src = "const X = 42\nconst Y = X + 3\n$ result = Y"
  if run_test("const + arithmetic", t1_src, 45) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t2_src = "! double(x: int) -> int { > x * 2 }\n$ result = double(21)"
  if run_test("function call", t2_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t3_src = "! sum_to(n: int) -> int {\n  $ total = 0\n  $ i = 1\n  while i <= n {\n    $ total = total + i\n    $ i = i + 1\n  }\n  > total\n}\n$ result = sum_to(5)"
  $ t11_src = "! d(x: int) -> int { > x * 2 }\n$ result = map([1, 2, 3], d)"
  if run_test("map([1, 2, 3], x*2) = [2, 4, 6]", t11_src, [2, 4, 6]) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t12_src = "! g(x: int) -> bool { > x > 2 }\n$ result = filter([1, 2, 3, 4], g)"
  if run_test("filter([1..4], x>2) = [3, 4]", t12_src, [3, 4]) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t13_src = "! r(a: int, x: int) -> int { > a + x }\n$ result = reduce([1, 2, 3, 4], r, 0)"
  if run_test("reduce([1..4], 0, acc+x) = 10", t13_src, 10) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  if run_test("while loop (sum 1..5=15)", t3_src, 15) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t4_src = "! check(x: int) -> int {\n  if x > 5 {\n    > 100\n  } else {\n    > 200\n  }\n}\n$ result = check(10)"
  if run_test("if/else (true branch)", t4_src, 100) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t5_src = "! fact(n: int) -> int {\n  if n <= 1 { > 1 }\n  > n * fact(n - 1)\n}\n$ result = fact(5)"
  if run_test("recursive factorial(5)=120", t5_src, 120) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t6_src = "$ obj = { x: 10, y: 20 }\n$ result = obj.x + obj.y"
  if run_test("object literal + field access", t6_src, 30) { $ passed = passed + 1 } else { $ failed = failed + 1 }
  $ t7_src = "$ result = repeat(\"a\", 3)"
  if run_test("repeat(\"a\", 3) = \"aaa\"", t7_src, "aaa") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t8_src = "$ result = reverse(\"hello\")"
  if run_test("reverse(\"hello\") = \"olleh\"", t8_src, "olleh") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t9_src = "$ result = flatten([1, [2, 3], 4])"
  if run_test("flatten([1, [2, 3], 4])", t9_src, [1, 2, 3, 4]) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  $ t10_src = "$ result = range(3)"
  if run_test("range(3) = [0, 1, 2]", t10_src, [0, 1, 2]) { $ passed = passed + 1 } else { $ failed = failed + 1 }


  print("")
  print("========================================")
  print("  QUICK TEST — PASSED: " + toString(passed) + "  FAILED: " + toString(failed))
  print("========================================")

  if failed == 0 {
    > { ok: true, passed: passed, failed: failed }
  }
  > { ok: false, passed: passed, failed: failed }
}
