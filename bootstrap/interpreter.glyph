  print("")
  print("TEST: self-hosting seed (const A=10+20, B=A*2)")
  if seed_r.error != "" {
    print("  FAIL: " + seed_r.error)
    $ failed = failed + 1
  } else {
    $ bv = env_get(seed_env, "B")
    if bv.error != "" {
      print("  FAIL: no B binding: " + bv.error)
      $ failed = failed + 1
    } else {
      if bv.value != 60 {
        print("  FAIL: got " + toString(bv.value) + " expected 60")
        $ failed = failed + 1
      } else {
        print("  PASS: B = " + toString(bv.value))
        $ passed = passed + 1
      }
    }
  }

