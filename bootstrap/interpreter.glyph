# bootstrap/interpreter.glyph
# v0.16.0 Tree-walking interpreter for GlyphLang
# Evaluates AST nodes directly — no bytecode, no int-only limitation.
# This is the path to self-hosting: the Go `glyph exec` uses the same approach.

import "./parser"

# ─── Result Types ──────────────────────────────────────────────────

: EvalResult {
  value: any!
  error: str!
}

: ExecResult {
  value: any!
  error: str!
  signal: str!
}

: FuncDef {
  name: str!
  params: [any]!
  body: [any]!
  closure: any!
}

# ─── Environment ───────────────────────────────────────────────────

: Environment {
  bindings: any!
  parent: any!
}

! env_new() -> any {
  > { bindings: {}, parent: null }
}

! env_new_child(parent: any) -> any {
  > { bindings: {}, parent: parent }
}

! env_get(env: Environment, name: str) -> EvalResult {
  # Check if name exists in current bindings by iterating keys
  $ found = false
  $ val = null
  $ ks = keys(env.bindings)
  $ i = 0
  while i < length(ks) {
    if ks[i] == name {
      $ found = true
      $ val = env.bindings[ks[i]]
    }
    $ i = i + 1
  }
  if found {
    > { value: val, error: "" }
  }
  if env.parent != null {
    > env_get(env.parent, name)
  }
  > { value: null, error: "undefined variable: " + name }
}

! env_set(env: Environment, name: str, val: any) {
  $ keys = env.bindings
  $ keys[name] = val
  $ env.bindings = keys
}

# env_update walks up the scope chain to update an existing variable.
# Returns true if found and updated, false otherwise.
! env_update(env: Environment, name: str, val: any) -> bool {
  $ ks = keys(env.bindings)
  $ found = false
  $ i = 0
  while i < length(ks) {
    if ks[i] == name {
      $ found = true
    }
    $ i = i + 1
  }
  if found {
    $ b = env.bindings
    $ b[name] = val
    $ env.bindings = b
    > true
  }
  if env.parent != null {
    > env_update(env.parent, name, val)
  }
  > false
}

# ─── Truthiness ────────────────────────────────────────────────────

! is_truthy(val: any) -> bool {
  if val == null { > false }
  if val == 0 { > false }
  if val == "" { > false }
  if val == false { > false }
  if typeOf(val) == "object" {
    if val.kind == "bool" && val.value == false { > false }
  }
  > true
}

# ─── Type Coercion Helpers ─────────────────────────────────────────

! to_int(val: any) -> int {
  if typeOf(val) == "int" { > val }
  if val == true { > 1 }
  if val == false { > 0 }
  > 0
}

! to_bool(val: any) -> bool {
  > is_truthy(val)
}

! to_string(val: any) -> str {
  if val == null { > "null" }
  if typeOf(val) == "int" { > toString(val) }
  if typeOf(val) == "str" { > val }
  if typeOf(val) == "bool" {
    if val { > "true" }
    > "false"
  }
  > toString(val)
}

# ─── Value Comparison ──────────────────────────────────────────────

! compare_values(a: any, b: any) -> int {
  if typeOf(a) == "int" && typeOf(b) == "int" {
    if a < b { > -1 }
    if a > b { > 1 }
    > 0
  }
  $ sa = to_string(a)
  $ sb = to_string(b)
  if sa < sb { > -1 }
  if sa > sb { > 1 }
  > 0
}

# ─── Builtins ──────────────────────────────────────────────────────

! call_builtin(name: str, args: [any]) -> EvalResult {
  if name == "print" {
    $ out = ""
    $ i = 0
    while i < length(args) {
      if i > 0 { out = out + " " }
      $ out = out + to_string(args[i])
      $ i = i + 1
    }
    print(out)
    > { value: null, error: "" }
  }

  if name == "toString" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: to_string(args[0]), error: "" }
  }

  if name == "length" {
    if length(args) == 0 { > { value: 0, error: "" } }
    > { value: length(args[0]), error: "" }
  }

  if name == "typeOf" {
    if length(args) == 0 { > { value: "null", error: "" } }
    $ v = args[0]
    if v == null { > { value: "null", error: "" } }
    > { value: typeOf(v), error: "" }
  }

  if name == "toInt" {
    if length(args) == 0 { > { value: 0, error: "" } }
    > { value: to_int(args[0]), error: "" }
  }

  if name == "readFile" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: readFile(args[0]), error: "" }
  }

  if name == "writeFile" {
    if length(args) >= 2 {
      writeFile(args[0], args[1])
    }
    > { value: null, error: "" }
  }

  if name == "keys" {
    if length(args) == 0 { > { value: [], error: "" } }
    > { value: keys(args[0]), error: "" }
  }

  if name == "push" {
    if length(args) < 2 { > { value: args[0], error: "" } }
    > { value: args[0] + [args[1]], error: "" }
  }

  if name == "pop" {
    if length(args) == 0 { > { value: null, error: "pop: empty array" } }
    $ arr = args[0]
    if length(arr) == 0 { > { value: null, error: "pop: empty array" } }
    $ last = arr[length(arr) - 1]
    $ out = []
    $ pi = 0
    while pi < length(arr) - 1 {
      out = out + [arr[pi]]
      pi = pi + 1
    }
    > { value: { elem: last, rest: out }, error: "" }
  }

  if name == "charAt" {
    if length(args) < 2 { > { value: "", error: "" } }
    $ s = toString(args[0])
    $ idx = toInt(args[1])
    if idx < 0 || idx >= length(s) { > { value: "", error: "charAt index out of range" } }
    > { value: substring(s, idx, idx + 1), error: "" }
  }

  if name == "substring" {
    if length(args) < 3 { > { value: "", error: "" } }
    > { value: substring(toString(args[0]), toInt(args[1]), toInt(args[2])), error: "" }
  }

  if name == "indexOf" {
    if length(args) < 2 { > { value: -1, error: "" } }
    > { value: indexOf(toString(args[0]), toString(args[1])), error: "" }
  }

  if name == "split" {
    if length(args) < 2 { > { value: [], error: "" } }
    > { value: split(toString(args[0]), toString(args[1])), error: "" }
  }

  if name == "contains" {
    if length(args) < 2 { > { value: false, error: "" } }
    $ haystack = args[0]
    $ needle = args[1]
    if typeOf(haystack) == "str" {
      > { value: indexOf(toString(haystack), toString(needle)) >= 0, error: "" }
    }
    # array contains
    $ i = 0
    while i < length(haystack) {
      if haystack[i] == needle { > { value: true, error: "" } }
      $ i = i + 1
    }
    > { value: false, error: "" }
  }

  if name == "join" {
    if length(args) < 2 { > { value: "", error: "" } }
    $ arr = args[0]
    $ sep = toString(args[1])
    $ out = ""
    $ ji = 0
    while ji < length(arr) {
      if ji > 0 { out = out + sep }
      out = out + toString(arr[ji])
      ji = ji + 1
    }
    > { value: out, error: "" }
  }

  if name == "upper" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: upper(toString(args[0])), error: "" }
  }

  if name == "lower" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: lower(toString(args[0])), error: "" }
  }

  if name == "trim" {
    if length(args) == 0 { > { value: "", error: "" } }
    > { value: trim(toString(args[0])), error: "" }
  }

  if name == "replace" {
    if length(args) < 3 { > { value: args[0], error: "" } }
    > { value: replace(toString(args[0]), toString(args[1]), toString(args[2])), error: "" }
  }

  if name == "startsWith" {
    if length(args) < 2 { > { value: false, error: "" } }
    $ s = toString(args[0])
    $ p = toString(args[1])
    if length(p) > length(s) { > { value: false, error: "" } }
    > { value: substring(s, 0, length(p)) == p, error: "" }
  }

  if name == "endsWith" {
    if length(args) < 2 { > { value: false, error: "" } }
    $ s = toString(args[0])
    $ p = toString(args[1])
    if length(p) > length(s) { > { value: false, error: "" } }
    > { value: substring(s, length(s) - length(p), length(s)) == p, error: "" }
  }

  if name == "abs" {
    if length(args) == 0 { > { value: 0, error: "" } }
    $ v = toInt(args[0])
    if v < 0 { > { value: 0 - v, error: "" } }
    > { value: v, error: "" }
  }

  if name == "min" {
    if length(args) < 2 { > { value: args[0], error: "" } }
    $ a = toInt(args[0])
    $ b = toInt(args[1])
    if a < b { > { value: a, error: "" } }
    > { value: b, error: "" }
  }

  if name == "max" {
    if length(args) < 2 { > { value: args[0], error: "" } }
    $ a = toInt(args[0])
    $ b = toInt(args[1])
    if a > b { > { value: a, error: "" } }
    > { value: b, error: "" }
  }

  if name == "reverse" {
    if length(args) == 0 { > { value: [], error: "" } }
    $ arr = args[0]
    $ out = []
    $ ri = length(arr) - 1
    while ri >= 0 {
      out = out + [arr[ri]]
      ri = ri - 1
    }
    > { value: out, error: "" }
  }

  if name == "slice" {
    if length(args) < 3 { > { value: args[0], error: "" } }
    $ arr = args[0]
    $ start = toInt(args[1])
    $ end = toInt(args[2])
    if start < 0 { start = 0 }
    if end > length(arr) { end = length(arr) }
    $ out = []
    $ si = start
    while si < end {
      out = out + [arr[si]]
      si = si + 1
    }
    > { value: out, error: "" }
  }

  if name == "range" {
    $ rng_start = 0
    $ rng_end = 0
    if length(args) == 1 {
      rng_end = toInt(args[0])
    } else {
      if length(args) >= 2 {
        rng_start = toInt(args[0])
        rng_end = toInt(args[1])
      }
    }
    $ out = []
    $ ri = rng_start
    while ri < rng_end {
      out = out + [ri]
      ri = ri + 1
    }
    > { value: out, error: "" }
  }

  if name == "map" {
    if length(args) < 2 { > { value: [], error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "map: second arg must be a function" }
    }
    $ out = []
    $ mi = 0
    while mi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi == 0 { pval = arr[mi] }
        if pi == 1 { pval = mi }
        env_set(fn_env, pname, pval)
        pi = pi + 1
      }
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "map: " + sr.error } }
        if sr.signal == "return" {
          out = out + [sr.value]
          break
        }
        bi = bi + 1
      }
      mi = mi + 1
    }
    > { value: out, error: "" }
  }

  if name == "filter" {
    if length(args) < 2 { > { value: [], error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "filter: second arg must be a function" }
    }
    $ out = []
    $ fi = 0
    while fi < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi == 0 { pval = arr[fi] }
        if pi == 1 { pval = fi }
        env_set(fn_env, pname, pval)
        pi = pi + 1
      }
      $ bi = 0
      $ included = false
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "filter: " + sr.error } }
        if sr.signal == "return" {
          if is_truthy(sr.value) {
            out = out + [arr[fi]]
          }
          break
        }
        bi = bi + 1
      }
      fi = fi + 1
    }
    > { value: out, error: "" }
  }

  if name == "reduce" {
    if length(args) < 3 { > { value: args[2], error: "" } }
    $ arr = args[0]
    $ fn = args[1]
    $ acc = args[2]
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: "reduce: second arg must be a function" }
    }
    $ ri = 0
    while ri < length(arr) {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi == 0 { pval = acc }
        if pi == 1 { pval = arr[ri] }
        if pi == 2 { pval = ri }
        env_set(fn_env, pname, pval)
        pi = pi + 1
      }
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: "reduce: " + sr.error } }
        if sr.signal == "return" {
          acc = sr.value
          break
        }
        bi = bi + 1
      }
      ri = ri + 1
    }
    > { value: acc, error: "" }
  }

  > { value: null, error: "not_builtin:" + name }
}

# ─── Expression Evaluation ────────────────────────────────────────

! eval_expr(expr: any, env: Environment) -> EvalResult {

  if expr.kind == "literal" {
    if expr.literal_type == "int" { > { value: toInt(expr.literal_value), error: "" } }
    if expr.literal_type == "str" { > { value: expr.literal_value, error: "" } }
    if expr.literal_type == "bool" {
      if expr.literal_value == "true" { > { value: true, error: "" } }
      > { value: false, error: "" }
    }
    if expr.literal_type == "null" { > { value: null, error: "" } }
    > { value: expr.literal_value, error: "" }
  }

  if expr.kind == "variable" {
    > env_get(env, expr.var_name)
  }

  if expr.kind == "binary" {
    $ lr = eval_expr(expr.left, env)
    if lr.error != "" { > lr }
    $ rr = eval_expr(expr.right, env)
    if rr.error != "" { > rr }
    $ l = lr.value
    $ r = rr.value
    $ op = expr.op

    if op == "+" {
      # Array + Array: concatenate
      if typeOf(l) == "array" && typeOf(r) == "array" {
        $ merged = l
        $ mi = 0
        while mi < length(r) {
          $ merged = merged + [r[mi]]
          $ mi = mi + 1
        }
        > { value: merged, error: "" }
      }
      if typeOf(l) == "str" || typeOf(r) == "str" {
        > { value: to_string(l) + to_string(r), error: "" }
      }
      > { value: to_int(l) + to_int(r), error: "" }
    }
    if op == "-" { > { value: to_int(l) - to_int(r), error: "" } }
    if op == "*" {
      # String * int: repeat string
      if typeOf(l) == "str" && typeOf(r) == "int" {
        $ out = ""
        $ ri = 0
        while ri < to_int(r) {
          $ out = out + toString(l)
          $ ri = ri + 1
        }
        > { value: out, error: "" }
      }
      # int * str: repeat string
      if typeOf(l) == "int" && typeOf(r) == "str" {
        $ out = ""
        $ ri = 0
        while ri < to_int(l) {
          $ out = out + toString(r)
          $ ri = ri + 1
        }
        > { value: out, error: "" }
      }
      > { value: to_int(l) * to_int(r), error: "" }
    }
    if op == "/" {
      if to_int(r) == 0 { > { value: null, error: "division by zero" } }
      > { value: to_int(l) / to_int(r), error: "" }
    }
    if op == "%" {
      if to_int(r) == 0 { > { value: null, error: "modulo by zero" } }
      > { value: to_int(l) % to_int(r), error: "" }
    }
    if op == "==" { > { value: l == r, error: "" } }
    if op == "!=" { > { value: l != r, error: "" } }
    if op == "<" { > { value: compare_values(l, r) < 0, error: "" } }
    if op == ">" { > { value: compare_values(l, r) > 0, error: "" } }
    if op == "<=" { > { value: compare_values(l, r) <= 0, error: "" } }
    if op == ">=" { > { value: compare_values(l, r) >= 0, error: "" } }
    if op == "&&" { > { value: is_truthy(l) && is_truthy(r), error: "" } }
    if op == "||" { > { value: is_truthy(l) || is_truthy(r), error: "" } }
    > { value: null, error: "unknown operator: " + op }
  }

  if expr.kind == "unary" {
    $ or = eval_expr(expr.operand, env)
    if or.error != "" { > or }
    if expr.op == "!" { > { value: !is_truthy(or.value), error: "" } }
    if expr.op == "-" { > { value: 0 - to_int(or.value), error: "" } }
    > { value: null, error: "unknown unary op: " + expr.op }
  }

  if expr.kind == "call" {
    $ arg_vals = []
    $ i = 0
    while i < length(expr.args) {
      $ ar = eval_expr(expr.args[i], env)
      if ar.error != "" { > ar }
      $ arg_vals = arg_vals + [ar.value]
      $ i = i + 1
    }

    $ br = call_builtin(expr.func_name, arg_vals)
    if br.error == "" { > br }
    if br.error != "not_builtin:" + expr.func_name { > br }

    $ fr = env_get(env, expr.func_name)
    if fr.error != "" {
      > { value: null, error: "undefined function: " + expr.func_name }
    }
    $ fn = fr.value
    if typeOf(fn) != "object" || fn.kind != "func_def" {
      > { value: null, error: expr.func_name + " is not a function" }
    }

    $ fn_env = env_new_child(fn.closure)
    $ pi = 0
    while pi < length(fn.params) {
      $ pname = fn.params[pi].name
      $ pval = null
      if pi < length(arg_vals) { pval = arg_vals[pi] }
      env_set(fn_env, pname, pval)
      $ pi = pi + 1
    }

    $ bi = 0
    while bi < length(fn.body) {
      $ sr = exec_stmt(fn.body[bi], fn_env)
      if sr.error != "" { > { value: null, error: sr.error } }
      if sr.signal == "return" { > { value: sr.value, error: "" } }
      $ bi = bi + 1
    }
    > { value: null, error: "" }
  }

  # Method call: obj.method(args) — evaluates callee, then calls the result
  if expr.kind == "method_call" {
    $ callee_r = eval_expr(expr.object, env)
    if callee_r.error != "" { > callee_r }
    $ fn = callee_r.value

    $ arg_vals = []
    $ i = 0
    while i < length(expr.args) {
      $ ar = eval_expr(expr.args[i], env)
      if ar.error != "" { > ar }
      $ arg_vals = arg_vals + [ar.value]
      $ i = i + 1
    }

    # Check if callee result is a builtin name
    if typeOf(fn) == "str" {
      $ br = call_builtin(fn, arg_vals)
      if br.error == "" { > br }
    }

    # Check if callee is a func_def (from object field or index)
    if typeOf(fn) == "object" && fn.kind == "func_def" {
      $ fn_env = env_new_child(fn.closure)
      $ pi = 0
      while pi < length(fn.params) {
        $ pname = fn.params[pi].name
        $ pval = null
        if pi < length(arg_vals) { pval = arg_vals[pi] }
        env_set(fn_env, pname, pval)
        $ pi = pi + 1
      }
      $ bi = 0
      while bi < length(fn.body) {
        $ sr = exec_stmt(fn.body[bi], fn_env)
        if sr.error != "" { > { value: null, error: sr.error } }
        if sr.signal == "return" { > { value: sr.value, error: "" } }
        $ bi = bi + 1
      }
      > { value: null, error: "" }
    }

    > { value: null, error: "method call on non-function: " + typeOf(fn) }
  }

  if expr.kind == "field" {
    $ or = eval_expr(expr.object, env)
    if or.error != "" { > or }
    $ obj = or.value
    if typeOf(obj) != "object" {
      > { value: null, error: "field access on non-object" }
    }
    > { value: obj[expr.field_name], error: "" }
  }

  if expr.kind == "object" {
    $ obj = {}
    $ i = 0
    while i < length(expr.fields) {
      $ f = expr.fields[i]
      $ vr = eval_expr(f.value, env)
      if vr.error != "" { > vr }
      $ obj[f.key] = vr.value
      $ i = i + 1
    }
    > { value: obj, error: "" }
  }

  if expr.kind == "array" {
    $ arr = []
    $ i = 0
    while i < length(expr.elements) {
      $ er = eval_expr(expr.elements[i], env)
      if er.error != "" { > er }
      $ arr = arr + [er.value]
      $ i = i + 1
    }
    > { value: arr, error: "" }
  }

  if expr.kind == "index" {
    $ cr = eval_expr(expr.array_expr, env)
    if cr.error != "" { > cr }
    $ ir = eval_expr(expr.index_expr, env)
    if ir.error != "" { > ir }
    # String key → object field access: obj["field"]
    if typeOf(ir.value) == "str" {
      > { value: cr.value[ir.value], error: "" }
    }
    # Integer key → string character access: "hello"[0] → "h"
    if typeOf(cr.value) == "str" {
      $ ci = to_int(ir.value)
      if ci >= 0 && ci < length(cr.value) {
        > { value: charAt(cr.value, ci), error: "" }
      }
      > { value: null, error: "string index out of bounds: " + toString(ci) }
    }
    # Integer key → array index access: arr[i]
    $ ci = to_int(ir.value)
    if ci >= 0 && ci < length(cr.value) {
      > { value: cr.value[ci], error: "" }
    }
    > { value: null, error: "index out of bounds: " + toString(ci) }
  }

  > { value: null, error: "unsupported expression: " + expr.kind }
}

# ─── Statement Execution ──────────────────────────────────────────

! exec_stmt(stmt: any, env: Environment) -> ExecResult {
  $ null_result = { value: null, error: "", signal: "" }

  if stmt.kind == "assign" || stmt.kind == "reassign" {
    $ vr = eval_expr(stmt.value, env)
    if vr.error != "" { > { value: null, error: vr.error, signal: "" } }
    # Try to update in enclosing scope first (mutable closures)
    $ updated = env_update(env, stmt.target, vr.value)
    if !updated {
      env_set(env, stmt.target, vr.value)
    }
    > null_result
  }

  if stmt.kind == "return" {
    $ vr = eval_expr(stmt.return_value, env)
    if vr.error != "" { > { value: null, error: vr.error, signal: "return" } }
    > { value: vr.value, error: "", signal: "return" }
  }

  if stmt.kind == "if" {
    $ cr = eval_expr(stmt.condition, env)
    if cr.error != "" { > { value: null, error: cr.error, signal: "" } }
    if is_truthy(cr.value) {
      $ i = 0
      while i < length(stmt.then_block) {
        $ sr = exec_stmt(stmt.then_block[i], env)
        if sr.error != "" || sr.signal != "" { > sr }
        $ i = i + 1
      }
    } else {
      $ i = 0
      while i < length(stmt.else_block) {
        $ sr = exec_stmt(stmt.else_block[i], env)
        if sr.error != "" || sr.signal != "" { > sr }
        $ i = i + 1
      }
    }
    > null_result
  }

  if stmt.kind == "while" {
    while true {
      $ cr = eval_expr(stmt.while_condition, env)
      if cr.error != "" { > { value: null, error: cr.error, signal: "" } }
      if !is_truthy(cr.value) { > null_result }
      $ i = 0
      while i < length(stmt.body) {
        $ sr = exec_stmt(stmt.body[i], env)
        if sr.error != "" { > sr }
        if sr.signal == "break" { > null_result }
        if sr.signal == "return" { > sr }
        $ i = i + 1
      }
    }
    > null_result
  }

  if stmt.kind == "for_in" {
    $ ir = eval_expr(stmt.while_condition, env)
    if ir.error != "" { > { value: null, error: ir.error, signal: "" } }
    $ iterable = ir.value
    $ idx = 0
    while idx < length(iterable) {
      if stmt.field != "" {
        env_set(env, stmt.field, idx)
      }
      env_set(env, stmt.target, iterable[idx])
      $ i = 0
      while i < length(stmt.body) {
        $ sr = exec_stmt(stmt.body[i], env)
        if sr.error != "" { > sr }
        if sr.signal == "break" { > null_result }
        if sr.signal == "return" { > sr }
        if sr.signal == "continue" { break }
        $ i = i + 1
      }
      $ idx = idx + 1
    }
    > null_result
  }

  if stmt.kind == "expression" {
    $ er = eval_expr(stmt.expr, env)
    if er.error != "" { > { value: null, error: er.error, signal: "" } }
    > null_result
  }

  if stmt.kind == "field_assign" {
    $ or = eval_expr(stmt.obj_expr, env)
    if or.error != "" {
      > { value: null, error: or.error, signal: "" }
    }
    $ vr = eval_expr(stmt.value, env)
    if vr.error != "" {
      > { value: null, error: vr.error, signal: "" }
    }
    $ or.value[stmt.field] = vr.value
    > null_result
  }

  if stmt.kind == "index_assign" {
    # obj_expr may be nil for top-level array index assign; fall back to target variable
    $ obj_val = null
    if stmt.obj_expr != null {
      $ cr = eval_expr(stmt.obj_expr, env)
      if cr.error != "" { > { value: null, error: cr.error, signal: "" } }
      $ obj_val = cr.value
    } else {
      $ tr = env_get(env, stmt.target)
      if tr.error != "" { > { value: null, error: tr.error, signal: "" } }
      $ obj_val = tr.value
    }
    $ ir = eval_expr(stmt.index_expr, env)
    if ir.error != "" { > { value: null, error: ir.error, signal: "" } }
    $ vr = eval_expr(stmt.value, env)
    if vr.error != "" { > { value: null, error: vr.error, signal: "" } }
    if typeOf(ir.value) == "str" {
      $ obj_val[ir.value] = vr.value
    } else {
      $ obj_val[to_int(ir.value)] = vr.value
    }
    > null_result
  }

  if stmt.kind == "function" {
    $ fn = {
      kind: "func_def",
      name: stmt.func_name,
      params: stmt.func_params,
      body: stmt.func_body,
      closure: env
    }
    env_set(env, stmt.func_name, fn)
    > null_result
  }

  if stmt.kind == "break" { > { value: null, error: "", signal: "break" } }
  if stmt.kind == "continue" { > { value: null, error: "", signal: "continue" } }

  > { value: null, error: "unsupported stmt: " + stmt.kind, signal: "" }
}

# ─── Module Loading ────────────────────────────────────────────────

! exec_module(mod: any, env: Environment, base_path: str) -> EvalResult {
  $ items = mod.items
  $ i = 0
  while i < length(items) {
    $ item = items[i]

    if item.kind == "import" {
      $ raw_path = item.import_path
      $ file_path = base_path + raw_path + ".glyph"
      $ src = readFile(file_path)
      if length(src) == 0 {
        > { value: null, error: "import not found: " + file_path }
      }
      $ ip = parser.new_parser(src)
      $ ipr = parser.parse(ip)
      if ipr.error != "" {
        > { value: null, error: "import parse error (" + file_path + "): " + ipr.error }
      }
      $ imr = exec_module(ipr.mod, env, base_path)
      if imr.error != "" { > imr }
    }

    if item.kind == "from_import" {
      $ raw_path = item.from_path
      $ file_path = base_path + raw_path + ".glyph"
      $ src = readFile(file_path)
      if length(src) == 0 {
        > { value: null, error: "import not found: " + file_path }
      }
      $ ip = parser.new_parser(src)
      $ ipr = parser.parse(ip)
      if ipr.error != "" {
        > { value: null, error: "import parse error (" + file_path + "): " + ipr.error }
      }
      $ imr = exec_module(ipr.mod, env, base_path)
      if imr.error != "" { > imr }
    }

    if item.kind == "const" {
      $ vr = eval_expr(item.const_value, env)
      if vr.error != "" { > vr }
      env_set(env, item.const_name, vr.value)
    }

    if item.kind == "var_decl" {
      $ vr = eval_expr(item.var_value, env)
      if vr.error != "" { > vr }
      env_set(env, item.var_name, vr.value)
    }

    if item.kind == "type_def" {
    }

    if item.kind == "function" {
      env_set(env, item.func_name, null)
      $ fn = {
        kind: "func_def",
        name: item.func_name,
        params: item.func_params,
        body: item.func_body,
        closure: env
      }
      env_set(env, item.func_name, fn)
    }

    if item.kind == "command" {
      $ fn = {
        kind: "func_def",
        name: item.command_name,
        params: item.command_params,
        body: item.command_body,
        closure: env
      }
      env_set(env, "@cmd_" + item.command_name, fn)
    }

    if item.kind == "for_in" || item.kind == "if" || item.kind == "while" || item.kind == "assign" || item.kind == "expression" || item.kind == "return" || item.kind == "field_assign" || item.kind == "index_assign" {
      $ sr = exec_stmt(item, env)
      if sr.error != "" { > { value: null, error: sr.error } }
    }

    $ i = i + 1
  }
  > { value: null, error: "" }
}

# ─── Dynamic Eval (Self-Hosting Seed) ────────────────────────────

! eval_source(src: str, env: Environment, base_path: str) -> EvalResult {
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    > { value: null, error: "parse error: " + pr.error }
  }
  $ mr = exec_module(pr.mod, env, base_path)
  if mr.error != "" {
    > { value: null, error: "exec error: " + mr.error }
  }
  > { value: null, error: "" }
}

# ─── Entry Point ───────────────────────────────────────────────────

! run_test(name: str, src: str, expected: any) -> bool {
  print("")
  print("TEST: " + name)
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("  PARSE ERROR: " + pr.error)
    > false
  }

  $ env = env_new()
  $ mr = exec_module(pr.mod, env, "bootstrap/")
  if mr.error != "" {
    print("  EXEC ERROR: " + mr.error)
    > false
  }

  # Check "result" binding if expected != null
  if expected != null {
    $ rr = env_get(env, "result")
    if rr.error != "" {
      print("  ERROR: no 'result' binding: " + rr.error)
      > false
    }
    if rr.value != expected {
      print("  FAIL: got " + toString(rr.value) + " expected " + toString(expected))
      > false
    }
    print("  PASS: result = " + toString(rr.value))
    > true
  }
  print("  PASS (no result check)")
  > true
}

@ command run {
  print("========================================")
  print("  GlyphLang Bootstrap Interpreter v0.19")
  print("========================================")

  $ passed = 0
  $ failed = 0

  # ── Test 1: const + arithmetic ──
  $ t1_src = "const X = 42\nconst Y = X + 3\n$ result = Y"
  if run_test("const + arithmetic", t1_src, 45) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 2: function definition and call ──
  $ t2_src = "! double(x: int) -> int { > x * 2 }\n$ result = double(21)"
  if run_test("function call", t2_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 3: while loop (sum 1..5) ──
  $ t3_src = "! sum_to(n: int) -> int {\n  $ total = 0\n  $ i = 1\n  while i <= n {\n    $ total = total + i\n    $ i = i + 1\n  }\n  > total\n}\n$ result = sum_to(5)"
  if run_test("while loop (sum 1..5=15)", t3_src, 15) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 4: if/else branching ──
  $ t4_src = "! check(x: int) -> int {\n  if x > 5 {\n    > 100\n  } else {\n    > 200\n  }\n}\n$ result = check(10)"
  if run_test("if/else (true branch)", t4_src, 100) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 5: string concatenation ──
  $ t5_src = "const A = \"hello\"\nconst B = \" \" + \"world\"\n$ result = A + B"
  if run_test("string concat", t5_src, "hello world") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 6: recursive function (factorial) ──
  $ t6_src = "! fact(n: int) -> int {\n  if n <= 1 { > 1 }\n  > n * fact(n - 1)\n}\n$ result = fact(5)"
  if run_test("recursive factorial(5)=120", t6_src, 120) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 7: closures (make_adder returns inner function) ──
  $ t7_src = "! make_adder(n: int) -> any {\n  ! add(x: int) -> int { > x + n }\n  > add\n}\n$ f = make_adder(10)\n$ result = f(32)"
  if run_test("closure: make_adder(10)(32)=42", t7_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 8: for_in loop ──
  $ t8_src = "! sum_list(items: any) -> int {\n$ total = 0\nfor i in items {\n$ total = total + i\n}\n> total\n}\n$ result = sum_list([1, 2, 3, 4, 5])"
  if run_test("for_in loop (sum [1..5]=15)", t8_src, 15) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 9: nested function calls ──
  $ t9_src = "! square(x: int) -> int { > x * x }\n! sum_squares(a: int, b: int) -> int { > square(a) + square(b) }\n$ result = sum_squares(3, 4)"
  if run_test("nested calls (3²+4²=25)", t9_src, 25) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 10: boolean operators ──
  $ t10_src = "! test_and(a: int, b: int) -> bool {\n> a > 0 && b > 0\n}\n$ r1 = test_and(1, 2)\n$ result = 0\nif r1 { $ result = 1 }"
  if run_test("boolean AND", t10_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 11: object literal + field access ──
  $ t11_src = "$ obj = { x: 10, y: 20 }\n$ result = obj.x + obj.y"
  if run_test("object literal + field access", t11_src, 30) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 12: object field assignment ──
  $ t12_src = "$ obj = { x: 1, y: 2 }\n$ obj.x = 99\n$ result = obj.x + obj.y"
  if run_test("object field assignment", t12_src, 101) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 13: nested objects + chained field access ──
  $ t13_src = "$ obj = { inner: { val: 42 } }\n$ result = obj.inner.val"
  if run_test("nested object field access", t13_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 14: function returning object + field access ──
  $ t14_src = "! make_point(x: int, y: int) -> any {\n  > { x: x, y: y }\n}\n$ p = make_point(3, 7)\n$ result = p.x * 10 + p.y"
  if run_test("function returning object", t14_src, 37) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 15: object passed as function argument ──
  $ t15_src = "! get_area(rect: any) -> int {\n  > rect.w * rect.h\n}\n$ r = { w: 6, h: 7 }\n$ result = get_area(r)"
  if run_test("object as function argument", t15_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 16: object with string fields + concatenation ──
  $ t16_src = "$ person = { first: \"Ada\", last: \"Lovelace\" }\n$ result = person.first + \" \" + person.last"
  if run_test("object string fields", t16_src, "Ada Lovelace") { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 17: array of objects + field access in loop ──
  $ t17_src = "$ items = [{ v: 1 }, { v: 2 }, { v: 3 }]\n$ total = 0\nfor item in items {\n  $ total = total + item.v\n}\n$ result = total"
  if run_test("array of objects + field in loop", t17_src, 6) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 18: array literal + index ──
  $ t19_src = "$ arr = [10, 20, 30]\n$ result = arr[0] + arr[2]"
  if run_test("array literal + index", t19_src, 40) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 19: self-hosting seed — dynamic eval of arithmetic ──
  # Use eval_source to parse and execute a source string at runtime
  $ seed_env = env_new()
  $ seed_src = "const A = 10 + 20\nconst B = A * 2"
  $ seed_r = eval_source(seed_src, seed_env, "bootstrap/")
  print("")
  print("TEST: self-hosting seed (const A=10+20, B=A*2)")
  if seed_r.error != "" {
    print("  FAIL: " + seed_r.error)
    $ failed = failed + 1
  } else {
    $ bv = env_get(seed_env, "B")
    if bv.error != "" {
      print("  FAIL: no B binding: " + bv.error)
      $ failed = failed + 1
    } else {
      if bv.value != 60 {
        print("  FAIL: got " + toString(bv.value) + " expected 60")
        $ failed = failed + 1
      } else {
        print("  PASS: B = " + toString(bv.value))
        $ passed = passed + 1
      }
    }
  }

  # ── Test 20: self-hosting seed — dynamic eval with function ──
  # Use eval_source to define and call a function dynamically
  $ seed2_env = env_new()
  $ seed2_src = "! triple(x: int) -> int { > x * 3 }\n$ result = triple(14)"
  $ seed2_r = eval_source(seed2_src, seed2_env, "bootstrap/")
  print("")
  print("TEST: self-hosting seed (dynamic fn: triple(14)=42)")
  if seed2_r.error != "" {
    print("  FAIL: " + seed2_r.error)
    $ failed = failed + 1
  } else {
    $ rv = env_get(seed2_env, "result")
    if rv.error != "" {
      print("  FAIL: no result: " + rv.error)
      $ failed = failed + 1
    } else {
      if rv.value != 42 {
        print("  FAIL: got " + toString(rv.value) + " expected 42")
        $ failed = failed + 1
      } else {
        print("  PASS: result = " + toString(rv.value))
        $ passed = passed + 1
      }
    }
  }

  # ── Test 21: dynamic eval with field assignment ──
  $ seed3_env = env_new()
  $ seed3_src = "$ obj = { x: 1, y: 2 }\n$ obj.x = 10\n$ result = obj.x + obj.y"
  $ seed3_r = eval_source(seed3_src, seed3_env, "bootstrap/")
  print("")
  print("TEST: dynamic eval (field assignment)")
  if seed3_r.error != "" {
    print("  FAIL: " + seed3_r.error)
    $ failed = failed + 1
  } else {
    $ rv3 = env_get(seed3_env, "result")
    if rv3.error != "" {
      print("  FAIL: no result: " + rv3.error)
      $ failed = failed + 1
    } else {
      if rv3.value != 12 {
        print("  FAIL: got " + toString(rv3.value) + " expected 12")
        $ failed = failed + 1
      } else {
        print("  PASS: result = " + toString(rv3.value))
        $ passed = passed + 1
      }
    }
  }

  # ── Test 22: closure with enclosing param (nested fn) ──
  $ t22_src = "! make_accum(start: int) -> any {\n  ! add(x: int, y: int) -> int {\n    > x + y + start\n  }\n  > add\n}\n$ f = make_accum(10)\n$ result = f(20, 12)"
  if run_test("closure with enclosing param", t22_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 23: boolean OR ──
  $ t23_src = "! test_or(a: int, b: int) -> bool {\n  > a > 0 || b > 0\n}\n$ r1 = test_or(0, 5)\n$ result = 0\nif r1 { $ result = 1 }"
  if run_test("boolean OR", t23_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 24: index assignment in arrays ──
  $ t24_src = "$ arr = [10, 20, 30]\n$ arr[1] = 99\n$ result = arr[0] + arr[1] + arr[2]"
  if run_test("index assignment in arrays", t24_src, 139) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 25a: closure reads enclosing var (no mutation) ──
  $ t25a_src = "! make_counter() -> any {\n  $ count = 5\n  ! get_count() -> int {\n    > count\n  }\n  > get_count\n}\n$ f = make_counter()\n$ result = f()"
  if run_test("closure reads enclosing var (count=5)", t25a_src, 5) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 25b: mutable closure counter ──
  $ t25b_src = "! make_counter() -> any {\n  $ count = 0\n  ! inc() -> int {\n    $ count = count + 1\n    > count\n  }\n  > inc\n}\n$ f = make_counter()\n$ result = f()"
  if run_test("mutable closure (1 call=1)", t25b_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 26: break in for_in loop ──
  $ t26_src = "! find_val(items: any, target: int) -> int {\n  $ found = -1\n  for item in items {\n    if item == target {\n      $ found = item\n      break\n    }\n  }\n  > found\n}\n$ result = find_val([10, 20, 30], 20)"
  if run_test("break in for_in loop", t26_src, 20) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 27: higher-order function (fn as arg) ──
  $ t27_src = "! apply(f: any, x: int) -> int {\n  > f(x)\n}\n! double(x: int) -> int {\n  > x * 2\n}\n$ result = apply(double, 21)"
  if run_test("higher-order function (fn as arg)", t27_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 28: unary negation ──
  $ t28_src = "! negate(x: int) -> int {\n  > -x\n}\n$ result = negate(-42)"
  if run_test("unary negation (negate -42 = 42)", t28_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 29: read object fields in function ──
  $ t29a_src = "! read_obj(p: any) -> int {\n  > p.x + p.y\n}\n$ pt = { x: 10, y: 5 }\n$ result = read_obj(pt)"
  if run_test("read object fields in function", t29a_src, 15) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 30: string comparison (==) ──
  $ t30_src = "! cmp(a: str, b: str) -> int {\n  if a == b { > 1 }\n  > 0\n}\n$ result = cmp(\"hello\", \"hello\")"
  if run_test("string comparison (==)", t30_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 31: string inequality (!=) ──
  $ t31_src = "! neq(a: str, b: str) -> int {\n  if a != b { > 1 }\n  > 0\n}\n$ result = neq(\"hello\", \"world\")"
  if run_test("string comparison (!=)", t31_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 32: nested function returning function ──
  $ t32_src = "! outer(x: int) -> any {\n  ! inner(y: int) -> int {\n    > x * y\n  }\n  > inner\n}\n$ f = outer(6)\n$ result = f(7)"
  if run_test("nested function returning function (6*7=42)", t32_src, 42) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 33: boolean NOT ──
  $ t33_src = "! not_val(v: int) -> int {\n  if !v { > 1 }\n  > 0\n}\n$ result = not_val(0)"
  if run_test("boolean NOT (!0 = true)", t33_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 34: chained comparisons ──
  $ t34_src = "! in_range(x: int, lo: int, hi: int) -> int {\n  if x >= lo {\n    if x <= hi {\n      > 1\n    }\n  }\n  > 0\n}\n$ result = in_range(5, 1, 10)"
  if run_test("chained comparison (5 in 1..10)", t34_src, 1) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 35: object literal with computed expression fields ──
  $ t35_src = "$ a = 10\n$ b = 20\n$ obj = { sum: a + b, diff: b - a }\n$ result = obj.sum * obj.diff"
  if run_test("object literal with expression fields (30*10=300)", t35_src, 300) { $ passed = passed + 1 } else { $ failed = failed + 1 }

  # ── Test 36: object field mutation across function calls ──
  $ t36_src = "! bump(p: any) -> int {\n  $ v = p.val\n  $ p.val = v + 1\n  > p.val\n}\n$ obj = { val: 10 }\n$ r1 = bump(obj)\n$ result = r1 + obj.val"
