import "./parser"
import "./compiler"

! main() {
  print("=== Compiler Closure Test ===")
  $ src = "! make_adder(x: int) -> any { ! adder(y: int) -> int { > x + y } > adder }\n$ add5 = make_adder(5)\n> add5(10)"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("Parse error: " + pr.error)
    > false
  }
  
  $ c = compiler.new_compiler()
  $ cr = compiler.compile(c, pr.mod)
  if cr.error != "" {
    print("Compile error: " + cr.error)
    > false
  }
  
  $ res = vmExec(cr.bytecode)
  print("Result: " + toString(res))
  
  if res == 15 {
    print("✅ Closure Test PASSED")
    > true
  }
  print("❌ Closure Test FAILED: expected 15, got " + toString(res))
  > false
}

@ command run {
  main()
}
