import "./parser"

@ command run {
    $ src = readFile("bootstrap/parser.glyph")
    if src == "" {
        print("ERROR: Could not read parser.glyph")
        > {error: "file not found"}
    }
    
    print("Parsing parser.glyph (" + toString(length(src)) + " chars)...")
    
    $ p = parser.new_parser(src)
    $ res = parser.parse(p)
    
    if res.error != "" {
        print("ERROR: " + res.error)
        > {error: res.error}
    }
    
    print("SUCCESS! Parsed " + toString(length(res.mod.items)) + " items")
    print("")
    print("=== BOOTSTRAP COMPLETE ===")
    print("The GlyphLang parser can parse itself!")
    > {ok: true}
}
