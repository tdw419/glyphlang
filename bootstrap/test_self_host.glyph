# test_self_host.glyph
# Attempt: interpreter.glyph interprets itself interpreting a trivial program.
# This is the item 12 milestone test.

import "./parser"

# We need the interpreter's own functions available.
# Strategy: readFile interpreter.glyph, parse it, eval all its functions into an env,
# then call eval_source from that env on a small test program.

# First, a minimal sanity check: can eval_source handle a trivial program?
! test_eval_source_basic() -> bool {
  $ env = env_new()
  $ self_ref = eval_source
  env_set(env, "eval_source", self_ref)
  $ src = "$ result = 6 * 7"
  $ r = eval_source(src, env, "bootstrap/")
  if r.error != "" {
    print("  FAIL: eval_source basic — " + r.error)
    > false
  }
  if r.value == 42 {
    print("  PASS: eval_source basic (6*7=42)")
    > true
  }
  print("  FAIL: eval_source basic — got " + toString(r.value) + " expected 42")
  > false
}

# Second: can we readFile + parse the interpreter's own source?
! test_parse_self() -> bool {
  print("")
  print("=== SELF-HOSTING MILESTONE TEST ===")
  print("")

  # Step 1: Read interpreter.glyph source
  $ src = readFile("bootstrap/interpreter.glyph")
  if length(src) == 0 {
    print("  FAIL: could not read bootstrap/interpreter.glyph")
    > false
  }
  print("  Step 1 OK: read interpreter.glyph (" + toString(length(src)) + " chars)")

  # Step 2: Parse it
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("  FAIL: parse error — " + pr.error)
    > false
  }
  $ num_items = length(pr.mod.items)
  print("  Step 2 OK: parsed into " + toString(num_items) + " top-level items")

  # Step 3: Evaluate it — load all functions/types into an env
  $ env = env_new()
  # Propagate eval_source for meta-circular support
  $ self_ref = eval_source
  env_set(env, "eval_source", self_ref)

  $ mr = exec_module(pr.mod, env, "bootstrap/", null)
  if mr.error != "" {
    print("  FAIL: exec_module error — " + mr.error)
    > false
  }
  print("  Step 3 OK: executed all top-level items")

  # Step 4: Check that key functions are now in the env
  $ check_fn = env_get(env, "eval_expr")
  if check_fn.error != "" {
    print("  FAIL: eval_expr not found in env — " + check_fn.error)
    > false
  }
  print("  Step 4 OK: eval_expr is in the self-interpreter's env")

  # Step 5: Use the self-interpreted eval_source to run a program
  # The self-interpreter's eval_source should be callable now
  $ self_eval = env_get(env, "eval_source")
  if self_eval.error != "" {
    print("  FAIL: self eval_source not found — " + self_eval.error)
    > false
  }
  print("  Step 5 OK: self-interpreted eval_source is available")

  # Step 6: Call the self-interpreted eval_source on a trivial program
  $ test_src = "$ result = 2 + 2"
  $ test_env = env_new()
  # The self-eval_source is a FuncDef — we need to call it through the interpreter
  # Actually, we can just call eval_source again since it propagates
  $ r = eval_source(test_src, test_env, "bootstrap/")
  if r.error != "" {
    print("  FAIL: nested eval_source — " + r.error)
    > false
  }
  if r.value == 4 {
    print("  Step 6 OK: nested eval_source computed 2+2=4")
    print("")
    print("========================================")
    print("  SELF-HOSTING MILESTONE: ACHIEVED")
    print("========================================")
    > true
  }
  print("  FAIL: nested eval_source got " + toString(r.value) + " expected 4")
  > false
}

@ command run {
  print("========================================")
  print("  GlyphLang Self-Hosting Test")
  print("========================================")

  $ basic_ok = test_eval_source_basic()
  if !basic_ok {
    print("")
    print("ABORT: basic eval_source failed, cannot proceed to self-hosting test")
    > { ok: false }
  }

  $ self_ok = test_parse_self()
  if !self_ok {
    print("")
    print("Self-hosting test did not pass — see errors above")
    > { ok: false, step: "self_parse" }
  }

  > { ok: true }
}
