# bootstrap/test_self_host.glyph
# Ultimate test: parser parses itself

import "./parser"

@ command run {
    print("=== Self-Hosting Test ===")

    $ parser_src = readFile("bootstrap/parser.glyph")

    if parser_src == "" {
        print("ERROR: Could not read file")
        > {error: "file not found"}
    }

    print("Parsing parser.glyph (" + toString(length(parser_src)) + " chars)...")

    $ p = parser.new_parser(parser_src)
    $ res = parser.parse(p)

    if res.error != "" {
        print("ERROR: " + res.error)
        > {error: res.error}
    }

    $ items = res.mod.items
    print("SUCCESS! Parsed " + toString(length(items)) + " items")

    $ count = length(items)
    print("Imports: " + toString(count))
    print("")
    print("=== BOOTSTRAP COMPLETE ===")
    print("The GlyphLang parser can parse itself!")
    > {ok: true}
}
