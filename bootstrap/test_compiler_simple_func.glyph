import "./parser"
import "./compiler"

! main() {
  print("=== Compiler Simple Func Test ===")
  $ src = "! f() { > 42 }\n> f()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("Parse error: " + pr.error)
    > false
  }
  
  $ c = compiler.new_compiler()
  $ cr = compiler.compile(c, pr.mod)
  if cr.error != "" {
    print("Compile error: " + cr.error)
    > false
  }
  
  $ res = vmExec(cr.bytecode)
  print("Result: " + toString(res))
  
  if res == 42 {
    print("✅ Simple Func Test PASSED")
    > true
  }
  print("❌ Simple Func Test FAILED: expected 42, got " + toString(res))
  > false
}

@ command run {
  main()
}
