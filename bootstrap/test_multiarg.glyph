import "./vm"

@ command run {
    print("=== Multi-Arg Function Call Tests ===")
    $ passed = 0
    $ total = 0

    # Test 1: Two-arg add: f(a, b) = a + b
    $ total = total + 1
    print("Test 1: add(3, 4)")
    $ code1 = [
        OP_PUSH, 0,0,0,0,      # 0-4: push a=3
        OP_PUSH, 1,0,0,0,      # 5-9: push b=4
        OP_CALL, 16,0,0,0,     # 10-14: call add at offset 16
        OP_HALT,               # 15: halt
        # add(a, b) at offset 16: a=FP-2, b=FP-1
        OP_LOAD_FP, -2,        # 16-17: load a
        OP_LOAD_FP, -1,        # 18-19: load b
        OP_ADD,                 # 20: a + b
        OP_RETURN               # 21: return result
    ]
    $ result1 = vm.exec(code1, [3, 4])
    if result1 == 7 {
        print("  PASS: add(3, 4) = " + toString(result1))
        $ passed = passed + 1
    } else {
        print("  FAIL: expected 7, got " + toString(result1))
    }

    # Test 2: Three-arg: f(a, b, c) = a * b + c
    $ total = total + 1
    print("Test 2: calc(2, 3, 1) = 2*3+1")
    $ code2 = [
        OP_PUSH, 0,0,0,0,      # 0-4: push a=2
        OP_PUSH, 1,0,0,0,      # 5-9: push b=3
        OP_PUSH, 2,0,0,0,      # 10-14: push c=1
        OP_CALL, 21,0,0,0,     # 15-19: call calc at offset 21
        OP_HALT,               # 20: halt
        # calc(a, b, c) at offset 21: a=FP-3, b=FP-2, c=FP-1
        OP_LOAD_FP, -3,        # 21-22: load a
        OP_LOAD_FP, -2,        # 23-24: load b
        OP_MUL,                 # 25: a * b
        OP_LOAD_FP, -1,        # 26-27: load c
        OP_ADD,                 # 28: a*b + c
        OP_RETURN               # 29: return
    ]
    $ result2 = vm.exec(code2, [2, 3, 1])
    if result2 == 7 {
        print("  PASS: calc(2, 3, 1) = " + toString(result2))
        $ passed = passed + 1
    } else {
        print("  FAIL: expected 7, got " + toString(result2))
    }

    # Test 3: Nested calls: f(g(1,2), 3) where g=x+y, f=a+b
    $ total = total + 1
    print("Test 3: f(g(1,2), 3) = (1+2)+3 = 6")
    $ code3 = [
        OP_PUSH, 0,0,0,0,      # 0-4: push 1
        OP_PUSH, 1,0,0,0,      # 5-9: push 2
        OP_CALL, 26,0,0,0,     # 10-14: call g at offset 26
        OP_PUSH, 2,0,0,0,      # 15-19: push 3
        OP_CALL, 32,0,0,0,     # 20-24: call f at offset 32
        OP_HALT,               # 25: halt

        # g(x, y) at offset 26: x=FP-2, y=FP-1
        OP_LOAD_FP, -2,        # 26-27: load x
        OP_LOAD_FP, -1,        # 28-29: load y
        OP_ADD,                 # 30: x + y
        OP_RETURN,              # 31: return

        # f(a, b) at offset 32: a=FP-2, b=FP-1
        OP_LOAD_FP, -2,        # 32-33: load a
        OP_LOAD_FP, -1,        # 34-35: load b
        OP_ADD,                 # 36: a + b
        OP_RETURN               # 37: return
    ]
    $ result3 = vm.exec(code3, [1, 2, 3])
    if result3 == 6 {
        print("  PASS: f(g(1,2), 3) = " + toString(result3))
        $ passed = passed + 1
    } else {
        print("  FAIL: expected 6, got " + toString(result3))
    }

    print("")
    print("Multi-Arg: " + toString(passed) + "/" + toString(total))
    if passed == total { print("ALL MULTI-ARG TESTS PASSED") }
    > {ok: passed == total, passed: passed, total: total}
}
