import "./parser"
import "./compiler"

@ command run {
    $ src = "const x = 42 const y = x + 1"
    print("Compiling: " + src)
    
    $ p = parser.new_parser(src)
    $ res = parser.parse(p)
    
    if res.error != "" {
        print("Parse error: " + res.error)
        > {error: res.error}
    }
    
    print("Parsed " + toString(length(res.mod.items)) + " items")
    
    $ c = compiler.new_compiler()
    $ cres = compiler.compile(c, res.mod)
    
    if cres.error != "" {
        print("Compile error: " + cres.error)
        > {error: cres.error}
    }
    
    print("Emitted " + toString(length(cres.bytecode)) + " bytes")
    print("Constants: " + toString(c.constants))
    print("Instructions: " + toString(length(c.instructions)))
    
    > {ok: true}
}
