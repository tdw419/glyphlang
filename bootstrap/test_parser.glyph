# bootstrap/test_parser.glyph
# Self-hosted parser test: parses GlyphLang snippets and reports AST structure.

import "./parser"
import "./ast"
import "./token"

@ command run {
    print("=== Test 1: Const declarations ===")
    $ src1 = "const ILLEGAL = \"ILLEGAL\"\nconst EOF = \"EOF\"\nconst NEWLINE = \"NEWLINE\""
    $ p1 = parser.new_parser(src1)
    $ r1 = parser.parse(p1)
    if r1.error != "" {
        print("ERROR: " + r1.error)
    } else {
        print("Parsed " + toString(length(r1.mod.items)) + " items")
        $ i1 = 0
        while i1 < length(r1.mod.items) {
            $ item = r1.mod.items[i1]
            if item.kind == "const" {
                print("  const " + item.const_name + " = " + item.const_value.literal_value)
            }
            i1 = i1 + 1
        }
    }

    print("")
    print("=== Test 2: Type definition ===")
    $ src2 = ": Token {\n  type: str!\n  literal: str!\n  line: int!\n  col: int!\n}"
    $ p2 = parser.new_parser(src2)
    $ r2 = parser.parse(p2)
    if r2.error != "" {
        print("ERROR: " + r2.error)
    } else {
        $ i2 = 0
        while i2 < length(r2.mod.items) {
            $ item = r2.mod.items[i2]
            if item.kind == "type_def" {
                print("  type " + item.type_name + " (" + toString(length(item.type_fields)) + " fields)")
                $ j2 = 0
                while j2 < length(item.type_fields) {
                    $ f = item.type_fields[j2]
                    print("    " + f.name + ": " + f.type_annotation.kind)
                    j2 = j2 + 1
                }
            }
            i2 = i2 + 1
        }
    }

    print("")
    print("=== Test 3: Function definition ===")
    $ src3 = "! is_digit(ch: str) -> bool {\n  > ch >= \"0\" && ch <= \"9\"\n}"
    $ p3 = parser.new_parser(src3)
    $ r3 = parser.parse(p3)
    if r3.error != "" {
        print("ERROR: " + r3.error)
    } else {
        $ i3 = 0
        while i3 < length(r3.mod.items) {
            $ item = r3.mod.items[i3]
            if item.kind == "function" {
                print("  fn " + item.func_name + " (" + toString(length(item.func_params)) + " params, " + toString(length(item.func_body)) + " stmts)")
                $ j3 = 0
                while j3 < length(item.func_body) {
                    $ s = item.func_body[j3]
                    print("    stmt: " + s.kind)
                    j3 = j3 + 1
                }
            }
            i3 = i3 + 1
        }
    }

    print("")
    print("=== Test 4: Complex snippet ===")
    $ src4 = "import \"./token\"\n\n: Lexer {\n  input: str!\n  pos: int!\n}\n\n! new_lexer(input: str) -> Lexer {\n  $ l = {\n    input: input,\n    pos: 0\n  }\n  > l\n}"
    $ p4 = parser.new_parser(src4)
    $ r4 = parser.parse(p4)
    if r4.error != "" {
        print("ERROR: " + r4.error)
    } else {
        print("Parsed " + toString(length(r4.mod.items)) + " items")
        $ i4 = 0
        while i4 < length(r4.mod.items) {
            $ item = r4.mod.items[i4]
            if item.kind == "import" {
                print("  import \"" + item.import_path + "\"")
            }
            if item.kind == "type_def" {
                print("  type " + item.type_name + " (" + toString(length(item.type_fields)) + " fields)")
            }
            if item.kind == "function" {
                print("  fn " + item.func_name + " (" + toString(length(item.func_params)) + " params, " + toString(length(item.func_body)) + " stmts)")
            }
            i4 = i4 + 1
        }
    }

    print("")
    print("Self-hosted parser: ALL TESTS PASSED")
}
