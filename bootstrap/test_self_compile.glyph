import "/home/jericho/zion/projects/aipm/repos/glyphlang/bootstrap/parser"
import "/home/jericho/zion/projects/aipm/repos/glyphlang/bootstrap/compiler"

! main() {
  print("=== Compiler Self-Compilation Test ===")
  
  # 1. Load compiler.glyph source
  $ comp_src = readFile("/home/jericho/zion/projects/aipm/repos/glyphlang/bootstrap/compiler.glyph")
  $ _ = print("Compiler source length: ", length(comp_src))
  
  # 2. Parse compiler.glyph
  $ p = parser.new_parser(comp_src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    $ _ = print("Parse error: ", pr.error)
    > false
  }
  
  # 3. Compile compiler.glyph using tree-walking compiler
  print("Compiling compiler.glyph (tree-walking)...")
  $ c = compiler.new_compiler()
  $ cr = compiler.compile(c, pr.mod, "/home/jericho/zion/projects/aipm/repos/glyphlang/bootstrap/")
  if cr.error != "" {
    $ _ = print("Compile error: ", cr.error)
    > false
  }
  $ _ = print("Bytecode length: ", length(cr.bytecode))
  
  # 4. Verify bytecode starts with GLYP magic
  if length(cr.bytecode) < 4 || cr.bytecode[0] != 71 || cr.bytecode[1] != 76 || cr.bytecode[2] != 89 || cr.bytecode[3] != 80 {
    print("❌ Invalid bytecode magic")
    > false
  }
  
  print("✅ Self-Compilation PASSED (Stage 1)")
  print("✅ Final Bootstrap Milestone ACHIEVED")
  > true
}

@ command run {
  main()
}
