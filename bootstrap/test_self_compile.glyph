# bootstrap/test_self_compile.glyph
# THE BIG TEST: Can compiler.glyph compile itself?
# Feed compiler.glyph source through the self-hosted parser and compiler.

import "./parser"
import "./compiler"

@ command run {
    print("=== Self-Compilation Test ===")
    print("Goal: compiler.glyph compiles itself")
    print("")

    # Read compiler.glyph source
    $ src = readFile("bootstrap/compiler.glyph")
    print("Source: " + toString(length(src)) + " chars")

    # Step 1: Parse compiler.glyph
    print("")
    print("Step 1: Parsing compiler.glyph...")
    $ p = parser.new_parser(src)
    $ res = parser.parse(p)

    if res.error != "" {
        print("PARSE ERROR: " + res.error)
        > {ok: false, step: "parse", error: res.error}
    }

    print("  Parsed " + toString(length(res.mod.items)) + " top-level items")

    # Count item types
    $ consts = 0
    $ types = 0
    $ funcs = 0
    $ imports = 0
    $ other = 0
    $ i = 0
    while i < length(res.mod.items) {
        $ kind = res.mod.items[i].kind
        if kind == "const" { consts = consts + 1 }
        if kind == "type_def" { types = types + 1 }
        if kind == "function" { funcs = funcs + 1 }
        if kind == "import" { imports = imports + 1 }
        if kind != "const" && kind != "type_def" && kind != "function" && kind != "import" {
            other = other + 1
        }
        i = i + 1
    }

    print("  Constants: " + toString(consts))
    print("  Types: " + toString(types))
    print("  Functions: " + toString(funcs))
    print("  Imports: " + toString(imports))
    if other > 0 {
        print("  Other: " + toString(other))
    }

    # Step 2: Compile the parsed AST to bytecode
    print("")
    print("Step 2: Compiling to bytecode...")
    $ c = compiler.new_compiler()
    $ cres = compiler.compile(c, res.mod)

    if cres.error != "" {
        print("COMPILE ERROR: " + cres.error)
        > {ok: false, step: "compile", error: cres.error}
    }

    print("  Bytecode: " + toString(length(cres.bytecode)) + " bytes")
    print("  Constants: " + toString(length(c.constants)))
    print("  Instructions: " + toString(length(c.instructions)))

    # Verify header
    if cres.bytecode[0] == 71 && cres.bytecode[1] == 76 && cres.bytecode[2] == 89 && cres.bytecode[3] == 80 {
        print("  Magic: GLYP ✓")
    } else {
        print("  Magic: WRONG ✗")
    }

    print("")
    print("=== SELF-COMPILATION SUCCEEDED ===")
    print("compiler.glyph → parser → compiler → " + toString(length(cres.bytecode)) + " bytes of bytecode")

    > {
        ok: true,
        source_chars: length(src),
        items: length(res.mod.items),
        bytecode_bytes: length(cres.bytecode),
        constants: length(c.constants),
        instructions: length(c.instructions)
    }
}
