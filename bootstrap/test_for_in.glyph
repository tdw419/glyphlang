# bootstrap/test_for_in.glyph
# Phase 1: Test for-in parsing
import "./parser"

@ command run {
    print("=== For-In Parser Tests ===")
    $ passed = 0
    $ total = 0

    # Test 1: Parse "for x in arr { }"
    $ total = total + 1
    print("Test 1: parse 'for x in arr { }'")
    $ p1 = parser.new_parser("for x in arr { }")
    $ sr1 = parser.parse_statement(p1)
    if sr1.error != "" {
        print("  FAIL: " + sr1.error)
    } else {
        if sr1.stmt.kind != "for_in" {
            print("  FAIL: expected for_in, got " + sr1.stmt.kind)
        } else if sr1.stmt.target != "x" {
            print("  FAIL: expected target=x, got " + sr1.stmt.target)
        } else if sr1.stmt.field != "" {
            print("  FAIL: expected no key, got field=" + sr1.stmt.field)
        } else if sr1.stmt.while_condition.var_name != "arr" {
            print("  FAIL: expected iterable=arr, got " + sr1.stmt.while_condition.var_name)
        } else {
            print("  PASS: for_in x in arr")
            $ passed = passed + 1
        }
    }

    # Test 2: Parse "for k, v in items { }"
    $ total = total + 1
    print("Test 2: parse 'for k, v in items { }'")
    $ p2 = parser.new_parser("for k, v in items { }")
    $ sr2 = parser.parse_statement(p2)
    if sr2.error != "" {
        print("  FAIL: " + sr2.error)
    } else {
        if sr2.stmt.kind != "for_in" {
            print("  FAIL: expected for_in, got " + sr2.stmt.kind)
        } else if sr2.stmt.field != "k" {
            print("  FAIL: expected key=k, got " + sr2.stmt.field)
        } else if sr2.stmt.target != "v" {
            print("  FAIL: expected value=v, got " + sr2.stmt.target)
        } else if sr2.stmt.while_condition.var_name != "items" {
            print("  FAIL: expected iterable=items, got " + sr2.stmt.while_condition.var_name)
        } else {
            print("  PASS: for_in k, v in items")
            $ passed = passed + 1
        }
    }

    # Test 3: Parse with body
    $ total = total + 1
    print("Test 3: parse 'for x in arr { $ sum = sum + x }'")
    $ p3 = parser.new_parser("for x in arr { $ sum = sum + x }")
    $ sr3 = parser.parse_statement(p3)
    if sr3.error != "" {
        print("  FAIL: " + sr3.error)
    } else {
        $ body_len = length(sr3.stmt.body)
        if body_len != 1 {
            print("  FAIL: expected 1 body stmt, got " + toString(body_len))
        } else {
            print("  PASS: body has 1 statement")
            $ passed = passed + 1
        }
    }

    print("")
    print("For-In Parser: " + toString(passed) + "/" + toString(total))
    if passed == total { print("ALL FOR-IN PARSER TESTS PASSED") }
    > {ok: passed == total, passed: passed, total: total}
}
