! test_recursive_factorial() -> bool {
  # Test TRUE RECURSION with FP-relative access
  # factorial(5) = 5 * 4 * 3 * 2 * 1 = 120
  #
  # Stack layout after CALL:
  # [n, return_addr, old_fp]
  #  ↑              ↑         ↑
  #  0              1         2 (FP points to old_fp)
  #
  # To access arg: FP - 2 = index 0
  
  $ code = [
    OP_PUSH, 0,           # 0-1: PUSH 5
    OP_CALL, 9, 0, 0, 0,  # 2-6: CALL factorial at offset 9
    OP_HALT,              # 7: HALT
    OP_POP,               # 8: (padding)
    
    # factorial function (offset 9):
    # if n <= 1: return 1
    # else: return n * factorial(n-1)
    
    OP_LOAD_FP, -2,       # 9: Load n from FP-2
    OP_PUSH, 1,           # 10: PUSH 1
    OP_LE,                # 11: n <= 1?
    OP_JUMP_IF_FALSE, 22, 0, 0, 0,  # 12: If false, jump to recursive case
    
    # Base case (offset 19):
    OP_PUSH, 1,           # 19: Return 1
    OP_return,            # 21: RETURN
    
    # Recursive case (offset 22):
    # Save n, calculate n-1, call factorial, multiply
    OP_LOAD_fp, -2,       # 22: Load n
    OP_PUSH, 1,           # 23: PUSH 1
    OP_SUB,               # 24: n - 1
    OP_CALL, 9, 0, 0, 0,  # 25-29: CALL factorial(n-1)
    OP_load_fp, -2,       # 30: Load n again
    OP_MUL,               # 31: n * factorial(n-1)
    OP_return             # 32: RETURN result
  ]
  $ constants = [5, 1]
  $ result = exec(code, constants)
  
  if result == 120 {
    print("✅ test_recursive_factorial: 5! = 120 (TRUE RECURSION!)")
    > true
  }
  print("❌ test_recursive_factorial: expected 120, got ")
  print(result)
  > false
}