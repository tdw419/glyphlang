# bootstrap/vm.glyph
# Self-hosted VM for GlyphLang bytecode execution.
# v0.9.8 - Index Operations
# Functional style - immutable structs, returns new states.

# ─── Opcodes (Matching pkg/vm/vm.go) ────────────────────────────────

const OP_PUSH          = 1    # 0x01
const OP_POP           = 2    # 0x02
const OP_DUP           = 3    # 0x03 - Duplicate top of stack
const OP_SWAP          = 4    # 0x04 - Swap top two values
const OP_DUP_SECOND    = 5    # 0x05 - Duplicate second element from top
const OP_ADD           = 16   # 0x10
const OP_SUB           = 17   # 0x11
const OP_MUL           = 18   # 0x12
const OP_DIV           = 19   # 0x13
const OP_MOD           = 20   # 0x14
const OP_EQ            = 32   # 0x20
const OP_NE            = 33   # 0x21
const OP_LT            = 34   # 0x22
const OP_GT            = 35   # 0x23
const OP_GE            = 36   # 0x24
const OP_LE            = 37   # 0x25
const OP_AND           = 38   # 0x26
const OP_OR            = 39   # 0x27
const OP_NOT           = 40   # 0x28
const OP_NEG           = 41   # 0x29
const OP_LOAD_VAR      = 64   # 0x40
const OP_STORE_VAR     = 65   # 0x41
const OP_LOAD_FP       = 66   # 0x42 - Load from FP-relative offset
const OP_JUMP          = 80   # 0x50
const OP_JUMP_IF_FALSE = 81   # 0x51
const OP_JUMP_IF_TRUE  = 82   # 0x52
const OP_GET_ITER      = 83   # 0x53 - Create iterator from collection
const OP_ITER_NEXT     = 84   # 0x54 - Advance iterator, push value (opt: key)
const OP_ITER_HAS_NEXT = 85   # 0x55 - Check iterator has more elements
const OP_RETURN        = 97   # 0x61
const OP_CALL          = 98   # 0x62
const OP_BUILD_OBJECT  = 112  # 0x70
const OP_GET_FIELD     = 113  # 0x71
const OP_SET_FIELD     = 114  # 0x72
const OP_DEF_FUNC      = 115  # 0x73
const OP_BUILD_ARRAY   = 128  # 0x80
const OP_GET_INDEX     = 86   # 0x56 - arr[i] / str[i]
const OP_SET_INDEX     = 87   # 0x57 - arr[i] = val
const OP_HALT          = 255  # 0xFF

# ─── Heap Constants ─────────────────────────────────────────────────

const HEAP_BASE = 2000000
const HEAP_ITER_TAG = 3  # Iterator heap entry tag

# ─── VM State ────────────────────────────────────────────────────────

: VM {
  stack: [int]!
  pc: int!
  fp: int!       # Frame pointer for stack frames
  halted: bool!
  heap: [int]!   # Flat heap for arrays and objects
}

: PopResult {
  vm: VM!
  val: int!
}

# ─── VM Construction ────────────────────────────────────────────────

! new_vm() -> VM {
  > { stack: [], pc: 0, fp: 0, halted: false, heap: [] }
}

! vm_with_pc(vm: VM, pc: int) -> VM {
  > { stack: vm.stack, pc: pc, fp: vm.fp, halted: vm.halted, heap: vm.heap }
}

! vm_with_stack(vm: VM, stack: [int]) -> VM {
  > { stack: stack, pc: vm.pc, fp: vm.fp, halted: vm.halted, heap: vm.heap }
}

! vm_with_fp(vm: VM, fp: int) -> VM {
  > { stack: vm.stack, pc: vm.pc, fp: fp, halted: vm.halted, heap: vm.heap }
}

! vm_halted(vm: VM) -> VM {
  > { stack: vm.stack, pc: vm.pc, fp: vm.fp, halted: true, heap: vm.heap }
}

# ─── Stack Operations ───────────────────────────────────────────────

! vm_push(vm: VM, val: int) -> VM {
  > { stack: vm.stack + [val], pc: vm.pc, fp: vm.fp, halted: vm.halted, heap: vm.heap }
}

! vm_pop(vm: VM) -> PopResult {
  $ len = length(vm.stack)
  if len == 0 {
    print("Stack underflow!")
    > { vm: vm_halted(vm), val: 0 }
  }
  $ val = vm.stack[len - 1]
  $ new_stack = slice(vm.stack, 0, len - 1)
  > { vm: vm_with_stack(vm, new_stack), val: val }
}

! vm_peek(vm: VM) -> int {
  $ len = length(vm.stack)
  if len == 0 {
    print("Stack underflow in peek!")
    > 0
  }
  > vm.stack[len - 1]
}

! vm_peek_second(vm: VM) -> int {
  $ len = length(vm.stack)
  if len < 2 {
    print("Stack underflow in peek_second!")
    > 0
  }
  > vm.stack[len - 2]
}

# ─── Heap Operations ────────────────────────────────────────────────

# Convert heap ref to heap offset
! ref_to_offset(ref: int) -> int {
  > 0 - ref - HEAP_BASE
}

# Convert heap offset to ref
! offset_to_ref(offset: int) -> int {
  > 0 - (HEAP_BASE + offset)
}

# Set value at absolute position in heap array
! heap_set_at(heap: [int], pos: int, val: int) -> [int] {
  $ prefix = slice(heap, 0, pos)
  $ suffix = slice(heap, pos + 1, length(heap))
  > prefix + [val] + suffix
}

# Find a key in an object's heap data. Returns value position or -1.
# Object layout: [field_count, key0, val0, key1, val1, ...]
! heap_find_key(heap: [int], ref: int, key: int) -> int {
  $ offset = ref_to_offset(ref)
  $ field_count = heap[offset]
  $ i = 0
  while i < field_count {
    $ key_pos = offset + 1 + i * 2
    if heap[key_pos] == key {
      > offset + 2 + i * 2
    }
    $ i = i + 1
  }
  > -1
}

# ─── Helper: Read 4-byte address ─────────────────────────────────────

! read_addr(code: [int], pc: int) -> int {
  $ b0 = code[pc]
  $ b1 = code[pc + 1]
  $ b2 = code[pc + 2]
  $ b3 = code[pc + 3]
  > b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

# ─── Helper: Comparison functions ───────────────────────────────────

! compare_eq(a: int, b: int) -> int {
  if a == b { > 1 }
  > 0
}

! compare_ne(a: int, b: int) -> int {
  if a != b { > 1 }
  > 0
}

! compare_lt(a: int, b: int) -> int {
  if a < b { > 1 }
  > 0
}

! compare_gt(a: int, b: int) -> int {
  if a > b { > 1 }
  > 0
}

! compare_ge(a: int, b: int) -> int {
  if a >= b { > 1 }
  > 0
}

! compare_le(a: int, b: int) -> int {
  if a <= b { > 1 }
  > 0
}

! logic_not(a: int) -> int {
  if a == 0 { > 1 }
  > 0
}

! logic_and(a: int, b: int) -> int {
  if a != 0 && b != 0 { > 1 }
  > 0
}

! logic_or(a: int, b: int) -> int {
  if a != 0 || b != 0 { > 1 }
  > 0
}

! jump_if_false(cond: int, target: int, fallthrough: int) -> int {
  if cond == 0 { > target }
  > fallthrough
}

! jump_if_true(cond: int, target: int, fallthrough: int) -> int {
  if cond != 0 { > target }
  > fallthrough
}

# ─── Execution ──────────────────────────────────────────────────────

! vm_exec(vm: VM, code: [int], constants: [int]) -> int {
  $ current = vm
  while !current.halted && current.pc < length(code) {
    $ op = code[current.pc]
    $ result = vm_step(current, op, code, constants)
    $ current = result.vm
  }
  $ final = vm_pop(current)
  > final.val
}

: StepResult {
  vm: VM!
}

! vm_step(vm: VM, op: int, code: [int], constants: [int]) -> StepResult {
  # Stack operations
  if op == OP_PUSH {
    $ idx = code[vm.pc + 1]
    $ vm2 = vm_push(vm, constants[idx])
    $ vm3 = vm_with_pc(vm2, vm.pc + 2)
    > { vm: vm3 }
  }
  
  if op == OP_POP {
    $ result = vm_pop(vm)
    $ vm2 = vm_with_pc(result.vm, vm.pc + 1)
    > { vm: vm2 }
  }
  
  if op == OP_DUP {
    $ val = vm_peek(vm)
    $ vm2 = vm_push(vm, val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_SWAP {
    $ a = vm_pop(vm)
    $ b = vm_pop(a.vm)
    $ vm2 = vm_push(b.vm, a.val)
    $ vm3 = vm_push(vm2, b.val)
    $ vm4 = vm_with_pc(vm3, vm.pc + 1)
    > { vm: vm4 }
  }
  
  if op == OP_DUP_SECOND {
    $ val = vm_peek_second(vm)
    $ vm2 = vm_push(vm, val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # Arithmetic
  if op == OP_ADD {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val + rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_SUB {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val - rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_MUL {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val * rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_DIV {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    if rb.val == 0 {
      print("Division by zero!")
      > { vm: vm_halted(vm) }
    }
    $ vm2 = vm_push(ra.vm, ra.val / rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_MOD {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val % rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # Comparison
  if op == OP_EQ {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_eq(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_NE {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_ne(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_LT {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_lt(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_GT {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_gt(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_GE {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_ge(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_LE {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_le(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # Logic
  if op == OP_AND {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = logic_and(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_OR {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = logic_or(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_NOT {
    $ ra = vm_pop(vm)
    $ result = logic_not(ra.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_NEG {
    $ ra = vm_pop(vm)
    $ vm2 = vm_push(ra.vm, 0 - ra.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # Variables (simple implementation - globals array in constants)
  if op == OP_LOAD_VAR {
    $ idx = code[vm.pc + 1]
    $ vm2 = vm_push(vm, constants[idx])
    $ vm3 = vm_with_pc(vm2, vm.pc + 2)
    > { vm: vm3 }
  }
  
  if op == OP_LOAD_FP {
    $ offset = code[vm.pc + 1]
    $ idx = vm.fp + offset
    if idx < 0 {
      print("FP index underflow!")
      > { vm: vm_halted(vm) }
    }
    if idx >= length(vm.stack) {
      print("FP index overflow!")
      > { vm: vm_halted(vm) }
    }
    $ val = vm.stack[idx]
    $ vm2 = vm_push(vm, val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 2)
    > { vm: vm3 }
  }
  
  if op == OP_STORE_VAR {
    $ result = vm_pop(vm)
    $ vm2 = vm_with_pc(result.vm, vm.pc + 1)
    > { vm: vm2 }
  }
  
  # Control flow
  if op == OP_JUMP {
    $ target = read_addr(code, vm.pc + 1)
    $ vm2 = vm_with_pc(vm, target)
    > { vm: vm2 }
  }
  
  if op == OP_JUMP_IF_FALSE {
    $ target = read_addr(code, vm.pc + 1)
    $ cond = vm_pop(vm)
    $ new_pc = jump_if_false(cond.val, target, vm.pc + 5)
    $ vm2 = vm_with_pc(cond.vm, new_pc)
    > { vm: vm2 }
  }
  
  if op == OP_JUMP_IF_TRUE {
    $ target = read_addr(code, vm.pc + 1)
    $ cond = vm_pop(vm)
    $ new_pc = jump_if_true(cond.val, target, vm.pc + 5)
    $ vm2 = vm_with_pc(cond.vm, new_pc)
    > { vm: vm2 }
  }
  
  # Function calls
  if op == OP_CALL {
    $ target = read_addr(code, vm.pc + 1)
    $ return_addr = vm.pc + 5
    # Stack layout: [..., arg(s), old_fp, return_addr, stack_base]
    # stack_base = stack size before frame (caller's stack depth)
    $ stack_base = length(vm.stack)
    $ vm2 = vm_push(vm, vm.fp)          # old_fp
    $ vm3 = vm_push(vm2, return_addr)   # return_addr
    $ vm4 = vm_push(vm3, stack_base)    # stack_base for cleanup
    $ vm5 = vm_with_fp(vm4, length(vm4.stack) - 3)  # FP points to old_fp
    $ vm6 = vm_with_pc(vm5, target)
    > { vm: vm6 }
  }
  
  if op == OP_RETURN {
    # Frame layout at FP: [old_fp, return_addr, stack_base]
    # Read frame values by FP-relative position, NOT by popping.
    # There can be leftover temps between result and frame header.
    $ result = vm_pop(vm)
    # Read frame directly from stack by position
    $ old_fp = vm.stack[vm.fp]
    $ return_addr = vm.stack[vm.fp + 1]
    $ stack_base = vm.stack[vm.fp + 2]
    # Restore FP and PC
    $ vm2 = vm_with_fp(result.vm, old_fp)
    $ vm3 = vm_with_pc(vm2, return_addr)
    # Trim stack to stack_base (removes leftover args/temps)
    $ trimmed = slice(vm3.stack, 0, stack_base)
    $ vm4 = { stack: trimmed, pc: vm3.pc, fp: vm3.fp, halted: vm3.halted, heap: vm3.heap }
    # Push result back
    $ vm5 = vm_push(vm4, result.val)
    > { vm: vm5 }
  }
  
  # ─── Object & Array Opcodes (v0.9.7) ──────────────────────────────
  
  # OP_BUILD_ARRAY: operand = element count
  # Pops `count` elements from stack, stores in heap, pushes ref.
  # Heap layout: [count, elem0, elem1, ...]
  if op == OP_BUILD_ARRAY {
    $ count = code[vm.pc + 1]
    # Pop elements and collect in order (prepend reverses pop order)
    $ elems = []
    $ current = vm
    $ i = 0
    while i < count {
      $ pop_result = vm_pop(current)
      $ elems = [pop_result.val] + elems
      $ current = pop_result.vm
      $ i = i + 1
    }
    # Allocate in heap
    $ heap_data = [count] + elems
    $ ref = 0 - (HEAP_BASE + length(current.heap))
    $ new_heap = current.heap + heap_data
    # Create VM with updated heap, push ref, advance PC
    $ vm2 = { stack: current.stack, pc: current.pc, fp: current.fp, halted: current.halted, heap: new_heap }
    $ vm3 = vm_push(vm2, ref)
    $ vm4 = vm_with_pc(vm3, vm.pc + 2)
    > { vm: vm4 }
  }
  
  # OP_BUILD_OBJECT: operand = field count
  # For each field: pop value, then pop key.
  # Heap layout: [field_count, key0, val0, key1, val1, ...]
  if op == OP_BUILD_OBJECT {
    $ field_count = code[vm.pc + 1]
    $ fields = []
    $ current = vm
    $ i = 0
    while i < field_count {
      $ val_pop = vm_pop(current)
      $ key_pop = vm_pop(val_pop.vm)
      # Prepend key-value pair (reverses to match push order)
      $ fields = [key_pop.val, val_pop.val] + fields
      $ current = key_pop.vm
      $ i = i + 1
    }
    # Allocate in heap
    $ heap_data = [field_count] + fields
    $ ref = 0 - (HEAP_BASE + length(current.heap))
    $ new_heap = current.heap + heap_data
    $ vm2 = { stack: current.stack, pc: current.pc, fp: current.fp, halted: current.halted, heap: new_heap }
    $ vm3 = vm_push(vm2, ref)
    $ vm4 = vm_with_pc(vm3, vm.pc + 2)
    > { vm: vm4 }
  }
  
  # OP_GET_FIELD: pop key, pop obj_ref, look up in heap, push value.
  if op == OP_GET_FIELD {
    $ key_pop = vm_pop(vm)
    $ obj_pop = vm_pop(key_pop.vm)
    $ val_pos = heap_find_key(obj_pop.vm.heap, obj_pop.val, key_pop.val)
    if val_pos == -1 {
      print("Field not found!")
      > { vm: vm_halted(obj_pop.vm) }
    }
    $ val = obj_pop.vm.heap[val_pos]
    $ vm2 = vm_push(obj_pop.vm, val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # OP_SET_FIELD: pop value, pop key, pop obj_ref, update heap, push obj_ref.
  if op == OP_SET_FIELD {
    $ val_pop = vm_pop(vm)
    $ key_pop = vm_pop(val_pop.vm)
    $ obj_pop = vm_pop(key_pop.vm)
    $ val_pos = heap_find_key(obj_pop.vm.heap, obj_pop.val, key_pop.val)
    if val_pos == -1 {
      print("Field not found for set!")
      > { vm: vm_halted(obj_pop.vm) }
    }
    $ new_heap = heap_set_at(obj_pop.vm.heap, val_pos, val_pop.val)
    $ vm2 = { stack: obj_pop.vm.stack, pc: obj_pop.vm.pc, fp: obj_pop.vm.fp, halted: obj_pop.vm.halted, heap: new_heap }
    $ vm3 = vm_push(vm2, obj_pop.val)
    $ vm4 = vm_with_pc(vm3, vm.pc + 1)
    > { vm: vm4 }
  }
  
  # OP_DEF_FUNC: skip over function body.
  # Format: OP_DEF_FUNC, name_idx(1), param_count(1), body_length(1), [param_name_idx(1)]..., body...
  if op == OP_DEF_FUNC {
    $ name_idx = code[vm.pc + 1]
    $ param_count = code[vm.pc + 2]
    $ body_length = code[vm.pc + 3]
    # Total: opcode(1) + name(1) + params(1) + body_len(1) + param_names(param_count) + body(body_length)
    $ total_size = 4 + param_count + body_length
    $ vm2 = vm_with_pc(vm, vm.pc + total_size)
    > { vm: vm2 }
  }
  
  # ─── Index Operations (v0.9.8) ─────────────────────────────────────
  
  # OP_GET_INDEX: pop index, pop array/object ref, push element at index
  # Array layout: [count, elem0, elem1, ...]
  if op == OP_GET_INDEX {
    $ idx_pop = vm_pop(vm)
    $ arr_pop = vm_pop(idx_pop.vm)
    $ idx = idx_pop.val
    $ ref = arr_pop.val
    
    # Convert ref to heap offset
    $ offset = ref_to_offset(ref)
    
    # Array layout: [count, elem0, elem1, ...]
    # Element at index i is at offset + 1 + i
    $ count = arr_pop.vm.heap[offset]
    
    if idx < 0 || idx >= count {
      print("Array index out of bounds!")
      print("  index:")
      print(idx)
      print("  count:")
      print(count)
      > { vm: vm_halted(arr_pop.vm) }
    }
    
    $ val = arr_pop.vm.heap[offset + 1 + idx]
    $ vm2 = vm_push(arr_pop.vm, val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # OP_SET_INDEX: pop value, pop index, pop array ref, update heap, push array ref
  if op == OP_SET_INDEX {
    $ val_pop = vm_pop(vm)
    $ idx_pop = vm_pop(val_pop.vm)
    $ arr_pop = vm_pop(idx_pop.vm)
    
    $ idx = idx_pop.val
    $ ref = arr_pop.val
    $ val = val_pop.val
    
    $ offset = ref_to_offset(ref)
    $ count = arr_pop.vm.heap[offset]
    
    if idx < 0 || idx >= count {
      print("Array index out of bounds for set!")
      print("  index:")
      print(idx)
      print("  count:")
      print(count)
      > { vm: vm_halted(arr_pop.vm) }
    }
    
    $ elem_offset = offset + 1 + idx
    $ new_heap = heap_set_at(arr_pop.vm.heap, elem_offset, val)
    $ vm2 = { stack: arr_pop.vm.stack, pc: arr_pop.vm.pc, fp: arr_pop.vm.fp, halted: arr_pop.vm.halted, heap: new_heap }
    $ vm3 = vm_push(vm2, ref)
    $ vm4 = vm_with_pc(vm3, vm.pc + 1)
    > { vm: vm4 }
  }
  
  # OP_GET_ITER: pop collection ref, create iterator in heap, push iter ref
  # Heap layout: [HEAP_ITER_TAG(3), collection_ref, current_index(0), element_count]
  if op == OP_GET_ITER {
    $ coll_pop = vm_pop(vm)
    $ coll_ref = coll_pop.val
    $ offset = ref_to_offset(coll_ref)
    $ elem_count = coll_pop.vm.heap[offset]
    $ iter_data = [HEAP_ITER_TAG, coll_ref, 0, elem_count]
    $ iter_ref = 0 - (HEAP_BASE + length(coll_pop.vm.heap))
    $ new_heap = coll_pop.vm.heap + iter_data
    $ vm2 = { stack: coll_pop.vm.stack, pc: coll_pop.vm.pc, fp: coll_pop.vm.fp, halted: coll_pop.vm.halted, heap: new_heap }
    $ vm3 = vm_push(vm2, iter_ref)
    $ vm4 = vm_with_pc(vm3, vm.pc + 1)
    > { vm: vm4 }
  }
  
  # OP_ITER_HAS_NEXT: pop iter ref, push 1 if has next, 0 if exhausted
  # Iterator heap: [ITER_TAG, coll_ref, current_index, element_count]
  if op == OP_ITER_HAS_NEXT {
    $ iter_pop = vm_pop(vm)
    $ iter_ref = iter_pop.val
    $ iter_offset = ref_to_offset(iter_ref)
    $ current_idx = iter_pop.vm.heap[iter_offset + 2]
    $ elem_count = iter_pop.vm.heap[iter_offset + 3]
    $ has_next = 0
    if current_idx < elem_count {
      $ has_next = 1
    }
    $ vm2 = vm_push(iter_pop.vm, has_next)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # OP_ITER_NEXT: operand = hasKey (0 or 1)
  # Pop iter ref, advance iterator, push value (and key if hasKey)
  # For arrays: key = index, value = element
  if op == OP_ITER_NEXT {
    $ has_key = code[vm.pc + 1]
    $ iter_pop = vm_pop(vm)
    $ iter_ref = iter_pop.val
    $ iter_offset = ref_to_offset(iter_ref)
    $ coll_ref = iter_pop.vm.heap[iter_offset + 1]
    $ current_idx = iter_pop.vm.heap[iter_offset + 2]
    # Read value from collection
    $ coll_offset = ref_to_offset(coll_ref)
    $ val = iter_pop.vm.heap[coll_offset + 1 + current_idx]
    # Advance iterator index in heap
    $ new_heap = heap_set_at(iter_pop.vm.heap, iter_offset + 2, current_idx + 1)
    $ vm2 = { stack: iter_pop.vm.stack, pc: iter_pop.vm.pc, fp: iter_pop.vm.fp, halted: iter_pop.vm.halted, heap: new_heap }
    # Push key then value (if hasKey), or just value
    $ vm3 = vm2
    if has_key != 0 {
      $ vm3 = vm_push(vm2, current_idx)
    }
    $ vm4 = vm_push(vm3, val)
    $ vm5 = vm_with_pc(vm4, vm.pc + 2)
    > { vm: vm5 }
  }
  
  if op == OP_HALT {
    > { vm: vm_halted(vm) }
  }
  
  print("Unknown opcode!")
  print("  PC:")
  print(vm.pc)
  print("  Stack:")
  print(length(vm.stack))
  > { vm: vm_halted(vm) }
}

# ─── Entry Point ─────────────────────────────────────────────────────

! exec(code: [int], constants: [int]) -> int {
  $ vm = new_vm()
  > vm_exec(vm, code, constants)
}

# Single-step execution: run one opcode, return new VM state
! step(code: [int], constants: [int], state: VM) -> StepResult {
  $ op = code[state.pc]
  > vm_step(state, op, code, constants)
}

# ─── Tests ───────────────────────────────────────────────────────────

! test_simple() -> bool {
  $ code = [OP_PUSH, 0, OP_HALT]
  $ constants = [42]
  $ result = exec(code, constants)
  if result == 42 {
    print("✅ test_simple: 42")
    > true
  }
  print("❌ test_simple: expected 42")
  > false
}

! test_arithmetic() -> bool {
  $ code = [OP_PUSH, 0, OP_PUSH, 1, OP_ADD, OP_PUSH, 2, OP_MUL, OP_HALT]
  $ constants = [5, 3, 2]
  $ result = exec(code, constants)
  if result == 16 {
    print("✅ test_arithmetic: (5+3)*2 = 16")
    > true
  }
  print("❌ test_arithmetic: expected 16")
  > false
}

! test_comparison() -> bool {
  $ code = [OP_PUSH, 0, OP_PUSH, 1, OP_LT, OP_HALT]
  $ constants = [5, 10]
  $ result = exec(code, constants)
  if result == 1 {
    print("✅ test_comparison: 5 < 10 = 1")
    > true
  }
  print("❌ test_comparison: expected 1")
  > false
}

! test_loop() -> bool {
  $ code = [
    OP_PUSH, 0,
    OP_PUSH, 1,
    OP_ADD,
    OP_PUSH, 2,
    OP_ADD,
    OP_PUSH, 3,
    OP_ADD,
    OP_PUSH, 4,
    OP_ADD,
    OP_HALT
  ]
  $ constants = [1, 2, 3, 4, 5]
  $ result = exec(code, constants)
  if result == 15 {
    print("✅ test_loop (unrolled): 1+2+3+4+5 = 15")
    > true
  }
  print("❌ test_loop: expected 15")
  > false
}

! test_conditional() -> bool {
  $ code = [
    OP_PUSH, 0,
    OP_PUSH, 1,
    OP_GT,
    OP_JUMP_IF_FALSE, 14, 0, 0, 0,
    OP_PUSH, 2,
    OP_JUMP, 18, 0, 0, 0,
    OP_PUSH, 3,
    OP_HALT
  ]
  $ constants = [5, 3, 1, 0]
  $ result = exec(code, constants)
  if result == 1 {
    print("✅ test_conditional: if(5>3) = 1")
    > true
  }
  print("❌ test_conditional: expected 1")
  > false
}

! test_logic() -> bool {
  $ code = [
    OP_PUSH, 0,
    OP_PUSH, 1,
    OP_GT,
    OP_PUSH, 2,
    OP_PUSH, 3,
    OP_GT,
    OP_AND,
    OP_HALT
  ]
  $ constants = [5, 3, 10, 5]
  $ result = exec(code, constants)
  if result == 1 {
    print("✅ test_logic: (5>3) AND (10>5) = 1")
    > true
  }
  print("❌ test_logic: expected 1")
  > false
}

! test_or() -> bool {
  $ code = [
    OP_PUSH, 0,
    OP_PUSH, 1,
    OP_LT,
    OP_PUSH, 2,
    OP_PUSH, 3,
    OP_GT,
    OP_OR,
    OP_HALT
  ]
  $ constants = [5, 3, 10, 5]
  $ result = exec(code, constants)
  if result == 1 {
    print("✅ test_or: (5<3) OR (10>5) = 1")
    > true
  }
  print("❌ test_or: expected 1")
  > false
}

! test_load_var() -> bool {
  $ code = [
    OP_LOAD_VAR, 0,
    OP_HALT
  ]
  $ constants = [42]
  $ result = exec(code, constants)
  if result == 42 {
    print("✅ test_load_var: LOAD_VAR 0 = 42")
    > true
  }
  print("❌ test_load_var: expected 42")
  > false
}

! test_factorial() -> bool {
  $ n = 5
  $ result = 1
  while n > 1 {
    $ result = result * n
    $ n = n - 1
  }
  if result == 120 {
    print("✅ test_factorial: 5! = 120 (backward jumps!)")
    > true
  }
  print("❌ test_factorial: expected 120, got " + str(result))
  > false
}

! test_simple_call_return() -> bool {
  $ code = [
    OP_CALL, 6, 0, 0, 0,
    OP_HALT,
    OP_PUSH, 0,
    OP_RETURN
  ]
  $ constants = [42]
  $ result = exec(code, constants)
  if result == 42 {
    print("✅ test_simple_call_return: return_42() = 42")
    > true
  }
  print("❌ test_simple_call_return: expected 42")
  > false
}

! test_recursive_factorial() -> bool {
  $ code = [
    OP_PUSH, 0,           # 0-1: PUSH 5
    OP_CALL, 9, 0, 0, 0,  # 2-6: CALL factorial at offset 9
    OP_HALT,              # 7: HALT
    OP_POP,               # 8: (padding)
    
    # factorial function (offset 9):
    # Stack: [arg, old_fp, return_addr]
    # FP points to old_fp, so arg is at FP-1
    OP_LOAD_FP, -1,       # 9: Load n from FP-1
    OP_PUSH, 1,           # 10: PUSH 1
    OP_LE,                # 11: n <= 1?
    OP_JUMP_IF_FALSE, 22, 0, 0, 0,  # 12-16: If false, jump to recursive case
    
    # Base case (offset 19):
    OP_PUSH, 1,           # 19: Return 1
    OP_RETURN,            # 21: RETURN
    
    # Recursive case (offset 22):
    OP_LOAD_FP, -1,       # 22: Load n from FP-1
    OP_PUSH, 1,           # 23: PUSH 1
    OP_SUB,               # 24: n - 1
    OP_CALL, 9, 0, 0, 0,  # 25-29: CALL factorial(n-1)
    OP_LOAD_FP, -1,       # 30: Load n again from FP-1
    OP_MUL,               # 31: n * factorial(n-1)
    OP_RETURN             # 32: RETURN result
  ]
  $ constants = [5, 1]
  $ result = exec(code, constants)
  
  if result == 120 {
    print("✅ test_recursive_factorial: 5! = 120 (TRUE RECURSION!)")
    > true
  }
  print("❌ test_recursive_factorial: expected 120, got ")
  print(result)
  > false
}

# ─── v0.9.7 Tests: Object & Array Opcodes ────────────────────────────

! test_build_array() -> bool {
  # Build array [10, 20, 30], verify ref is -2000000
  $ code = [
    OP_PUSH, 0,         # push 10
    OP_PUSH, 1,         # push 20
    OP_PUSH, 2,         # push 30
    OP_BUILD_ARRAY, 3,  # build array of 3 elements
    OP_HALT
  ]
  $ constants = [10, 20, 30]
  $ result = exec(code, constants)
  if result == 0 - HEAP_BASE {
    print("✅ test_build_array: [10,20,30] -> ref ok")
    > true
  }
  print("❌ test_build_array: expected -2000000, got ")
  print(result)
  > false
}

! test_build_object() -> bool {
  # Build object {42: 100, 43: 200}, verify ref is -2000000
  # Stack order: push key, push val for each field (last field pushed first popped)
  $ code = [
    OP_PUSH, 0,          # key1 = 42
    OP_PUSH, 1,          # val1 = 100
    OP_PUSH, 2,          # key2 = 43
    OP_PUSH, 3,          # val2 = 200
    OP_BUILD_OBJECT, 2,  # 2 fields
    OP_HALT
  ]
  $ constants = [42, 100, 43, 200]
  $ result = exec(code, constants)
  if result == 0 - HEAP_BASE {
    print("✅ test_build_object: {42:100, 43:200} -> ref ok")
    > true
  }
  print("❌ test_build_object: expected -2000000, got ")
  print(result)
  > false
}

! test_get_field() -> bool {
  # Build object {42: 100}, then get field 42 -> should return 100
  $ code = [
    OP_PUSH, 0,          # key = 42
    OP_PUSH, 1,          # val = 100
    OP_BUILD_OBJECT, 1,  # 1 field -> ref on stack
    OP_PUSH, 0,          # push key to look up (42)
    OP_GET_FIELD,        # look up key 42 in object -> 100
    OP_HALT
  ]
  $ constants = [42, 100]
  $ result = exec(code, constants)
  if result == 100 {
    print("✅ test_get_field: obj[42] = 100")
    > true
  }
  print("❌ test_get_field: expected 100, got ")
  print(result)
  > false
}

! test_set_field() -> bool {
  # Build object {42: 100}, set field 42 to 200, get field 42 -> 200
  $ code = [
    OP_PUSH, 0,          # key = 42
    OP_PUSH, 1,          # val = 100
    OP_BUILD_OBJECT, 1,  # 1 field -> ref on stack
    # SET_FIELD: stack needs [obj, key, value]
    OP_PUSH, 0,          # push key (42)
    OP_PUSH, 2,          # push new value (200)
    OP_SET_FIELD,        # pops val, key, obj; pushes obj
    # GET_FIELD to verify
    OP_PUSH, 0,          # push key (42)
    OP_GET_FIELD,        # look up -> 200
    OP_HALT
  ]
  $ constants = [42, 100, 200]
  $ result = exec(code, constants)
  if result == 200 {
    print("✅ test_set_field: obj[42] = 100 -> set 200 -> get 200")
    > true
  }
  print("❌ test_set_field: expected 200, got ")
  print(result)
  > false
}

! test_def_func() -> bool {
  # Define a function (skip body), then push 42 and halt
  # Format: OP_DEF_FUNC, name_idx(1), param_count(1), body_length(1), param_names..., body...
  $ code = [
    OP_DEF_FUNC, 0, 1, 3,  # name_idx=0, params=1, body_len=3
    # param name idx (1 byte per param):
    0,                       # param 0 name idx
    # body (3 bytes):
    OP_PUSH, 0,
    OP_RETURN,
    # After function def, execution continues here:
    OP_PUSH, 1,              # push 42
    OP_HALT
  ]
  $ constants = [5, 42]
  $ result = exec(code, constants)
  if result == 42 {
    print("✅ test_def_func: skips body, continues to push 42")
    > true
  }
  print("❌ test_def_func: expected 42, got ")
  print(result)
  > false
}

# ─── v0.9.8 Tests: Index Operations ──────────────────────────────────

! test_get_index() -> bool {
  # Build array [10, 20, 30], get index 1 -> should return 20
  $ code = [
    OP_PUSH, 0,         # push 10
    OP_PUSH, 1,         # push 20
    OP_PUSH, 2,         # push 30
    OP_BUILD_ARRAY, 3,  # build array [10, 20, 30]
    OP_PUSH, 3,         # push index 1
    OP_GET_INDEX,       # get arr[1] = 20
    OP_HALT
  ]
  $ constants = [10, 20, 30, 1]
  $ result = exec(code, constants)
  if result == 20 {
    print("✅ test_get_index: arr[1] = 20")
    > true
  }
  print("❌ test_get_index: expected 20, got ")
  print(result)
  > false
}

! test_set_index() -> bool {
  # Build array [10, 20, 30], set index 1 to 99, get index 1 -> 99
  $ code = [
    OP_PUSH, 0,         # push 10
    OP_PUSH, 1,         # push 20
    OP_PUSH, 2,         # push 30
    OP_BUILD_ARRAY, 3,  # build array [10, 20, 30]
    # SET_INDEX: stack needs [arr, index, value]
    OP_PUSH, 3,         # push index 1
    OP_PUSH, 4,         # push value 99
    OP_SET_INDEX,       # arr[1] = 99
    # GET_INDEX to verify
    OP_PUSH, 3,         # push index 1
    OP_GET_INDEX,       # get arr[1] = 99
    OP_HALT
  ]
  $ constants = [10, 20, 30, 1, 99]
  $ result = exec(code, constants)
  if result == 99 {
    print("✅ test_set_index: arr[1] = 20 -> set 99 -> get 99")
    > true
  }
  print("❌ test_set_index: expected 99, got ")
  print(result)
  > false
}

@ command run {
  print("=== Bootstrap VM Tests v0.9.8 ===")
  print("")
  
  $ passed = 0
  
  # Original tests
  if test_simple() { $ passed = passed + 1 }
  if test_arithmetic() { $ passed = passed + 1 }
  if test_comparison() { $ passed = passed + 1 }
  if test_conditional() { $ passed = passed + 1 }
  if test_logic() { $ passed = passed + 1 }
  if test_or() { $ passed = passed + 1 }
  if test_load_var() { $ passed = passed + 1 }
  if test_loop() { $ passed = passed + 1 }
  if test_factorial() { $ passed = passed + 1 }
  if test_simple_call_return() { $ passed = passed + 1 }
  if test_recursive_factorial() { $ passed = passed + 1 }
  
  # v0.9.7 tests
  if test_build_array() { $ passed = passed + 1 }
  if test_build_object() { $ passed = passed + 1 }
  if test_get_field() { $ passed = passed + 1 }
  if test_set_field() { $ passed = passed + 1 }
  if test_def_func() { $ passed = passed + 1 }
  
  # v0.9.8 tests
  if test_get_index() { $ passed = passed + 1 }
  if test_set_index() { $ passed = passed + 1 }
  
  print("")
  print("Results: ")
  print(passed)
  print("/18 passed")
  
  if passed == 18 {
    print("🎉🎉🎉 ALL 18 TESTS PASSED! v0.9.8 Index Operations complete! 🎉🎉🎉")
  }
  
  > { ok: true }
}
