# bootstrap/vm.glyph
# Self-hosted VM for GlyphLang bytecode execution.
# This is the "body" that frees GlyphLang from Go dependency.

# ─── Opcodes (Matching pkg/vm/vm.go) ─────────────────────────────────

const OP_PUSH          = 1    # 0x01
const OpPop           = 2    # 0x02
const OpDup           = 3    # Duplicate top of stack (helper for loops)
const OpAdd           = 16   # 0x10
const OpSub           = 17   # 0x11
const OpMul           = 18   # 0x12
const OpDiv           = 19   # 0x13
const OpMod           = 20   # 0x14
const OpEq            = 32   # 0x20
const OpNe            = 33   # 0x21
const OpLt            = 34   # 0x22
const OpGt            = 35   # 0x23
const OpGe            = 36   # 0x24
const OpLe            = 37   # 0x25
const OpAnd           = 38   # 0x26
const OpOr            = 39   # 0x27
const OpNot           = 40   # 0x28
const OpNeg           = 41   # 0x29
const OpLoadVar      = 64   # 0x40
const OpStoreVar     = 65   # 0x41
const OpJump          = 80   # 0x50
const OpJumpIfFalse = 81   # 0x51
const OpJumpIfTrue  = 82   # 0x52
const OpReturn        = 97   # 0x61
const OpCall          = 98   # 0x62
const OpBuildObject  = 112  # 0x70
const OpGetField     = 113  # 0x71
const OpSetField     = 114  # 0x72
const OpDefFunc      = 115  # 0x73
const OpBuildArray   = 128  # 0x80
const OpHalt          = 255  # 0xFF

# ─── VM State ─────────────────────────────

: VM {
  stack: [int]!
  pc: int!
  halted: bool!
  locals: [int]!
}

: PopResult {
  vm: VM!
  val: int!
}

: StepResult {
  vm: VM!
}

# ─── VM Construction ────────────────────────────────────

! new_vm() -> VM {
  > { stack: [], pc: 0, halted: false, locals: [] }
}

# ─── Stack Operations ───────────────────────────────

! vm_push(vm: VM, val: int) -> VM {
  $ new_stack = vm.stack + [val]
  $ new_pc = vm.pc
  $ new_halted = vm.halted
  > { stack: new_stack, pc: new_pc, halted: new_halted, locals: vm.locals }
}

! vm_pop(vm: VM) -> PopResult {
  $ len = length(vm.stack)
  if len == 0 {
    print("Stack underflow!")
    > { vm: vm_halted(vm), val: 0 }
  $ val = vm.stack[len - 1]
  $ new_stack = slice(vm.stack, 0, len - 1)
  > { vm: vm_with_stack(vm, new_stack), val: val }
}

# ─── Local Variable Helpers (simple immutable design) ─

! locals_get(locals: [int], idx: int) -> int {
  if idx < length(locals) {
    > locals[idx]
  }
  > 0  # Default value for uninitialized locals
}

! locals_set(locals: [int], idx: int, val: int) -> [int] {
  # Extend array if needed
  $ result = locals
  while length(result) <= idx {
    $ result = result + [0]
  }
  # Set value at index (create new array with updated value)
  $ new_arr = []
  $ i = 0
  while i < length(result) {
    if i == idx {
      $ new_arr = new_arr + [val]
    } else {
      $ new_arr = new_arr + [result[i]]
    }
    $ i = i + 1
  }
  > new_arr
}

# ─── Stack Operations─────────────────────────────────

! vm_push(vm: VM, val: int) -> VM {
  > { stack: vm.stack + [val], pc: vm.pc, halted: vm.halted, locals: vm.locals }
}

! vm_pop(vm: VM) -> PopResult {
  $ len = length(vm.stack)
  if len == 0 {
    print("Stack underflow!")
    > { vm: vm_halted(vm), val: 0 }
  $ val = vm.stack[len - 1]
  $ new_stack = slice(vm.stack, 0, len - 1)
  > { vm: vm_with_stack(vm, new_stack), val: val }
}

# ─── Local Variable Helpers (simple immutable design)─

! locals_get(locals: [int], idx: int) -> int {
  if idx < length(locals) {
    > locals[idx]
  }
  > 0  # Default value for uninitialized locals
}

! locals_set(locals: [int], idx: int, val: int) -> [int] {
  # Extend array if needed
  $ result = locals
  while length(result) <= idx {
    $ result = result + [0]
  }
  # Set value at index (create new array with updated value)
  $ new_arr = []
  $ i = 0
  while i < length(result) {
    if i == idx {
      $ new_arr = new_arr + [val]
    } else {
      $ new_arr = new_arr + [result[i]]
    }
    $ i = i + 1
  }
  > new_arr
}

# ─── Helper: Read 4-byte address ────────────────────────────────

! read_addr(code: [int], pc: int) -> int {
  $ b0 = code[pc]
  $ b1 = code[pc + 1]
  $ b2 = code[pc + 2]
  $ b3 = code[pc + 3]
  > b0 + b1*256 + b2*65536 + b3* 16777216
  > b0 + b1*256 + b2*65536 + b3* 16777216
}

# ─── Helper: Comparison functions ─────────────────────────────

! compare_eq(a: int, b: int) -> int {
  if a == b { > 1 }
  > 0
}

! compare_ne(a: int, b: int) -> int {
  if a != b { > 1 }
  > 0
}

! compare_lt(a: int, b: int) -> int {
  if a < b { > 1 }
  > 0
}

! compare_gt(a: int, b: int) -> int {
  if a > b { > 1 }
  > 0
}

! compare_ge(a: int, b: int) -> int {
  if a >= b { > 1 }
  > 0
}

! compare_le(a: int, b: int) -> int {
  if a <= b { > 1 }
  > 0
}

! logic_not(a: int) -> int {
  if a == 0 { > 1 }
  > 0
}

! logic_and(a: int, b: int) -> int {
  if a != 0 && b != 0 { > 1 }
  > 0
}

! logic_or(a: int, b: int) -> int {
  if a != 0 || b != 0 { > 1 }
  > 0
}

! jump_if_false(cond: int, target: int, fallthrough: int) -> int {
  if cond == 0 { > target }
  > fallthrough
}

! jump_if_true(cond: int, target: int, fallthrough: int) -> int {
  if cond != 0 { > target }
  > fallthrough
}

# ─── Execution ─────────────────────────────────────

! vm_exec(vm: VM, code: [int], constants: [int]) -> int {
  $ current = vm
  while !current.halted && current.pc < length(code) {
    $ op = code[current.pc]
    $ result = vm_step(current, op, code, constants)
    $ current = result.vm
  }
  $ final = vm_pop(current)
  > final.val
}

! vm_step(vm: VM, op: int, code: [int], constants: [int]) -> StepResult {
  # Stack operations
  if op == OP_PUSH {
    $ idx = code[vm.pc + 1]
    $ vm2 = vm_push(vm, constants[idx])
    $ vm3 = vm_with_pc(vm2, vm.pc + 2)
    > { vm: vm3 }
  }
  
  if op == OP_POP {
    $ result = vm_pop(vm)
    $ vm2 = vm_with_pc(result.vm, vm.pc + 1)
    > { vm: vm2 }
  }
  
  if op == OP_DUP {
    # Duplicate top of stack
    $ result = vm_pop(vm)
    $ vm2 = vm_push(result.vm, result.val)
    $ vm3 = vm_push(vm2, result.val)
    $ vm4 = vm_with_pc(vm3, vm.pc + 1)
    > { vm: vm4 }
  }
  
  # Arithmetic
  if op == OP_ADD {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val + rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_SUB {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val - rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_MUL {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val * rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_DIV {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    if rb.val == 0 {
      print("Division by zero!")
      > { vm: vm_halted(vm) }
    }
    $ vm2 = vm_push(ra.vm, ra.val / rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_MOD {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ vm2 = vm_push(ra.vm, ra.val % rb.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # Comparison
  if op == OP_EQ {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_eq(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_NE {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_ne(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_LT {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_lt(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_GT {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_gt(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_GE {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_ge(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_LE {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = compare_le(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # Logic
  if op == OP_AND {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = logic_and(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_OR {
    $ rb = vm_pop(vm)
    $ ra = vm_pop(rb.vm)
    $ result = logic_or(ra.val, rb.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_NOT {
    $ ra = vm_pop(vm)
    $ result = logic_not(ra.val)
    $ vm2 = vm_push(ra.vm, result)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  if op == OP_NEG {
    $ ra = vm_pop(vm)
    $ vm2 = vm_push(ra.vm, 0 - ra.val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 1)
    > { vm: vm3 }
  }
  
  # Variables
  if op == OP_LOAD_VAR {
    $ idx = code[vm.pc + 1]
    $ val = locals_get(vm.locals, idx)
    $ vm2 = vm_push(vm, val)
    $ vm3 = vm_with_pc(vm2, vm.pc + 2)
    > { vm: vm3 }
  }
  
  if op == OP_STORE_VAR {
    $ idx = code[vm.pc + 1]
    $ result = vm_pop(vm)
    $ new_locals = locals_set(result.vm.locals, idx, result.val)
    $ vm2 = vm_with_locals(result.vm, new_locals)
    $ vm3 = vm_with_pc(vm2, vm.pc + 2)
    > { vm: vm3 }
  }
  
  # Control flow
  if op == OP_JUMP {
    $ target = read_addr(code, vm.pc + 1)
    $ vm2 = vm_with_pc(vm, target)
    > { vm: vm2 }
  }
  
  if op == OP_JUMP_IF_FALSE {
    $ target = read_addr(code, vm.pc + 1)
    $ cond = vm_pop(vm)
    $ new_pc = jump_if_false(cond.val, target, vm.pc + 5)
    $ vm2 = vm_with_pc(cond.vm, new_pc)
    > { vm: vm2 }
  }
  
  if op == OP_JUMP_IF_TRUE {
    $ target = read_addr(code, vm.pc + 1)
    $ cond = vm_pop(vm)
    $ new_pc = jump_if_true(cond.val, target, vm.pc + 5)
    $ vm2 = vm_with_pc(cond.vm, new_pc)
    > { vm: vm2 }
  }
  
  if op == OP_RETURN || op == OP_HALT {
    > { vm: vm_halted(vm) }
  }
  
  print("Unknown opcode!")
  > { vm: vm_halted(vm) }
}

# ─── Entry Point ─────────────────────────────────────────────

! exec(code: [int], constants: [int]) -> int {
  $ vm = new_vm()
  > vm_exec(vm, code, constants)
}

# ─── Tests ───────────────────────────────────────────────────

! test_simple() -> bool {
  $ code = [OP_PUSH, 0, OP_HALT]
  $ constants = [42]
  $ result = exec(code, constants)
  if result == 42 {
    print("✅ test_simple: 42")
    > true
  }
  print("❌ test_simple: expected 42")
  > false
}

