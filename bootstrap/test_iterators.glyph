# bootstrap/test_iterators.glyph
# v0.10.0 Iterator tests: OP_GET_ITER, OP_ITER_HAS_NEXT, OP_ITER_NEXT
import "./vm"

@ command run {
    print("=== Iterator Tests ===")
    $ passed = 0
    $ total = 0

    # Test 1: Iterate array [10, 20], get first element
    $ total = total + 1
    print("Test 1: get first element of [10, 20]")
    # read_addr is little-endian: LSB first
    $ code1 = [
        OP_PUSH, 0,0,0,0,            # push constants[0]=10
        OP_PUSH, 1,0,0,0,            # push constants[1]=20
        OP_BUILD_ARRAY, 2,0,0,0,     # array of 2
        OP_GET_ITER,                 # iter ref
        OP_DUP,                      # dup iter
        OP_ITER_NEXT, 0,             # first value (no key)
        OP_HALT
    ]
    $ r1 = vm.exec(code1, [10, 20])
    if r1 == 10 {
        print("  PASS: first = " + toString(r1))
        $ passed = passed + 1
    } else {
        print("  FAIL: expected 10, got " + toString(r1))
    }

    # Test 2: Iterate with key [100, 200], get first index
    $ total = total + 1
    print("Test 2: iterate with key [100, 200], get first index")
    $ code2 = [
        OP_PUSH, 0,0,0,0,
        OP_PUSH, 1,0,0,0,
        OP_BUILD_ARRAY, 2,0,0,0,
        OP_GET_ITER,
        OP_DUP,
        OP_ITER_NEXT, 1,             # push index then value
        OP_POP,                      # discard value
        OP_HALT                      # top = index = 0
    ]
    $ r2 = vm.exec(code2, [100, 200])
    if r2 == 0 {
        print("  PASS: first index = " + toString(r2))
        $ passed = passed + 1
    } else {
        print("  FAIL: expected 0, got " + toString(r2))
    }

    # Test 3: Has_next returns 0 on exhausted iterator
    $ total = total + 1
    print("Test 3: exhausted iterator has_next = 0")
    $ code3 = [
        OP_PUSH, 0,0,0,0,
        OP_BUILD_ARRAY, 1,0,0,0,
        OP_GET_ITER,
        OP_DUP,
        OP_ITER_NEXT, 0,
        OP_POP,
        OP_ITER_HAS_NEXT,
        OP_HALT
    ]
    $ r3 = vm.exec(code3, [42])
    if r3 == 0 {
        print("  PASS: exhausted has_next = " + toString(r3))
        $ passed = passed + 1
    } else {
        print("  FAIL: expected 0, got " + toString(r3))
    }

    # Test 4: Iterate all elements and sum [10, 20] using LOAD/STORE_VAR
    $ total = total + 1
    print("Test 4: sum [10, 20] via full iteration")
    # Constants: [0]=10, [1]=20, [2]=0 (accumulator)
    # Globals: slot 3=acc, slot 4=__iter_0, slot 5=x
    $ code4 = [
        # acc = 0
        OP_PUSH, 2,0,0,0,
        OP_STORE_VAR, 3,0,0,0,
        # Build array [10, 20]
        OP_PUSH, 0,0,0,0,
        OP_PUSH, 1,0,0,0,
        OP_BUILD_ARRAY, 2,0,0,0,
        OP_GET_ITER,
        OP_STORE_VAR, 4,0,0,0,
        # loop start (PC=31)
        OP_LOAD_VAR, 4,0,0,0,
        OP_ITER_HAS_NEXT,
        OP_JUMP_IF_FALSE, 75,0,0,0,
        OP_LOAD_VAR, 4,0,0,0,
        OP_ITER_NEXT, 0,
        OP_STORE_VAR, 5,0,0,0,
        # acc = acc + x
        OP_LOAD_VAR, 3,0,0,0,
        OP_LOAD_VAR, 5,0,0,0,
        OP_ADD,
        OP_STORE_VAR, 3,0,0,0,
        OP_JUMP, 31,0,0,0,
        # end (PC=75)
        OP_LOAD_VAR, 3,0,0,0,
        OP_HALT
    ]
    $ r4 = vm.exec(code4, [10, 20, 0])
    if r4 == 30 {
        print("  PASS: sum = " + toString(r4))
        $ passed = passed + 1
    } else {
        print("  FAIL: expected 30, got " + toString(r4))
    }

    print("")
    print("Iterator: " + toString(passed) + "/" + toString(total))
    if passed == total { print("ALL ITERATOR TESTS PASSED") }
    > {ok: passed == total, passed: passed, total: total}
}
