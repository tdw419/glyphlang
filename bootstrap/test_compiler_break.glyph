import "./parser"
import "./compiler"

! main() {
  print("=== Compiler Break/Continue Test ===")
  $ src = "$ i = 0\n$ total = 0\nwhile i < 10 {\n  $ i = i + 1\n  if i == 5 { continue }\n  if i == 8 { break }\n  $ total = total + i\n}\n> total"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("Parse error: " + pr.error)
    > false
  }
  
  $ c = compiler.new_compiler()
  $ cr = compiler.compile(c, pr.mod)
  if cr.error != "" {
    print("Compile error: " + cr.error)
    > false
  }
  
  $ res = vmExec(cr.bytecode)
  print("Result: " + toString(res))
  
  if res == 23 {
    print("✅ Break/Continue Test PASSED")
    > true
  }
  print("❌ Break/Continue Test FAILED: expected 23, got " + toString(res))
  > false
}

@ command run {
  main()
}
