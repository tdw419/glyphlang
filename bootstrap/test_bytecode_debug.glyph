# bootstrap/test_bytecode_debug.glyph
# Debug: inspect bytecode bytes from bootstrap compiler

import "./parser"
import "./compiler"

@ command run {
    $ src = "$ x = 10 + 5"
    $ p = parser.new_parser(src)
    $ res = parser.parse(p)

    $ c = compiler.new_compiler()
    $ cres = compiler.compile(c, res.mod)

    print("Source: " + src)
    print("Bytecode length: " + toString(length(cres.bytecode)))
    print("Constants count: " + toString(length(c.constants)))
    print("")

    # Print each constant
    $ i = 0
    while i < length(c.constants) {
        print("Constant " + toString(i) + ": " + toString(c.constants[i]) + " (type: " + typeOf(c.constants[i]) + ")")
        i = i + 1
    }
    print("")

    # Print bytecode as hex-like
    print("Bytecode bytes:")
    $ j = 0
    $ line = ""
    while j < length(cres.bytecode) {
        line = line + toString(cres.bytecode[j]) + " "
        if j > 0 && (j + 1) - ((j + 1) / 16) * 16 == 0 {
            print("  " + line)
            line = ""
        }
        j = j + 1
    }
    if line != "" {
        print("  " + line)
    }

    > {ok: true}
}
