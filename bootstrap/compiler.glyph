# bootstrap/compiler.glyph
# Self-hosted compiler for GlyphLang.
# Transforms AST into VM bytecode.

import "./ast"
import "./parser"

# ─── Compiler State ────────────────────────────────────────────────

: Compiler {
  constants: [any]!
  instructions: [int]!
  symbol_table: any!
  scopes: [any]!
  loop_stack: [any]!
  current_scope: int!
  label_counter: int!
  jump_patches: [int]!
}

: CompileResult {
  bytecode: [int]!
  error: str!
}

# ─── Opcodes ──────────────────────────────────────────────────────

const OP_PUSH          = 1
const OP_POP           = 2
const OP_ADD           = 16
const OP_SUB           = 17
const OP_MUL           = 18
const OP_DIV           = 19
const OP_MOD           = 20
const OP_EQ            = 32
const OP_NE            = 33
const OP_LT            = 34
const OP_GT            = 35
const OP_GE            = 36
const OP_LE            = 37
const OP_AND           = 38
const OP_OR            = 39
const OP_NOT           = 40
const OP_NEG           = 41
const OP_LOAD_VAR      = 64
const OP_STORE_VAR     = 65
const OP_JUMP          = 80
const OP_JUMP_IF_FALSE = 81
const OP_GET_ITER      = 83
const OP_ITER_NEXT     = 84
const OP_ITER_HAS_NEXT = 85
const OP_GET_INDEX     = 86
const OP_SET_INDEX     = 87
const OP_RETURN        = 97
const OP_CALL          = 98
const OP_BUILD_OBJECT  = 112
const OP_GET_FIELD     = 113
const OP_SET_FIELD     = 114
const OP_DEF_FUNC      = 115
const OP_BUILD_ARRAY   = 128
const OP_MITOSIS       = 192  # 0xC0
const OP_MUTATOR       = 193  # 0xC1
const OP_HALT          = 255

# ─── Compiler Construction ────────────────────────────────────────

! new_compiler() -> Compiler {
  > {
    constants: [],
    instructions: [],
    symbol_table: {},
    scopes: [{}],
    current_scope: 0,
    label_counter: 0,
    jump_patches: [],
    loop_stack: []
  }
}

# ─── Bytecode header emission ─────────────────────────────────────


# resolve_import_path computes the full file path and new base directory
# for an import relative to the current base_path.
! resolve_import_path(raw_path: str, base_path: str) -> any {
  # Strip leading "./" from raw_path
  $ clean = raw_path
  if startsWith(raw_path, "./") {
    $ clean = substring(raw_path, 2, length(raw_path))
  }
  $ resolved = base_path + clean + ".glyph"
  # new_base = directory portion of resolved file
  $ new_base = base_path
  $ last_slash = 0
  $ j = length(resolved) - 1
  while j >= 0 {
    if substring(resolved, j, j + 1) == "/" {
      $ last_slash = j + 1
      $ j = -1
    }
    $ j = j - 1
  }
  if last_slash > 0 {
    $ new_base = substring(resolved, 0, last_slash)
  }
  > { file_path: resolved, new_base: new_base }
}

! has_key(obj: any, key: str) -> bool {
  $ ks = keys(obj)
  $ i = 0
  while i < length(ks) {
    if ks[i] == key { > true }
    $ i = i + 1
  }
  > false
}

! compile_module(c: Compiler, mod: any, base_path: str, visited: any) -> str {
  if visited == null {
    $ visited = {}
  }
  $ items = mod.items
  $ i = 0
  while i < length(items) {
    $ item = items[i]

    if item.kind == "import" {
      $ rp = resolve_import_path(item.import_path, base_path)
      $ resolved_path = rp.file_path
      $ new_base = rp.new_base
      if has_key(visited, resolved_path) {
        # Skip circular imports
        $ i = i + 1
        continue
      }
      $ visited[resolved_path] = true
      $ src = readFile(resolved_path)
      if length(src) == 0 {
        > "import not found: " + resolved_path
      }
      $ ip = parser.new_parser(src)
      $ ipr = parser.parse(ip)
      if ipr.error != "" {
        > "import parse error (" + resolved_path + "): " + ipr.error
      }
      $ err = compile_module(c, ipr.mod, new_base, visited)
      if err != "" { > err }
    } else {
      $ err = compile_item(c, item)
      if err != "" { > err }
    }
    i = i + 1
  }
  > ""
}

! compile(c: Compiler, mod: ast.Module, base_path: str) -> CompileResult {
  if base_path == null { $ base_path = "./" }
  $ err = compile_module(c, mod, base_path, null)
  if err != "" { > { bytecode: [], error: err } }

  emit_byte(c, OP_HALT)

  $ header = build_header(c)
  $ hlen = length(header)
  
  # Finalize all jump targets with header offset
  $ ji = 0
  while ji < length(c.jump_patches) {
    $ pos = c.jump_patches[ji]
    # Read current target (little-endian uint32)
    $ b0 = c.instructions[pos]
    $ b1 = c.instructions[pos+1]
    $ b2 = c.instructions[pos+2]
    $ b3 = c.instructions[pos+3]
    $ target = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    
    $ new_target = target + hlen
    $ nb = intToBytes4(new_target)
    $ c.instructions[pos] = nb[0]
    $ c.instructions[pos+1] = nb[1]
    $ c.instructions[pos+2] = nb[2]
    $ c.instructions[pos+3] = nb[3]
    $ ji = ji + 1
  }

  > { bytecode: header + c.instructions, error: "" }
}

! build_header(c: Compiler) -> [int] {
  $ bytes = [71, 76, 89, 80, 1, 0, 0, 0]
  $ cnt = length(c.constants)
  bytes = bytes + intToBytes4(cnt)

  $ i = 0
  while i < cnt {
    $ val = c.constants[i]
    bytes = bytes + encode_constant(val)
    i = i + 1
  }

  $ inst_cnt = length(c.instructions)
  bytes = bytes + intToBytes4(inst_cnt)

  > bytes
}

! encode_constant(val: any) -> [int] {
  if val == null { > [0] }

  $ t = typeOf(val)

  if t == "str" {
    $ s = toString(val)
    $ data = [4] + intToBytes4(length(s))
    $ j = 0
    while j < length(s) {
      data = data + [charAtCode(s, j)]
      j = j + 1
    }
    > data
  }

  if t == "object" {
    $ kind = val["kind"]
    if kind == "literal" {
      $ lit_type = val["type"]
      $ lit_val = val["value"]
      if lit_type == "int" {
        > [1] + encode_int(toInt(lit_val))
      }
      if lit_type == "bool" {
        if lit_val == "true" || lit_val == true { > [3, 1] }
        > [3, 0]
      }
      if lit_type == "str" {
        $ s = toString(lit_val)
        $ data = [4] + intToBytes4(length(s))
        $ j = 0
        while j < length(s) {
          data = data + [charAtCode(s, j)]
          j = j + 1
        }
        > data
      }
      if lit_type == "null" { > [0] }
      # Fallback: encode as string
      $ fs = toString(lit_val)
      $ fd = [4] + intToBytes4(length(fs))
      $ fj = 0
      while fj < length(fs) {
        fd = fd + [charAtCode(fs, fj)]
        fj = fj + 1
      }
      > fd
    }
    if kind == "name" {
      $ name_val = val["value"]
      $ s = toString(name_val)
      $ data = [4] + intToBytes4(length(s))
      $ j = 0
      while j < length(s) {
        data = data + [charAtCode(s, j)]
        j = j + 1
      }
      > data
    }
    if kind == "const_name" {
      $ name_val = val["value"]
      $ s = toString(name_val)
      $ data = [4] + intToBytes4(length(s))
      $ j = 0
      while j < length(s) {
        data = data + [charAtCode(s, j)]
        j = j + 1
      }
      > data
    }
  }

  if t == "int" {
    > [1] + encode_int(val)
  }

  if t == "bool" {
    if val { > [3, 1] }
    > [3, 0]
  }

  > [0]
}

! encode_int(n: int) -> [int] {
  > [
    n - (n / 256) * 256,
    (n / 256) - (n / 65536) * 256,
    (n / 65536) - (n / 16777216) * 256,
    (n / 16777216) - (n / 4294967296) * 256,
    (n / 4294967296) - (n / 1099511627776) * 256,
    (n / 1099511627776) - (n / 281474976710656) * 256,
    (n / 281474976710656) - (n / 72057594037927936) * 256,
    n / 72057594037927936
  ]
}

# ─── Emission Helpers ─────────────────────────────────────────────

! emit_byte(c: Compiler, b: int) {
  $ c.instructions = c.instructions + [b]
}

! emit_bytes4(c: Compiler, n: int) {
  $ c.instructions = c.instructions + intToBytes4(n)
}

! emit_jump(c: Compiler, op: int) -> int {
  emit_byte(c, op)
  $ pos = length(c.instructions)
  emit_bytes4(c, 0)
  $ c.jump_patches = c.jump_patches + [pos]
  > pos
}

! patch_jump(c: Compiler, pos: int) {
  $ target = length(c.instructions)
  $ b = intToBytes4(target)
  $ c.instructions[pos] = b[0]
  $ c.instructions[pos + 1] = b[1]
  $ c.instructions[pos + 2] = b[2]
  $ c.instructions[pos + 3] = b[3]
}

! add_constant(c: Compiler, val: any) -> int {
  $ i = 0
  while i < length(c.constants) {
    if c.constants[i] == val { > i }
    i = i + 1
  }
  $ c.constants = c.constants + [val]
  > length(c.constants) - 1
}

! compile_item(c: Compiler, item: ast.Item) -> str {
  if item.kind == "const" {
    $ err = compile_expression(c, item.const_value)
    if err != "" { > err }
    # Add variable name to constants directly
    $ c.constants = c.constants + [item.const_name]
    $ idx = length(c.constants) - 1
    emit_byte(c, OP_STORE_VAR)
    emit_bytes4(c, idx)
    > ""
  }

  if item.kind == "var_decl" {
    # Top-level variable declaration
    $ err = compile_expression(c, item.var_value)
    if err != "" { > err }
    $ idx = add_constant(c, item.var_name)
    emit_byte(c, OP_STORE_VAR)
    emit_bytes4(c, idx)
    > ""
  }

  if item.kind == "function" {
    # Emit OP_DEF_FUNC: name_idx(4), param_count(4), body_length(4), [param_name_idx(4)]...
    $ name_idx = add_constant(c, item.func_name)
    emit_byte(c, OP_DEF_FUNC)
    emit_bytes4(c, name_idx)
    emit_bytes4(c, length(item.func_params))
    # Placeholder for body length — will be patched
    $ body_len_pos = length(c.instructions)
    emit_bytes4(c, 0)
    # Emit parameter name constant indices
    $ pi = 0
    while pi < length(item.func_params) {
      $ param = item.func_params[pi]
      $ pidx = add_constant(c, param.name)
      emit_bytes4(c, pidx)
      pi = pi + 1
    }
    # Compile function body
    $ body_start = length(c.instructions)
    $ bi = 0
    while bi < length(item.func_body) {
      $ serr = compile_statement(c, item.func_body[bi])
      if serr != "" { > serr }
      bi = bi + 1
    }
    # Ensure function ends with a return (push null + return if not explicit)
    emit_byte(c, OP_PUSH)
    $ null_idx = add_constant(c, null)
    emit_bytes4(c, null_idx)
    emit_byte(c, OP_RETURN)
    # Patch body length
    $ body_len = length(c.instructions) - body_start
    $ bl = intToBytes4(body_len)
    $ c.instructions[body_len_pos] = bl[0]
    $ c.instructions[body_len_pos + 1] = bl[1]
    $ c.instructions[body_len_pos + 2] = bl[2]
    $ c.instructions[body_len_pos + 3] = bl[3]
    > ""
  }

  if item.kind == "command" {
    # Commands compile identically to functions using OP_DEF_FUNC.
    # This allows command dispatch via normal function call by name.
    $ name_idx = add_constant(c, item.command_name)
    emit_byte(c, OP_DEF_FUNC)
    emit_bytes4(c, name_idx)
    emit_bytes4(c, length(item.command_params))
    # Placeholder for body length
    $ body_len_pos = length(c.instructions)
    emit_bytes4(c, 0)
    # Emit parameter name constant indices
    $ pi = 0
    while pi < length(item.command_params) {
      $ param = item.command_params[pi]
      $ pidx = add_constant(c, param.name)
      emit_bytes4(c, pidx)
      pi = pi + 1
    }
    # Compile command body
    $ body_start = length(c.instructions)
    $ bi = 0
    while bi < length(item.command_body) {
      $ serr = compile_statement(c, item.command_body[bi])
      if serr != "" { > serr }
      bi = bi + 1
    }
    # Ensure command ends with a return
    emit_byte(c, OP_PUSH)
    $ null_idx = add_constant(c, null)
    emit_bytes4(c, null_idx)
    emit_byte(c, OP_RETURN)
    # Patch body length
    $ body_len = length(c.instructions) - body_start
    $ bl = intToBytes4(body_len)
    $ c.instructions[body_len_pos] = bl[0]
    $ c.instructions[body_len_pos + 1] = bl[1]
    $ c.instructions[body_len_pos + 2] = bl[2]
    $ c.instructions[body_len_pos + 3] = bl[3]
    > ""
  }

  if item.kind == "type_def" { > "" }
  if item.kind == "import" { > "" }
  if item.kind == "from_import" { > "" }

  # Try compiling as a statement for top-level script-like code
  if item.kind == "for_in" || item.kind == "if" || item.kind == "while" || item.kind == "assign" || item.kind == "expression" || item.kind == "return" {
    > compile_statement(c, item)
  }

  > ""
}

# ─── Statement Compilation ────────────────────────────────────────

! compile_statement(c: Compiler, stmt: ast.Statement) -> str {
  if stmt.kind == "function" {
    > compile_item(c, stmt)
  }

  if stmt.kind == "assign" {
    $ err = compile_expression(c, stmt.value)
    if err != "" { > err }
    $ idx = add_constant(c, stmt.target)
    emit_byte(c, OP_STORE_VAR)
    emit_bytes4(c, idx)
    > ""
  }

  if stmt.kind == "return" {
    $ err = compile_expression(c, stmt.return_value)
    if err != "" { > err }
    emit_byte(c, OP_RETURN)
    > ""
  }

  if stmt.kind == "if" {
    $ err = compile_expression(c, stmt.condition)
    if err != "" { > err }
    $ jump_false_pos = emit_jump(c, OP_JUMP_IF_FALSE)

    $ i = 0
    while i < length(stmt.then_block) {
      $ serr = compile_statement(c, stmt.then_block[i])
      if serr != "" { > serr }
      i = i + 1
    }

    if length(stmt.else_block) > 0 {
      $ jump_end_pos = emit_jump(c, OP_JUMP)
      patch_jump(c, jump_false_pos)
      $ j = 0
      while j < length(stmt.else_block) {
        $ serr2 = compile_statement(c, stmt.else_block[j])
        if serr2 != "" { > serr2 }
        j = j + 1
      }
      patch_jump(c, jump_end_pos)
    } else {
      patch_jump(c, jump_false_pos)
    }
    > ""
  }

  if stmt.kind == "while" {
    $ start_pos = length(c.instructions)
    
    # Push loop context for break/continue
    $ loop_ctx = { start_pos: start_pos, break_jumps: [] }
    $ c.loop_stack = c.loop_stack + [loop_ctx]

    $ err = compile_expression(c, stmt.while_condition)
    if err != "" { > err }
    $ jump_false_pos = emit_jump(c, OP_JUMP_IF_FALSE)

    $ i = 0
    while i < length(stmt.body) {
      $ serr = compile_statement(c, stmt.body[i])
      if serr != "" { > serr }
      i = i + 1
    }

    $ loop_jump = emit_jump(c, OP_JUMP)
    # target is relative to instructions start, will be offset in compile()
    $ b = intToBytes4(start_pos)
    $ c.instructions[loop_jump] = b[0]
    $ c.instructions[loop_jump + 1] = b[1]
    $ c.instructions[loop_jump + 2] = b[2]
    $ c.instructions[loop_jump + 3] = b[3]

    patch_jump(c, jump_false_pos)
    
    # Patch all break jumps to the end of the loop
    $ bj = loop_ctx.break_jumps
    $ j = 0
    while j < length(bj) {
      patch_jump(c, bj[j])
      j = j + 1
    }
    
    # Pop loop context
    $ ns = []
    $ si = 0
    while si < length(c.loop_stack) - 1 {
      ns = ns + [c.loop_stack[si]]
      si = si + 1
    }
    $ c.loop_stack = ns
    
    > ""
  }

  if stmt.kind == "field_assign" {
    # obj.field = value → push obj, push field name, push value, SET_FIELD
    $ err1 = compile_expression(c, stmt.obj_expr)
    if err1 != "" { > err1 }
    $ fidx = add_constant(c, stmt.field)
    emit_byte(c, OP_PUSH)
    emit_bytes4(c, fidx)
    $ err2 = compile_expression(c, stmt.value)
    if err2 != "" { > err2 }
    emit_byte(c, OP_SET_FIELD)
    emit_byte(c, OP_POP)
    > ""
  }

  if stmt.kind == "index_assign" {
    # Handle compound field+index: obj.field[idx] = value
    if stmt.field != "" {
      # Load obj, get field, then set index
      $ var_idx = add_constant(c, stmt.target)
      emit_byte(c, OP_LOAD_VAR)
      emit_bytes4(c, var_idx)
      $ fld_idx = add_constant(c, stmt.field)
      emit_byte(c, OP_PUSH)
      emit_bytes4(c, fld_idx)
      emit_byte(c, OP_GET_FIELD)
    } else {
      # Simple: arr[idx] = value
      $ var_idx = add_constant(c, stmt.target)
      emit_byte(c, OP_LOAD_VAR)
      emit_bytes4(c, var_idx)
    }
    $ err2 = compile_expression(c, stmt.index_expr)
    if err2 != "" { > err2 }
    $ err3 = compile_expression(c, stmt.value)
    if err3 != "" { > err3 }
    emit_byte(c, OP_SET_INDEX)
    emit_byte(c, OP_POP)
    > ""
  }

  if stmt.kind == "expression" {
    $ err = compile_expression(c, stmt.expr)
    if err != "" { > err }
    emit_byte(c, OP_POP)
    > ""
  }

  if stmt.kind == "break" {
    if length(c.loop_stack) == 0 { > "break outside of loop" }
    $ top_idx = length(c.loop_stack) - 1
    $ loop_ctx = c.loop_stack[top_idx]
    $ jump_pos = emit_jump(c, OP_JUMP)
    $ loop_ctx.break_jumps = loop_ctx.break_jumps + [jump_pos]
    > ""
  }
  if stmt.kind == "continue" {
    if length(c.loop_stack) == 0 { > "continue outside of loop" }
    $ top_idx = length(c.loop_stack) - 1
    $ loop_ctx = c.loop_stack[top_idx]
    $ jump_pos = emit_jump(c, OP_JUMP)
    $ b = intToBytes4(loop_ctx.start_pos)
    $ c.instructions[jump_pos] = b[0]
    $ c.instructions[jump_pos + 1] = b[1]
    $ c.instructions[jump_pos + 2] = b[2]
    $ c.instructions[jump_pos + 3] = b[3]
    > ""
  }

  if stmt.kind == "for_in" {
    # 1. Compile the iterable expression → collection on stack
    $ err = compile_expression(c, stmt.while_condition)
    if err != "" { > err }

    # 2. GET_ITER → iterator ref on stack
    emit_byte(c, OP_GET_ITER)

    # 3. Store iterator in a temp variable (__iter_N)
    $ iter_name = "__iter_" + toString(c.label_counter)
    $ c.label_counter = c.label_counter + 1
    $ iter_idx = add_constant(c, iter_name)
    emit_byte(c, OP_STORE_VAR)
    emit_bytes4(c, iter_idx)

    # 4. Define value variable in constant pool
    $ value_idx = add_constant(c, stmt.target)

    # 5. Define key variable if present
    $ has_key = 0
    $ key_idx = 0
    if stmt.field != "" {
      $ key_idx = add_constant(c, stmt.field)
      $ has_key = 1
    }

    # 6. Loop start
    $ loop_start = length(c.instructions)
    
    # Push loop context for break/continue
    $ loop_ctx = { start_pos: loop_start, break_jumps: [] }
    $ c.loop_stack = c.loop_stack + [loop_ctx]

    # 7. Load iterator, check has_next
    emit_byte(c, OP_LOAD_VAR)
    emit_bytes4(c, iter_idx)
    emit_byte(c, OP_ITER_HAS_NEXT)
    $ jump_end_pos = emit_jump(c, OP_JUMP_IF_FALSE)

    # 8. Load iterator, get next element
    emit_byte(c, OP_LOAD_VAR)
    emit_bytes4(c, iter_idx)
    emit_byte(c, OP_ITER_NEXT)
    emit_bytes4(c, has_key)

    # 9. Store value variable (top of stack)
    emit_byte(c, OP_STORE_VAR)
    emit_bytes4(c, value_idx)

    # 10. Store key variable if present (next on stack)
    if has_key != 0 {
      emit_byte(c, OP_STORE_VAR)
      emit_bytes4(c, key_idx)
    }

    # 11. Compile loop body
    $ i = 0
    while i < length(stmt.body) {
      $ serr = compile_statement(c, stmt.body[i])
      if serr != "" { > serr }
      $ i = i + 1
    }

    # 12. Jump back to loop start
    $ loop_jump = emit_jump(c, OP_JUMP)
    # target is relative to instructions start, will be offset in compile()
    $ b = intToBytes4(loop_start)
    $ c.instructions[loop_jump] = b[0]
    $ c.instructions[loop_jump + 1] = b[1]
    $ c.instructions[loop_jump + 2] = b[2]
    $ c.instructions[loop_jump + 3] = b[3]

    # 13. Patch jump to end
    patch_jump(c, jump_end_pos)
    
    # Patch all break jumps to the end of the loop
    $ bj = loop_ctx.break_jumps
    $ j = 0
    while j < length(bj) {
      patch_jump(c, bj[j])
      j = j + 1
    }
    
    # Pop loop context
    $ ns = []
    $ si = 0
    while si < length(c.loop_stack) - 1 {
      ns = ns + [c.loop_stack[si]]
      si = si + 1
    }
    $ c.loop_stack = ns
    
    > ""
  }

  > ""
}

# ─── Expression Compilation ───────────────────────────────────────

! compile_expression(c: Compiler, expr: ast.Expr) -> str {
  if expr.kind == "literal" {
    $ val = expr.literal_value
    $ boxed = {kind: "literal", type: expr.literal_type, value: val}
    $ idx = add_constant(c, boxed)
    emit_byte(c, OP_PUSH)
    emit_bytes4(c, idx)
    > ""
  }

  if expr.kind == "variable" {
    $ idx = add_constant(c, expr.var_name)
    emit_byte(c, OP_LOAD_VAR)
    emit_bytes4(c, idx)
    > ""
  }

  if expr.kind == "binary" {
    $ err1 = compile_expression(c, expr.left)
    if err1 != "" { > err1 }
    $ err2 = compile_expression(c, expr.right)
    if err2 != "" { > err2 }

    if expr.op == "+" { emit_byte(c, OP_ADD) }
    if expr.op == "-" { emit_byte(c, OP_SUB) }
    if expr.op == "*" { emit_byte(c, OP_MUL) }
    if expr.op == "/" { emit_byte(c, OP_DIV) }
    if expr.op == "%" { emit_byte(c, OP_MOD) }
    if expr.op == "==" { emit_byte(c, OP_EQ) }
    if expr.op == "!=" { emit_byte(c, OP_NE) }
    if expr.op == "<" { emit_byte(c, OP_LT) }
    if expr.op == ">" { emit_byte(c, OP_GT) }
    if expr.op == "<=" { emit_byte(c, OP_LE) }
    if expr.op == ">=" { emit_byte(c, OP_GE) }
    if expr.op == "&&" { emit_byte(c, OP_AND) }
    if expr.op == "||" { emit_byte(c, OP_OR) }
    > ""
  }

  if expr.kind == "unary" {
    $ err = compile_expression(c, expr.operand)
    if err != "" { > err }
    if expr.op == "!" { emit_byte(c, OP_NOT) }
    if expr.op == "-" { emit_byte(c, OP_NEG) }
    > ""
  }

  if expr.kind == "method_call" {
    # Compile the callee expression (e.g. obj.field) -> pushes function object
    $ err = compile_expression(c, expr.object)
    if err != "" { > err }
    # Then push arguments
    $ i = 0
    while i < length(expr.args) {
      $ er = compile_expression(c, expr.args[i])
      if er != "" { > er }
      i = i + 1
    }
    # OP_CALL operand = arg count
    emit_byte(c, OP_CALL)
    emit_bytes4(c, length(expr.args))
    > ""
  }

  if expr.kind == "call" {
    if expr.func_name == "__mitosis" {
      if length(expr.args) < 1 { > "__mitosis expects 1 argument" }
      $ err = compile_expression(c, expr.args[0])
      if err != "" { > err }
      emit_byte(c, OP_MITOSIS)
      > ""
    }
    if expr.func_name == "__mutator" {
      if length(expr.args) < 2 { > "__mutator expects 2 arguments" }
      $ err1 = compile_expression(c, expr.args[0])
      if err1 != "" { > err1 }
      $ err2 = compile_expression(c, expr.args[1])
      if err2 != "" { > err2 }
      emit_byte(c, OP_MUTATOR)
      > ""
    }

    # Push function name onto stack first
    $ idx = add_constant(c, expr.func_name)
    emit_byte(c, OP_PUSH)
    emit_bytes4(c, idx)
    # Then push arguments
    $ i = 0
    while i < length(expr.args) {
      $ er = compile_expression(c, expr.args[i])
      if er != "" { > er }
      i = i + 1
    }
    # OP_CALL operand = arg count (func name already on stack)
    emit_byte(c, OP_CALL)
    emit_bytes4(c, length(expr.args))
    > ""
  }

  if expr.kind == "field" {
    # Push object, then push field name, then GET_FIELD (no operand)
    $ err = compile_expression(c, expr.object)
    if err != "" { > err }
    $ idx = add_constant(c, expr.field_name)
    emit_byte(c, OP_PUSH)
    emit_bytes4(c, idx)
    emit_byte(c, OP_GET_FIELD)
    > ""
  }

  if expr.kind == "object" {
    $ i = 0
    while i < length(expr.fields) {
      $ f = expr.fields[i]
      # Push key first, then value (VM pops value first, then key)
      $ kidx = add_constant(c, f.key)
      emit_byte(c, OP_PUSH)
      emit_bytes4(c, kidx)
      $ err = compile_expression(c, f.value)
      if err != "" { > err }
      i = i + 1
    }
    emit_byte(c, OP_BUILD_OBJECT)
    emit_bytes4(c, length(expr.fields))
    > ""
  }

  if expr.kind == "array" {
    $ i = 0
    while i < length(expr.elements) {
      $ err = compile_expression(c, expr.elements[i])
      if err != "" { > err }
      i = i + 1
    }
    emit_byte(c, OP_BUILD_ARRAY)
    emit_bytes4(c, length(expr.elements))
    > ""
  }

  if expr.kind == "index" {
    # arr[idx] → push arr, push idx, GET_INDEX
    $ err1 = compile_expression(c, expr.array_expr)
    if err1 != "" { > err1 }
    $ err2 = compile_expression(c, expr.index_expr)
    if err2 != "" { > err2 }
    emit_byte(c, OP_GET_INDEX)
    > ""
  }

  > "Unsupported expression kind: " + expr.kind
}

! cast_literal(val: str, t: str) -> any {
  if t == "int" {
    > {kind: "int", value: toInt(val)}
  }
  if t == "bool" { > {kind: "bool", value: (val == "true")} }
  if t == "str" { > {kind: "str", value: val} }
  if t == "null" { > null }
  > {kind: "unknown", value: val}
}
