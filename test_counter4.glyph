import "./bootstrap/parser"

@ command run {
  # Test: mutable closure that modifies a parent var
  # The outer function sets $ result = 0, inner modifies it
  $ src = "! test_mut() -> int {\n  $ result = 0\n  ! modify() -> int {\n    $ result = result + 42\n  }\n  modify()\n  > result\n}\n$ result = test_mut()"
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  
  # Walk AST
  $ i = 0
  while i < length(pr.mod.items) {
    $ item = pr.mod.items[i]
    print("item " + toString(i) + ": kind=" + item.kind)
    if item.kind == "function" {
      print("  func: " + item.func_name + " body=" + toString(length(item.func_body)))
      $ j = 0
      while j < length(item.func_body) {
        $ s = item.func_body[j]
        print("    " + toString(j) + ": kind=" + s.kind)
        if s.kind == "function" {
          print("      inner func: " + s.func_name + " body=" + toString(length(s.func_body)))
          $ k = 0
          while k < length(s.func_body) {
            $ ss = s.func_body[k]
            print("        " + toString(k) + ": kind=" + ss.kind)
            if ss.kind == "assign" {
              print("          target=" + ss.target)
            }
            $ k = k + 1
          }
        }
        if s.kind == "expression" {
          print("      expr kind=" + s.expr.kind)
          if s.expr.kind == "call" {
            print("      func_name=" + s.expr.func_name)
          }
        }
        $ j = j + 1
      }
    }
    $ i = i + 1
  }
  > { ok: true }
}
