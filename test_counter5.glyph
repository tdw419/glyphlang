import "./bootstrap/parser"

@ command run {
  $ src = "! test_mut() -> int {\n  $ result = 0\n  ! modify() -> int {\n    $ result = result + 42\n  }\n  modify()\n  > result\n}\n$ result = test_mut()"
  print("=== SRC ===")
  print(src)
  print("=== END ===")
  $ p = parser.new_parser(src)
  $ pr = parser.parse(p)
  if pr.error != "" {
    print("PARSE ERROR: " + pr.error)
    > { error: pr.error }
  }
  
  # Walk AST
  $ i = 0
  while i < length(pr.mod.items) {
    $ item = pr.mod.items[i]
    print("item " + toString(i) + ": kind=" + item.kind)
    if item.kind == "function" {
      print("  func: " + item.func_name + " body=" + toString(length(item.func_body)))
      $ j = 0
      while j < length(item.func_body) {
        $ s = item.func_body[j]
        print("    " + toString(j) + ": kind=" + s.kind)
        $ j = j + 1
      }
    }
    $ i = i + 1
  }
  > { ok: true }
}
